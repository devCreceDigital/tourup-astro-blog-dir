{
  "name": "tourup-content",
  "description": "Astro-based content site and AI-optimized directory for tourup.co",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/generate-llms-txt.mjs && node scripts/generate-ai-index.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "graphify": "python3 -m graphify extract src/content --backend gemini --max-concurrency 4",
    "graph:bootstrap": "python3 scripts/generate_graph.py",
    "seed": "npx tsx scripts/seed-admin.ts",
    "deploy": "npm run build && node ./dist/server/entry.mjs",
    "enrich:categorias": "python3 scripts/enrich_categoria_content.py"
  },
  "dependencies": {
    "@astrojs/node": "^9.0.0",
    "@astrojs/react": "5.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@keystatic/astro": "^6.0.0",
    "@keystatic/core": "^0.6.8",
    "aeo.js": "^0.0.16",
    "alpinejs": "^3.13.0",
    "astro": "^5.2.5",
    "cloudinary": "^2.10.0",
    "gray-matter": "^4.0.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sql.js": "^1.10.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "tsx": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
