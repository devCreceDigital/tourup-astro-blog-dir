# ─── LLM Provider (elige uno) ────────────────────────────────
# OpenRouter (recomendado: acceso a 300+ modelos)
OPENROUTER_API_KEY=sk-or-v1-...

# O alternativamente:
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# ─── TourUp CMS API (cuando esté implementada) ──────────────
TOURUP_ADMIN_SESSION_TOKEN=
TOURUP_CMS_URL=http://tourup-astro-blog:8080

# ─── Mensajería (opcional) ──────────────────────────────────
# TELEGRAM_BOT_TOKEN=...
# DISCORD_BOT_TOKEN=...
