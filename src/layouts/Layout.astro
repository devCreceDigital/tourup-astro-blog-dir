---
/**
 * Estructura común de todas las páginas públicas: SEO (canonical, hreflang, Open Graph,
 * JSON-LD) + cabecera y pie del sistema "cartel chicha". Sitio estático: sin ajustes en base
 * de datos ni scripts de terceros.
 */
// Fuentes autoalojadas: sin peticiones a Google Fonts (privacidad de visitantes de la UE).
import '@fontsource/big-shoulders-display/700';
import '@fontsource/big-shoulders-display/800';
import '@fontsource/big-shoulders-display/900';
import '@fontsource-variable/source-serif-4/opsz';
import '@fontsource-variable/source-serif-4/opsz-italic';
import '../styles/global.css';
import Masthead from '../components/site/Masthead.astro';
import SiteFooter from '../components/site/SiteFooter.astro';
import SiteJsonLd from '../components/SiteJsonLd.astro';
import { hreflangAlternates, SITE_URL } from '../utils/seo';
import type { Locale } from '../utils/i18n';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  canonicalUrl?: string;
  hreflangOverrides?: { es?: string; en?: string; 'x-default'?: string };
  image?: string;
  noindex?: boolean;
  /** false = sin hreflang (p. ej. prompts cuya versión /es/ aún no está traducida). */
  hreflang?: boolean;
  breadcrumb?: string;
  lang?: string;
  date?: string;
  /** true = el contenido ocupa todo el ancho (portadas); false = columna centrada. */
  bleed?: boolean;
}

const {
  title = 'TourUp Guide — Peru travel guide and operator directory',
  description: descriptionProp,
  currentPath = '/',
  canonicalUrl: canonicalUrlProp,
  hreflangOverrides,
  image = '/og-default.jpg',
  noindex = false,
  hreflang = true,
  breadcrumb,
  date = '',
  bleed = false,
} = Astro.props;

const lang: Locale = (Astro.props.lang ?? (currentPath.startsWith('/es/') ? 'es' : 'en')) === 'es' ? 'es' : 'en';

// Una descripción vacía ('') no debe llegar al <meta>: cae al valor por defecto.
const description =
  (typeof descriptionProp === 'string' && descriptionProp.trim()) ||
  (lang === 'es'
    ? 'Guía de viaje de Perú: destinos, itinerarios y respuestas, más un directorio de empresas de turismo registradas.'
    : 'Peru travel guide: destinations, itineraries and answers, plus a directory of registered Peruvian travel companies.');

const siteUrl = SITE_URL;
const canonicalUrl = canonicalUrlProp || `${siteUrl}${currentPath}`;
const ogLocale = lang === 'en' ? 'en_US' : 'es_PE';
const ogType = currentPath.startsWith('/blog/') ? 'article' : 'website';
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

// hreflang solo hacia páginas que existen (ver utils/seo.ts); null = sin versión por idioma (blog).
const alternates = hreflangAlternates(currentPath, siteUrl);
const altHref = (l: Locale) => (l === 'es' ? hreflangOverrides?.es ?? alternates?.es : hreflangOverrides?.en ?? alternates?.en);
const otherLang: Locale = lang === 'en' ? 'es' : 'en';
const altUrl = hreflang && !noindex ? altHref(otherLang)?.replace(siteUrl, '') ?? null : null;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#00c9b1" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {import.meta.env.GOOGLE_VERIFICATION_CODE && <meta name="google-site-verification" content={import.meta.env.GOOGLE_VERIFICATION_CODE} />}
    {import.meta.env.BING_VERIFICATION_CODE && <meta name="msvalidate.01" content={import.meta.env.BING_VERIFICATION_CODE} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="TourUp Guide" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {hreflang && (hreflangOverrides || alternates) && (
      <>
        <link rel="alternate" hreflang="es" href={altHref('es')} />
        <link rel="alternate" hreflang="en" href={altHref('en')} />
        <link rel="alternate" hreflang="x-default" href={hreflangOverrides?.['x-default'] ?? alternates?.xDefault} />
      </>
    )}

    <link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap-index.xml`} />

    <SiteJsonLd
      title={title}
      description={description}
      canonicalUrl={canonicalUrl}
      currentPath={currentPath}
      lang={lang}
      breadcrumb={breadcrumb}
      dateModified={date || undefined}
    />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Masthead lang={lang} currentPath={currentPath} altUrl={altUrl} />
    <main id="main" class={bleed ? 'main-bleed' : 'main-column wrap'}>
      <slot />
    </main>
    <SiteFooter lang={lang} />
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: 0.5rem;
    top: -3rem;
    z-index: 10;
    background: var(--yellow);
    color: var(--ink);
    font-family: var(--font-poster);
    font-weight: 800;
    text-transform: uppercase;
    padding: 0.5rem 1rem;
  }

  .skip-link:focus {
    top: 0.5rem;
  }

  main {
    flex: 1;
    width: 100%;
  }

  .main-column {
    padding-top: var(--space-4);
    padding-bottom: var(--space-5);
  }
</style>
