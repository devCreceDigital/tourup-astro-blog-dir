---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title = 'TourUp Content Hub',
  description = 'Directorio de operadores turísticos en Perú — encuentra agencias, tours y destinos verificados',
  currentPath = '/',
  image = '/og-default.jpg',
  noindex = false,
} = Astro.props;

const siteUrl = 'https://tourup.co';
const canonicalUrl = `${siteUrl}${currentPath}`;

const lang = currentPath.startsWith('/en/') ? 'en' : 'es';
const ogLocale = lang === 'en' ? 'en_US' : 'es_PE';

const ogType = currentPath.startsWith('/blog/') ? 'article' : 'website';

function breadcrumbItems(path: string) {
  const parts = path.replace(/\/$/, '').split('/').filter(Boolean);
  const items = [{ name: 'Inicio', path: '/' }];
  let acc = '';
  for (const part of parts) {
    acc += '/' + part;
    const label = part.replace(/-/g, ' ').replace(/\b\w/g, (c) => c.toUpperCase());
    items.push({ name: label, path: acc + '/' });
  }
  return items;
}
const crumbs = breadcrumbItems(currentPath);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="google-site-verification" content="GOOGLE_VERIFICATION_CODE" />
    <meta name="msvalidate.01" content="BING_VERIFICATION_CODE" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />
    <title>{title}</title>

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={`${siteUrl}${image}`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:site_name" content="TourUp Peru" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}${image}`} />

    <!-- hreflang -->
    <link rel="alternate" hrefLang="es" href={`${siteUrl}/`} />
    <link rel="alternate" hrefLang="en" href={`${siteUrl}/en/`} />
    <link rel="alternate" hrefLang="x-default" href={`${siteUrl}/`} />

    <!-- Schema.org: @graph unificado -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "Organization",
          "@id": "https://tourup.co/#organization",
          "name": "TourUp Peru",
          "url": "https://tourup.co",
          "description": "Directorio de operadores turísticos verificados en Perú",
          "foundingDate": "2024",
          "areaServed": { "@type": "Country", "name": "PE" }
        },
        {
          "@type": "WebSite",
          "@id": "https://tourup.co/#website",
          "url": "https://tourup.co",
          "name": "TourUp Peru",
          "description": "Directorio de operadores turísticos en Perú",
          "publisher": { "@id": "https://tourup.co/#organization" },
          "inLanguage": lang,
          "potentialAction": {
            "@type": "SearchAction",
            "target": {
              "@type": "EntryPoint",
              "urlTemplate": "https://tourup.co/?q={search_term_string}"
            },
            "query-input": "required name=search_term_string"
          }
        },
        {
          "@type": "WebPage",
          "@id": canonicalUrl + "#webpage",
          "url": canonicalUrl,
          "name": title,
          "description": description,
          "isPartOf": { "@id": "https://tourup.co/#website" },
          "about": { "@id": "https://tourup.co/#organization" }
        },
        {
          "@type": "BreadcrumbList",
          "@id": canonicalUrl + "#breadcrumb",
          "itemListElement": crumbs.map((crumb, i) => ({
            "@type": "ListItem",
            "position": i + 1,
            "name": crumb.name,
            "item": siteUrl + crumb.path
          }))
        }
      ]
    })} />
  </head>
  <body>
    <Header currentPath={currentPath} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  :root {
    --color-primary: #3b82f6;
    --color-secondary: #06b6d4;
    --color-dark: #0f172a;
    --color-dark-light: #1e293b;
    --color-text: #f1f5f9;
    --color-text-muted: #cbd5e1;
    --color-border: rgba(71, 85, 105, 0.2);
    --gradient-main: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
  }

  html {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue',
      Arial, 'Noto Sans', sans-serif;
    background: var(--color-dark);
    color: var(--color-text);
    line-height: 1.6;
  }

  body {
    background: var(--color-dark);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
  }

  main {
    flex: 1;
    max-width: 1200px;
    width: 100%;
    margin: 0 auto;
    padding: 0 2rem;
  }

  h1,
  h2,
  h3,
  h4,
  h5,
  h6 {
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1rem;
  }

  h1 {
    font-size: 2.5rem;
  }

  h2 {
    font-size: 2rem;
  }

  h3 {
    font-size: 1.5rem;
  }

  h4 {
    font-size: 1.25rem;
  }

  p {
    margin-bottom: 1rem;
    color: var(--color-text-muted);
  }

  a {
    color: var(--color-secondary);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  a:hover {
    color: var(--color-primary);
  }

  button,
  .btn {
    padding: 0.75rem 1.5rem;
    background: var(--gradient-main);
    color: white;
    border: none;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  button:hover,
  .btn:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 16px rgba(6, 182, 212, 0.3);
  }

  code {
    background: var(--color-dark-light);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-family: 'Courier New', monospace;
    font-size: 0.9rem;
  }

  pre {
    background: var(--color-dark-light);
    padding: 1rem;
    border-radius: 0.5rem;
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  pre code {
    background: none;
    padding: 0;
    border-radius: 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
  }

  th,
  td {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  th {
    background: var(--color-dark-light);
    font-weight: 600;
  }

  tr:hover {
    background: var(--color-dark-light);
  }

  img {
    max-width: 100%;
    height: auto;
    border-radius: 0.5rem;
  }

  @media (max-width: 768px) {
    main {
      padding: 0 1rem;
    }

    h1 {
      font-size: 1.75rem;
    }

    h2 {
      font-size: 1.5rem;
    }

    h3 {
      font-size: 1.25rem;
    }
  }
</style>
