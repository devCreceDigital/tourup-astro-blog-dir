---
import { getCollection } from 'astro:content';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const destinos = await getCollection('destinos');
const sortedDestinos = destinos.sort((a, b) => a.data.name.localeCompare(b.data.name));

interface NavChild {
  label: string;
  href: string;
}

interface NavItem {
  label: string;
  href: string;
  children: NavChild[];
}

const navItems: NavItem[] = [
  { label: 'Home', href: '/', children: [] },
  {
    label: 'Empresas',
    href: '/es/empresas/',
    children: sortedDestinos.slice(0, 8).map(d => ({
      label: d.data.name,
      href: `/en/peru/${d.id.replace('.md', '')}/`
    }))
  },
  {
    label: 'Destinos',
    href: '/en/peru/cusco/',
    children: sortedDestinos.map(d => ({
      label: d.data.name,
      href: `/en/peru/${d.id.replace('.md', '')}/`
    }))
  },
  { label: 'AI Prompts', href: '/en/ai-prompts/', children: [] },
  {
    label: 'Partner Scout',
    href: '/partner-scout/',
    children: [
      { label: 'Scout', href: '/partner-scout/' },
      { label: 'Shortlist', href: '/partner-scout/shortlist/' },
      { label: 'Confirm', href: '/partner-scout/confirm/' },
      { label: 'Brief', href: '/partner-scout/brief/' },
    ]
  },
  { label: 'Blog', href: '/blog/', children: [] },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
}
---

<header class="header">
  <div class="header-container">
    <a href="/" class="logo">
      <span class="logo-icon">🗺️</span>
      <span class="logo-text">TourUp</span>
    </a>

    <input type="checkbox" id="nav-toggle" class="nav-toggle" />
    <label for="nav-toggle" class="nav-toggle-label">
      <span></span>
      <span></span>
      <span></span>
    </label>

    <nav class="nav">
      {navItems.map((item) => (
        <div class="dropdown">
          {item.children.length > 0 ? (
            <>
              <a
                href={item.href}
                class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
              >
                {item.label}
                <svg class="chevron" viewBox="0 0 20 20" fill="currentColor" width="16" height="16">
                  <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
                </svg>
              </a>
              <div class="dropdown-menu">
                {item.children.map((child) => (
                  <a
                    href={child.href}
                    class={`dropdown-link ${currentPath === child.href ? 'active' : ''}`}
                  >
                    {child.label}
                  </a>
                ))}
              </div>
            </>
          ) : (
            <a
              href={item.href}
              class={`nav-link ${isActive(item.href) ? 'active' : ''}`}
            >
              {item.label}
            </a>
          )}
        </div>
      ))}
    </nav>

    <div class="header-actions">
      <a href="https://tourup.co" class="btn-ingresar">
        INGRESAR
      </a>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(255, 255, 255, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid #e4e2e4;
  }

  .header-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    font-weight: 700;
    font-size: 1.25rem;
    color: #1b1b1d;
    transition: opacity 0.2s ease;
    flex-shrink: 0;
  }

  .logo:hover {
    opacity: 0.7;
  }

  .logo-icon {
    font-size: 1.5rem;
  }

  .logo-text {
    background: linear-gradient(135deg, #006591 0%, #00b4ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .nav-toggle {
    display: none;
  }

  .nav-toggle-label {
    display: none;
    cursor: pointer;
    flex-direction: column;
    gap: 5px;
    padding: 4px;
  }

  .nav-toggle-label span {
    display: block;
    width: 24px;
    height: 2px;
    background: #3e4851;
    border-radius: 2px;
    transition: all 0.3s ease;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    flex: 1;
    justify-content: center;
  }

  .dropdown {
    position: relative;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #3e4851;
    text-decoration: none;
    transition: all 0.1s ease;
    border-radius: 0.375rem;
    white-space: nowrap;
  }

  .nav-link:hover {
    color: #1b1b1d;
    background: #f0edef;
  }

  .nav-link.active {
    color: #006591;
  }

  .chevron {
    transition: transform 0.2s ease;
  }

  .dropdown:hover .chevron {
    transform: rotate(180deg);
  }

  .dropdown-menu {
    position: absolute;
    top: 100%;
    left: 0;
    min-width: 200px;
    background: rgba(255, 255, 255, 0.98);
    border: 1px solid #e4e2e4;
    border-radius: 0.5rem;
    padding: 0.5rem;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: all 0.2s ease;
    z-index: 200;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);
    backdrop-filter: blur(10px);
  }

  .dropdown:hover .dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .dropdown-link {
    display: block;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
    color: #3e4851;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: all 0.1s ease;
  }

  .dropdown-link:hover {
    background: #f0edef;
    color: #1b1b1d;
  }

  .dropdown-link.active {
    color: #006591;
    background: #f0edef;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-shrink: 0;
  }

  .btn-ingresar {
    padding: 0.5rem 1.5rem;
    background: #006591;
    color: #ffffff;
    text-decoration: none;
    border-radius: 0.5rem;
    font-weight: 600;
    font-size: 0.875rem;
    transition: background 0.1s ease;
    white-space: nowrap;
  }

  .btn-ingresar:hover {
    background: #004c6e;
  }

  @media (max-width: 1024px) {
    .header-container {
      flex-wrap: wrap;
      padding: 0.75rem 1rem;
    }

    .nav-toggle-label {
      display: flex;
      order: 1;
    }

    .nav {
      display: none;
      order: 3;
      width: 100%;
      flex-direction: column;
      gap: 0;
      padding: 0.5rem 0;
      border-top: 1px solid #e4e2e4;
      margin-top: 0.75rem;
    }

    .nav-toggle:checked ~ .nav {
      display: flex;
    }

    .dropdown {
      width: 100%;
    }

    .nav-link {
      width: 100%;
      justify-content: space-between;
      padding: 0.75rem 0.5rem;
    }

    .nav-link:hover {
      background: transparent;
    }

    .dropdown-menu {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      background: transparent;
      border: none;
      box-shadow: none;
      backdrop-filter: none;
      padding: 0 0 0 1rem;
      display: none;
    }

    .dropdown:hover .dropdown-menu {
      display: block;
    }

    .dropdown-link {
      padding: 0.5rem 0.75rem;
      font-size: 0.85rem;
    }

    .header-actions {
      order: 2;
    }
  }

  @media (max-width: 480px) {
    .header-container {
      padding: 0.75rem;
      gap: 0.75rem;
    }

    .btn-ingresar {
      padding: 0.4rem 1rem;
      font-size: 0.8rem;
    }
  }
</style>
