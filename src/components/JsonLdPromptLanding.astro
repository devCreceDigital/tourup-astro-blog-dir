---
interface BrandMention {
  name: string;
  entity_type: 'company' | 'external_brand' | 'unknown';
  entity_slug?: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  searchTerm: string;
  brands: BrandMention[];
  faqItems?: FAQItem[];
  url?: string;
}

const { title, description, searchTerm, brands, faqItems = [], url } = Astro.props;

// Build WebPage schema
const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: title,
  description: description,
  url: url || Astro.url.href,
};

// Build ItemList schema for brands
const brandItems = brands.map((brand, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: brand.name,
  url: brand.entity_slug ? `/companies/${brand.entity_slug}/` : undefined,
})).filter((item) => item.url);

const itemListSchema = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  itemListElement: brandItems,
};

// Build FAQPage schema
const faqPageSchema = faqItems.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
} : null;

// TODO: Combine these into a single, richer schema
// that includes breadcrumbs, offers, ratings, etc.
---

{webPageSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
)}

{brandItems.length > 0 && (
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />
)}

{faqPageSchema && (
  <script type="application/ld+json" set:html={JSON.stringify(faqPageSchema)} />
)}
