---
interface BrandMention {
  name: string;
  entity_type: 'company' | 'external_brand' | 'unknown';
  entity_slug?: string;
}

interface FAQItem {
  question: string;
  answer: string;
}

interface Props {
  title: string;
  description: string;
  searchTerm: string;
  brands: BrandMention[];
  faqItems?: FAQItem[];
  url?: string;
}

const { title, description, searchTerm, brands, faqItems = [], url } = Astro.props;

const siteUrl = 'https://tourup.co';
const pageUrl = url || Astro.url.href;

const brandItems = brands.map((brand, index) => ({
  '@type': 'ListItem',
  position: index + 1,
  name: brand.name,
  url: brand.entity_slug ? `${siteUrl}/companies/${brand.entity_slug}/` : undefined,
})).filter((item) => item.url);

const graph: Record<string, unknown>[] = [
  {
    '@type': 'WebPage',
    '@id': pageUrl + '#webpage',
    url: pageUrl,
    name: title,
    description: description,
    isPartOf: { '@id': `${siteUrl}/#website` },
  },
];

if (brandItems.length > 0) {
  graph.push({
    '@type': 'ItemList',
    itemListElement: brandItems,
  });
}

if (faqItems.length > 0) {
  graph.push({
    '@type': 'FAQPage',
    mainEntity: faqItems.map((item) => ({
      '@type': 'Question',
      name: item.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.answer,
      },
    })),
  });
}

const unifiedSchema = {
  '@context': 'https://schema.org',
  '@graph': graph,
};
---

<script type="application/ld+json" set:html={JSON.stringify(unifiedSchema)} />
