---
/**
 * Créditos de fotos (EN en /photo-credits/, ES en /es/creditos-de-fotos/). Créditos de todas las fotos del sitio (Wikimedia Commons, licencias Creative Commons).
 * La portada y las cabeceras muestran el crédito junto a la foto; el resto de miniaturas
 * (mosaicos, tarjetas, listas) se acreditan aquí, enlazado desde el pie de cada página.
 */
import GuidePage from './GuidePage.astro';
import photos from '../../data/photos.json';
import { SITE_URL } from '../../utils/seo';
import type { Locale } from '../../utils/i18n';

interface Props { lang: Locale; }
const { lang } = Astro.props;
const es = lang === 'es';
const t = (esText: string, enText: string) => (es ? esText : enText);

const rows = Object.entries(photos as Record<string, any>)
  .map(([key, p]) => ({ key, ...p }))
  .sort((a, b) => a.alt.localeCompare(b.alt));
---

<GuidePage
  title={t('Créditos de fotos | TourUp', 'Photo credits | TourUp Guide')}
  heading={t('Créditos de fotos', 'Photo credits')}
  dek={t('Quién hizo cada foto del sitio y con qué licencia. La mayoría viene de Wikimedia Commons con licencias Creative Commons; alguna la aporta TourUp.', 'Who took each photo on this site and under which licence. Most come from Wikimedia Commons under Creative Commons licences; a few are supplied by TourUp.')}
  description={t('Autores y licencias de las fotos de la guía TourUp (Wikimedia Commons, Creative Commons).', 'Authors and licences of the photos used on TourUp Guide (Wikimedia Commons, Creative Commons).')}
  currentPath={es ? '/es/creditos-de-fotos/' : '/photo-credits/'}
  lang={lang}
  breadcrumb={t('Créditos de fotos', 'Photo credits')}
  alternates={{ es: `${SITE_URL}/es/creditos-de-fotos/`, en: `${SITE_URL}/photo-credits/` }}
  wide
>
  <table>
    <thead>
      <tr>
        <th>{t('Foto', 'Photo')}</th>
        <th>{t('Autor', 'Author')}</th>
        <th>{t('Licencia', 'Licence')}</th>
        <th>{t('Fuente', 'Source')}</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((p) => (
        <tr>
          <td><img src={`${p.file}-960.webp`} alt="" width="120" height={Math.round((120 * p.height) / p.width)} loading="lazy" class="pc-thumb" /> {p.alt}</td>
          <td>{p.credit}</td>
          <td>{p.license}</td>
          <td>{p.source ? <a href={p.source} rel="noopener">Wikimedia Commons</a> : 'TourUp'}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p>{t('Las fotos se redimensionan y se convierten a WebP; no se modifican de ninguna otra forma.', 'Photos are resized and converted to WebP; no other changes were made.')}</p>
</GuidePage>

<style>
  .pc-thumb {
    display: inline-block;
    vertical-align: middle;
    margin-right: 0.6rem;
    width: 120px;
    height: auto;
  }
</style>
