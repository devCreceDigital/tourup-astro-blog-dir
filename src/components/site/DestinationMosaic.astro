---
/**
 * Mosaico de destinos: fotos verticales unidas, cada una cruzada por una banda de tinta con el
 * nombre. Interacción firma: al pasar el ratón o enfocar, la banda sube e inunda la foto
 * (clip-path) y descubre el resumen del destino. Sin JavaScript.
 */
import { getCollection } from 'astro:content';
import Photo from './Photo.astro';
import type { Locale } from '../../utils/i18n';
import { getLocalizedString } from '../../utils/i18n';
import { INKS, destinationPath } from '../../data/site';

interface Props {
  lang: Locale;
  slugs: string[];
}

const { lang, slugs } = Astro.props;
const destinos = await getCollection(lang === 'es' ? 'destinos' : 'destinos_en');
const bySlug = new Map(destinos.map((d) => [d.id.replace(/\.md$/i, ''), d]));
const tiles = slugs
  .map((slug) => ({ slug, d: bySlug.get(slug) }))
  .filter((x) => x.d)
  .map(({ slug, d }, i) => {
    const summary = getLocalizedString(d!.data.summary, lang);
    return {
      slug,
      name: getLocalizedString(d!.data.name, lang),
      teaser: summary.split(/(?<=\.)\s/)[0],
      ink: INKS[i % INKS.length],
    };
  });
---

<ul class="mosaic" style={`--cols: ${tiles.length}`}>
  {tiles.map((tile) => (
    <li class={`tile tile--${tile.ink}`}>
      <a href={destinationPath(lang, tile.slug)} class="tile-link">
        <Photo name={tile.slug === 'puno' ? 'puno' : tile.slug} sizes="(max-width: 760px) 50vw, 20vw" alt="" class="tile-img" />
        <span class="tile-band" aria-hidden="true"></span>
        <span class="tile-name">{tile.name}</span>
        <span class="tile-teaser">{tile.teaser}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .mosaic {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    max-width: 1440px;
    margin-inline: auto;
  }

  .tile-link {
    position: relative;
    display: grid;
    align-content: center;
    aspect-ratio: 5 / 8;
    overflow: hidden;
    text-decoration: none;
    color: var(--ink);
    isolation: isolate;
  }

  .tile-link :global(.tile-img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    transition: scale 700ms var(--ease-out), filter 700ms var(--ease-out);
  }

  /* La banda: una franja a media altura que, al activarse, crece hasta cubrir la foto. */
  .tile-band {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--tile-ink);
    opacity: 0.9;
    clip-path: inset(38% 0 38% 0);
    transition: clip-path 520ms var(--ease-out), opacity 520ms var(--ease-out);
  }

  .tile--magenta { --tile-ink: var(--magenta); }
  .tile--orange { --tile-ink: var(--orange); }
  .tile--yellow { --tile-ink: var(--yellow); }
  .tile--green { --tile-ink: var(--green); }

  .tile-name {
    text-align: center;
    font-family: var(--font-poster);
    font-weight: 900;
    text-transform: uppercase;
    font-size: clamp(1.6rem, 2.6vw, 2.5rem);
    line-height: 1;
    padding-inline: 0.4rem;
    transition: translate 520ms var(--ease-out);
  }

  .tile-teaser {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 1.25rem;
    font-size: 0.95rem;
    line-height: 1.45;
    color: var(--ink);
    opacity: 0;
    translate: 0 0.75rem;
    transition: opacity 420ms var(--ease-out) 80ms, translate 420ms var(--ease-out) 80ms;
  }

  .tile-link:hover .tile-band,
  .tile-link:focus-visible .tile-band {
    clip-path: inset(0 0 0 0);
    opacity: 0.94;
  }

  .tile-link:hover :global(.tile-img),
  .tile-link:focus-visible :global(.tile-img) {
    scale: 1.06;
  }

  .tile-link:hover .tile-name,
  .tile-link:focus-visible .tile-name {
    translate: 0 -2.5rem;
  }

  .tile-link:hover .tile-teaser,
  .tile-link:focus-visible .tile-teaser {
    opacity: 1;
    translate: 0 0;
  }

  .tile-link:focus-visible {
    outline-offset: -6px;
    outline-color: var(--ink);
  }

  @media (max-width: 760px) {
    .mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .tile:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .tile:last-child:nth-child(odd) .tile-link {
      aspect-ratio: 16 / 9;
    }

    .tile-link {
      aspect-ratio: 4 / 5;
    }

    .tile-teaser {
      display: none;
    }

    .tile-link:hover .tile-name,
    .tile-link:focus-visible .tile-name {
      translate: 0 0;
    }
  }
</style>
