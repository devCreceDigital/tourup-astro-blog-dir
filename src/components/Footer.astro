---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-section brand">
        <h3>TourUp</h3>
        <p>AI-optimized directory for Peru's tourism ecosystem. Directorio inteligente de prestadores turísticos optimizado para motores de búsqueda con IA.</p>
      </div>

      <div class="footer-section">
        <h4>Explorar</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/es/empresas/">Empresas</a></li>
          <li><a href="/en/ai-prompts/">AI Prompts</a></li>
          <li><a href="/partner-scout/">Partner Scout</a></li>
          <li><a href="/blog/">Blog</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Destinos</h4>
        <ul>
          <li><a href="/en/peru/cusco/">Cusco</a></li>
          <li><a href="/en/peru/lima/">Lima</a></li>
          <li><a href="/en/peru/arequipa/">Arequipa</a></li>
          <li><a href="/en/peru/huaraz/">Huaraz</a></li>
          <li><a href="/en/peru/iquitos/">Iquitos</a></li>
          <li><a href="/en/peru/machu_picchu/">Machu Picchu</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Partner Scout</h4>
        <ul>
          <li><a href="/partner-scout/">Scout</a></li>
          <li><a href="/partner-scout/shortlist/">Shortlist</a></li>
          <li><a href="/partner-scout/confirm/">Confirm</a></li>
          <li><a href="/partner-scout/brief/">Brief</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Recursos</h4>
        <ul>
          <li><a href="https://tourup.co">App Principal</a></li>
          <li><a href="https://github.com/devCreceDigital/tourup-astro-blog">GitHub</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} TourUp. All rights reserved.</p>
      <p>Built with <a href="https://astro.build">Astro</a> &middot; Optimizado para AEO</p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: #ffffff;
    border-top: 1px solid #e4e2e4;
    color: #3e4851;
    font-size: 0.95rem;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem 2rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr 1fr 1fr;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-section h3 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
    background: linear-gradient(135deg, #006591 0%, #00b4ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-section h4 {
    font-size: 0.95rem;
    margin: 0 0 1rem 0;
    color: #1b1b1d;
  }

  .footer-section p {
    margin: 0;
    line-height: 1.6;
    color: #3e4851;
    font-size: 0.9rem;
  }

  .footer-section ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-section li {
    margin: 0.5rem 0;
  }

  .footer-section li a {
    color: #3e4851;
    text-decoration: none;
    transition: color 0.1s ease;
    font-size: 0.9rem;
  }

  .footer-section li a:hover {
    color: #1b1b1d;
  }

  .footer-bottom {
    border-top: 1px solid #e4e2e4;
    padding-top: 1.5rem;
    text-align: center;
    color: #6e7882;
    font-size: 0.85rem;
  }

  .footer-bottom p {
    margin: 0.5rem 0;
  }

  .footer-bottom a {
    color: #006591;
    text-decoration: none;
    transition: color 0.1s ease;
  }

  .footer-bottom a:hover {
    color: #004c6e;
  }

  @media (max-width: 1024px) {
    .footer-content {
      grid-template-columns: 1fr 1fr;
    }

    .footer-section.brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 768px) {
    .footer-container {
      padding: 2rem 1rem 1rem;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .footer-section.brand {
      grid-column: 1;
    }
  }
</style>
