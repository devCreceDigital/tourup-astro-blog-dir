---
const currentYear = new Date().getFullYear();
---

<footer class="footer">
  <div class="footer-container">
    <div class="footer-content">
      <div class="footer-section">
        <h3>TourUp</h3>
        <p>AI-optimized directory for Peru's tourism ecosystem.</p>
      </div>

      <div class="footer-section">
        <h4>Content</h4>
        <ul>
          <li><a href="/">Home</a></li>
          <li><a href="/blog/">Blog</a></li>
          <li><a href="/en/ai-prompts/">Directory</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Resources</h4>
        <ul>
          <li><a href="https://tourup.co">Main App</a></li>
          <li><a href="https://github.com/devCreceDigital/tourup-astro-blog">GitHub</a></li>
        </ul>
      </div>

      <div class="footer-section">
        <h4>Legal</h4>
        <ul>
          <li><a href="/privacy">Privacy Policy</a></li>
          <li><a href="/terms">Terms of Service</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <p>&copy; {currentYear} TourUp. All rights reserved.</p>
      <p>Built with <a href="https://astro.build">Astro</a></p>
    </div>
  </div>
</footer>

<style>
  .footer {
    background: rgba(15, 23, 42, 0.95);
    border-top: 1px solid rgba(71, 85, 105, 0.2);
    color: #cbd5e1;
    font-size: 0.95rem;
    margin-top: 4rem;
  }

  .footer-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 3rem 2rem 2rem;
  }

  .footer-content {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .footer-section h3 {
    font-size: 1.25rem;
    margin: 0 0 0.5rem 0;
    background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .footer-section h4 {
    font-size: 0.95rem;
    margin: 0 0 1rem 0;
    color: #f1f5f9;
  }

  .footer-section p {
    margin: 0;
    line-height: 1.6;
    color: #94a3b8;
  }

  .footer-section ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .footer-section li {
    margin: 0.5rem 0;
  }

  .footer-section a {
    color: #cbd5e1;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-section a:hover {
    color: #06b6d4;
  }

  .footer-bottom {
    border-top: 1px solid rgba(71, 85, 105, 0.2);
    padding-top: 1.5rem;
    text-align: center;
    color: #64748b;
    font-size: 0.85rem;
  }

  .footer-bottom p {
    margin: 0.5rem 0;
  }

  .footer-bottom a {
    color: #06b6d4;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .footer-bottom a:hover {
    color: #3b82f6;
  }

  @media (max-width: 768px) {
    .footer-container {
      padding: 2rem 1rem 1rem;
    }

    .footer-content {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }
</style>
