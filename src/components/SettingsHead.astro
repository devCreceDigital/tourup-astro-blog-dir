---
import { getSettings } from '../lib/settings';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  image?: string;
  noindex?: boolean;
}

let settingsSeo: Record<string, string>, settingsAdvanced: Record<string, string>, settingsIntegrations: Record<string, string>;
try {
  const s = await getSettings();
  settingsSeo = s.seo as any;
  settingsAdvanced = s.advanced as any;
  settingsIntegrations = s.integrations as any;
} catch {
  settingsSeo = {};
  settingsAdvanced = {};
  settingsIntegrations = {};
}

const {
  title = settingsSeo?.siteTitle || 'TourUp Content Hub',
  description = settingsSeo?.description || 'Directorio de operadores turísticos en Perú — encuentra agencias, tours y destinos verificados',
  currentPath = '/',
  image = settingsSeo?.ogImage || '/og-default.jpg',
  noindex = false,
} = Astro.props;

const siteUrl = settingsSeo?.canonicalUrl || 'https://tourup.co';
const canonicalUrl = `${siteUrl}${currentPath}`;
const lang = currentPath.startsWith('/en/') ? 'en' : 'es';
const ogLocale = lang === 'en' ? 'en_US' : 'es_PE';
const ogType = currentPath.startsWith('/blog/') ? 'article' : 'website';
---

<meta name="description" content={description} />
{noindex && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonicalUrl} />
<title>{title}</title>

<!-- Open Graph -->
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={`${siteUrl}${image}`} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={ogLocale} />
<meta property="og:site_name" content="TourUp Peru" />

<!-- Twitter Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={`${siteUrl}${image}`} />

<!-- hreflang -->
<link rel="alternate" hrefLang="es" href={`${siteUrl}/`} />
<link rel="alternate" hrefLang="en" href={`${siteUrl}/en/`} />
<link rel="alternate" hrefLang="x-default" href={`${siteUrl}/`} />

{settingsSeo?.metaKeywords && <meta name="keywords" content={settingsSeo.metaKeywords} />}

<link rel="sitemap" type="application/xml" href={`${siteUrl}/sitemap.xml`} />

{settingsAdvanced?.customCss && <style>{settingsAdvanced.customCss}</style>}
{settingsAdvanced?.inlineStyles && <style>{settingsAdvanced.inlineStyles}</style>}
{settingsAdvanced?.customJsHead && <script set:html={settingsAdvanced.customJsHead}></script>}

{settingsIntegrations?.googleAnalyticsId && (
  <script async src={`https://www.googletagmanager.com/gtag/js?id=${settingsIntegrations.googleAnalyticsId}`}></script>
)}
{settingsIntegrations?.googleAnalyticsId && (
  <script set:html={`
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '${settingsIntegrations.googleAnalyticsId}');
  `}></script>
)}

{settingsIntegrations?.facebookPixelId && (
  <script set:html={`
    !function(f,b,e,v,n,t,s)
    {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
    n.callMethod.apply(n,arguments):n.queue.push(arguments)};
    if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
    n.queue=[];t=b.createElement(e);t.async=!0;
    t.src=v;s=b.getElementsByTagName(e)[0];
    s.parentNode.insertBefore(t,s)}(window, document,'script',
    'https://connect.facebook.net/en_US/fbevents.js');
    fbq('init', '${settingsIntegrations.facebookPixelId}');
    fbq('track', 'PageView');
  `}></script>
)}
