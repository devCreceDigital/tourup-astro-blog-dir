---
interface NavLink {
  href: string;
  label: string;
}

interface Props {
  lang: string;
  variant?: 'default' | 'home';
  links?: NavLink[];
  toursSlug?: string;
}

const { lang, links: customLinks, toursSlug, variant = 'default' } = Astro.props;

const t = (es: string, en: string) => lang === 'en' ? en : es;

const ts = toursSlug || 'cusco';

const defaultLinks: NavLink[] = [
  { href: `/${lang}/peru/`, label: t('Destinos', 'Destinations') },
  { href: `/${lang}/peru/${ts}/tours/`, label: t('Tours', 'Tours') },
  { href: `/${lang}/peru/itinerario-7-dias/`, label: t('Itinerarios', 'Itineraries') },
];

const homeLinks: NavLink[] = [
  { href: `/${lang}/#destinos`, label: t('Destinos', 'Destinations') },
  { href: `/${lang}/empresas/`, label: t('Empresas', 'Companies') },
  { href: `/${lang}/peru/itinerario-7-dias/`, label: t('Itinerarios', 'Itineraries') },
  { href: `/${lang}/ai-prompts/`, label: t('Guías', 'Guides') },
];

const links = customLinks || (variant === 'home' ? homeLinks : defaultLinks);
---

{
  variant === 'home' ? (
    <header class="cms-nav site-header">
      <div class="cms-nav-inner">
        <a href={`/${lang}/`} class="cms-nav-brand">
          <svg fill="none" height="20" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="20">
            <path d="M2 12h20M12 2v20"></path><path d="m4.93 4.93 14.14 14.14M19.07 4.93 4.93 19.07"></path>
          </svg>
          <span>TourUp</span>
        </a>
        <nav class="cms-nav-links">
          {links.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
        </nav>
        <a href={`/${lang}/ai-prompts/`} class="cms-nav-cta">{t("Explorar", "Explore")}</a>
      </div>
    </header>
  ) : (
    <nav class="cms-nav nav-bar">
      <div class="cms-nav-inner">
        <div class="cms-nav-left">
          <a href="/" class="cms-nav-logo">Tourup</a>
          <div class="cms-nav-links">
            {links.map((link) => (
              <a href={link.href}>{link.label}</a>
            ))}
          </div>
        </div>
        <div class="cms-nav-right">
          <button class="cms-nav-icon-btn"><span class="material-symbols-outlined">notifications</span></button>
          <button class="cms-nav-icon-btn"><span class="material-symbols-outlined">settings</span></button>
          <div class="cms-nav-avatar"><img src="https://lh3.googleusercontent.com/aida-public/AB6AXuAV7-vzsEP43jh-rE8HiRj61Dp5huvXfEo0tcs7K1A0Ja1CkhpkiYoPIR8cUTc1prZi3QkRXGG08hoEkRR-ZQncGlNifEnUk6Q3uK4kSWDyAOJXn9gwN-y3i__G-unt-v0buDLM-mlDWArN7Isq3G9__pJS3Mlg7Fl4O9GfzJB1-Cdsu_eB_vENzSGjqAkgNc3MlaZg1m5T2tDxy0niGsgB9_M8KWDZeWvfYmDnuxYY80ntwh6QFCucBzN8aT7Qk3g4oXtybXwhwW0t" alt="" /></div>
        </div>
      </div>
    </nav>
  )
}

<style>
  .site-header {
    border-bottom: 1px solid var(--nav-border, #e5e5e5);
    position: sticky;
    top: 0;
    background: var(--nav-bg, rgba(255,255,255,0.9));
    backdrop-filter: blur(8px);
    z-index: 50;
  }
  .site-header .cms-nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 24px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .site-header .cms-nav-brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    font-size: 14px;
    letter-spacing: -0.05em;
    color: var(--nav-text, #0a0a0a);
    text-decoration: none;
  }
  .site-header .cms-nav-brand svg { color: var(--nav-text, #0a0a0a); }
  .site-header .cms-nav-links {
    display: none;
    align-items: center;
    gap: 10px;
  }
  @media (min-width: 768px) { .site-header .cms-nav-links { display: flex; } }
  .site-header .cms-nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--nav-text, #0a0a0a);
    padding: 8px 12px;
    border-radius: 10px;
    transition: background 0.15s;
    display: flex;
    align-items: center;
    gap: 4px;
    text-decoration: none;
  }
  .site-header .cms-nav-links a:hover { background: var(--nav-hover-bg, #f2f2f2); }
  .cms-nav-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--color-primary);
    color: var(--color-on-primary);
    padding: 8px 16px;
    border-radius: 10px;
    font-size: 14px;
    font-weight: 500;
    transition: background 0.15s;
    text-decoration: none;
  }
  .cms-nav-cta:hover { background: var(--color-primary-hover); }

  .nav-bar {
    background: var(--nav-bg, #ffffff);
    height: 64px;
    width: 100%;
    border-bottom: 1px solid var(--nav-border, #e5e5e5);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .nav-bar .cms-nav-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px;
    height: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .cms-nav-left {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .cms-nav-logo {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.05em;
    color: var(--nav-text, #0a0a0a);
    text-decoration: none;
  }
  .nav-bar .cms-nav-links {
    display: none;
    gap: 10px;
    margin-left: 16px;
  }
  @media (min-width: 768px) { .nav-bar .cms-nav-links { display: flex; } }
  .nav-bar .cms-nav-links a {
    font-size: 14px;
    font-weight: 500;
    color: var(--nav-text-muted, #737373);
    text-decoration: none;
    padding: 4px 8px;
    border-radius: 4px;
    transition: background 0.1s;
  }
  .nav-bar .cms-nav-links a:hover { background: var(--nav-hover-bg, #f2f2f2); }
  .cms-nav-right {
    display: flex;
    align-items: center;
    gap: 16px;
  }
  .cms-nav-icon-btn {
    color: var(--nav-text-muted, #737373);
    background: none;
    border: none;
    padding: 4px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.1s;
  }
  .cms-nav-icon-btn:hover { background: var(--nav-hover-bg, #f2f2f2); }
  .cms-nav-icon-btn .material-symbols-outlined { font-size: 20px; }
  .cms-nav-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: 1px solid var(--nav-border, #e5e5e5);
    overflow: hidden;
    background: var(--nav-hover-bg, #f2f2f2);
  }
  .cms-nav-avatar img { width: 100%; height: 100%; object-fit: cover; }
</style>
