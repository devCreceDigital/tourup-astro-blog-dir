---
import Sidebar from './Sidebar.astro';
import TopBar from './TopBar.astro';
interface Props { title: string; }
const { title } = Astro.props;
const { lang } = Astro.params as { lang: string };
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang={lang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title} - TourUp CMS</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&family=Geist+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="admin-shell">
    <Sidebar lang={lang} currentPath={currentPath} />
    <div class="admin-content">
      <TopBar lang={lang} />
      <main class="admin-main">
        <slot />
      </main>
    </div>
  </div>
</body>
</html>

<style is:global>
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { font-family: 'Geist', sans-serif; background: #f9f9f9; color: #1a1c1c; }
  body { min-height: 100vh; }
  .admin-shell { display: flex; min-height: 100vh; }
  .admin-content { flex: 1; display: flex; flex-direction: column; overflow: hidden; }
  .admin-main { flex: 1; padding: 32px 48px; max-width: 1200px; }
</style>
