---
/**
 * Partner Scout Brief Form
 * Guided form to create a sourcing request
 */
import Layout from '../../layouts/Layout.astro';

// Get query params for pre-selection
const url = new URL(Astro.request.url);
const preselectedDestino = url.searchParams.get('destino') || 'cusco';
---

<Layout
  title="Crear Brief – Partner Scout | TourUp"
  description="Define los criterios de tu solicitud de cotización y recibe operadores preseleccionados."
  currentPath="/partner-scout/brief/"
>
  <div class="brief-page">

    <!-- Progress -->
    <div class="progress-bar">
      <div class="step active">
        <span class="step-number">1</span>
        <span class="step-label">Brief</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-number">2</span>
        <span class="step-label">Shortlist</span>
      </div>
      <div class="step-line"></div>
      <div class="step">
        <span class="step-number">3</span>
        <span class="step-label">Confirm</span>
      </div>
    </div>

    <div class="brief-layout">

      <!-- Main Form -->
      <div class="brief-main">
        <header class="brief-header">
          <h1>Crear Brief de Sourcing</h1>
          <p>Define los criterios de búsqueda para encontrar operadores que se ajusten a tus necesidades.</p>
        </header>

        <form id="brief-form" class="brief-form">

          <!-- Destination -->
          <section class="form-section">
            <h2>
              <span class="material-symbols-outlined">place</span>
              Destino Principal
            </h2>
            <div class="destino-selector">
              <label class="destino-option active" data-destino="cusco">
                <input type="radio" name="destino" value="cusco" checked />
                <div class="destino-card-mini">
                  <img src="https://images.pexels.com/photos/2356045/pexels-photo-2356045.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Cusco" />
                  <span class="destino-name">Cusco</span>
                  <span class="destino-check"><span class="material-symbols-outlined">check</span></span>
                </div>
              </label>
              <label class="destino-option" data-destino="lima">
                <input type="radio" name="destino" value="lima" />
                <div class="destino-card-mini">
                  <img src="https://images.pexels.com/photos/1781054/pexels-photo-1781054.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Lima" />
                  <span class="destino-name">Lima</span>
                  <span class="destino-check"><span class="material-symbols-outlined">check</span></span>
                </div>
              </label>
              <label class="destino-option" data-destino="arequipa">
                <input type="radio" name="destino" value="arequipa" />
                <div class="destino-card-mini">
                  <img src="https://images.pexels.com/photos/2195467/pexels-photo-2195467.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Arequipa" />
                  <span class="destino-name">Arequipa</span>
                  <span class="destino-check"><span class="material-symbols-outlined">check</span></span>
                </div>
              </label>
              <label class="destino-option" data-destino="puno">
                <input type="radio" name="destino" value="puno" />
                <div class="destino-card-mini">
                  <img src="https://images.pexels.com/photos/2087174/pexels-photo-2087174.jpeg?auto=compress&cs=tinysrgb&w=400" alt="Puno" />
                  <span class="destino-name">Puno</span>
                  <span class="destino-check"><span class="material-symbols-outlined">check</span></span>
                </div>
              </label>
            </div>
          </section>

          <!-- Experience Type -->
          <section class="form-section">
            <h2>
              <span class="material-symbols-outlined">explore</span>
              Tipo de Experiencia
            </h2>
            <div class="experience-grid">
              <label class="experience-card">
                <input type="checkbox" name="categorias" value="tours-comunitarios" />
                <div class="experience-content">
                  <span class="material-symbols-outlined">diversity_3</span>
                  <h3>Tours Comunitarios</h3>
                  <p>Experiencias auténticas con comunidades locales</p>
                </div>
                <span class="experience-check"><span class="material-symbols-outlined">check</span></span>
              </label>

              <label class="experience-card">
                <input type="checkbox" name="categorias" value="full-day" />
                <div class="experience-content">
                  <span class="material-symbols-outlined">today</span>
                  <h3>Full Day</h3>
                  <p>Excursiones de un día completo</p>
                </div>
                <span class="experience-check"><span class="material-symbols-outlined">check</span></span>
              </label>

              <label class="experience-card">
                <input type="checkbox" name="categorias" value="trekking" />
                <div class="experience-content">
                  <span class="material-symbols-outlined">hiking</span>
                  <h3>Trekking</h3>
                  <p>Caminatas y expediciones de varios días</p>
                </div>
                <span class="experience-check"><span class="material-symbols-outlined">check</span></span>
              </label>

              <label class="experience-card">
                <input type="checkbox" name="categorias" value="aventura" />
                <div class="experience-content">
                  <span class="material-symbols-outlined">paragliding</span>
                  <h3>Aventura</h3>
                  <p>Actividades de adrenalina y naturaleza</p>
                </div>
                <span class="experience-check"><span class="material-symbols-outlined">check</span></span>
              </label>
            </div>
          </section>

          <!-- Group Size -->
          <section class="form-section">
            <h2>
              <span class="material-symbols-outlined">groups</span>
              Tamaño de Grupo
            </h2>
            <div class="slider-group">
              <div class="slider-row">
                <label>Tamaño mínimo (pax)</label>
                <input type="range" name="group_min" min="1" max="50" value="2" id="group-min-slider" />
                <span class="slider-value" id="group-min-value">2 pax</span>
              </div>
              <div class="slider-row">
                <label>Tamaño máximo (pax)</label>
                <input type="range" name="group_max" min="2" max="100" value="15" id="group-max-slider" />
                <span class="slider-value" id="group-max-value">15 pax</span>
              </div>
              <p class="slider-hint">Busca operadores con capacidad para este rango</p>
            </div>
          </section>

          <!-- Rating Filter -->
          <section class="form-section">
            <h2>
              <span class="material-symbols-outlined">star</span>
              Rating Mínimo
            </h2>
            <div class="slider-group">
              <div class="slider-row">
                <label>Calificación mínima</label>
                <input type="range" name="rating_min" min="0" max="5" step="0.5" value="4" id="rating-slider" />
                <span class="slider-value" id="rating-value">4.0+ ⭐</span>
              </div>
            </div>
          </section>

          <!-- Languages -->
          <section class="form-section">
            <h2>
              <span class="material-symbols-outlined">translate</span>
              Idiomas Requeridos
            </h2>
            <div class="language-chips">
              <label class="chip">
                <input type="checkbox" name="languages" value="es" checked />
                <span>Español</span>
              </label>
              <label class="chip">
                <input type="checkbox" name="languages" value="en" checked />
                <span>Inglés</span>
              </label>
              <label class="chip">
                <input type="checkbox" name="languages" value="fr" />
                <span>Francés</span>
              </label>
              <label class="chip">
                <input type="checkbox" name="languages" value="de" />
                <span>Alemán</span>
              </label>
              <label class="chip">
                <input type="checkbox" name="languages" value="pt" />
                <span>Portugués</span>
              </label>
            </div>
          </section>

          <!-- B2B Profile -->
          <section class="form-section">
            <h2>
              <span class="material-symbols-outlined">business_center</span>
              Perfil B2B
            </h2>
            <div class="b2b-select">
              <label>Tipo de cliente</label>
              <select name="b2b_client_type">
                <option value="agencias_emisoras">Agencia Emisora</option>
                <option value="dmc">DMC</option>
                <option value="ota">OTA</option>
                <option value="corporativo">Corporativo</option>
              </select>
            </div>
            <div class="notes-field">
              <label for="notes">Notas adicionales (opcional)</label>
              <textarea
                name="notes"
                id="notes"
                rows="3"
                placeholder="Requisitos especiales, preferencias de contacto, etc."
              ></textarea>
            </div>
          </section>

          <!-- Submit -->
          <div class="form-actions">
            <button type="button" class="btn-back" onclick="window.history.back()">
              <span class="material-symbols-outlined">arrow_back</span>
              Volver
            </button>
            <button type="submit" class="btn-submit">
              Buscar Operadores
              <span class="material-symbols-outlined">arrow_forward</span>
            </button>
          </div>

        </form>
      </div>

      <!-- Sidebar -->
      <aside class="brief-sidebar">
        <div class="sidebar-card glass-panel">
          <h3>
            <span class="material-symbols-outlined">tips_and_updates</span>
            Tips para tu Brief
          </h3>
          <ul>
            <li>
              <strong>Sean específicos:</strong> Los detalles ayudan a mejores matches.
            </li>
            <li>
              <strong>Considera el tamaño:</strong> Operadores pequeños ofrecen más personalización.
            </li>
            <li>
              <strong>Idiomas:</strong> Asegura que el operador hable el idioma de tus clientes.
            </li>
          </ul>
        </div>

        <div class="sidebar-card glass-panel">
          <h3>
            <span class="material-symbols-outlined">help</span>
            ¿Necesitas Ayuda?
          </h3>
          <p>Contáctanos para asistencia personalizada en tu búsqueda.</p>
          <a href="mailto:hola@tourup.pe" class="contact-link">
            <span class="material-symbols-outlined">mail</span>
            hola@tourup.pe
          </a>
        </div>
      </aside>

    </div>
  </div>
</Layout>

<script>
  // Destination selector
  const destinoOptions = document.querySelectorAll('.destino-option');
  destinoOptions.forEach(opt => {
    opt.addEventListener('click', () => {
      destinoOptions.forEach(o => o.classList.remove('active'));
      opt.classList.add('active');
    });
  });

  // Sliders
  const groupMinSlider = document.getElementById('group-min-slider');
  const groupMaxSlider = document.getElementById('group-max-slider');
  const ratingSlider = document.getElementById('rating-slider');

  groupMinSlider?.addEventListener('input', (e) => {
    document.getElementById('group-min-value').textContent = `${e.target.value} pax`;
  });

  groupMaxSlider?.addEventListener('input', (e) => {
    document.getElementById('group-max-value').textContent = `${e.target.value} pax`;
  });

  ratingSlider?.addEventListener('input', (e) => {
    document.getElementById('rating-value').textContent = `${e.target.value}+ ⭐`;
  });

  // Form submit
  const form = document.getElementById('brief-form');
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    const formData = new FormData(form as HTMLFormElement);
    const params = new URLSearchParams();

    formData.forEach((value, key) => {
      if (key === 'categorias' || key === 'languages') {
        params.append(`${key}[]`, value as string);
      } else {
        params.append(key, value as string);
      }
    });

    window.location.href = `/partner-scout/shortlist/?${params.toString()}`;
  });
</script>

<style>
  .brief-page {
    padding-bottom: 4rem;
  }

  /* Progress */
  .progress-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-bottom: 3rem;
    padding-top: 1rem;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .step-number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(30, 41, 59, 0.8);
    border: 2px solid rgba(71, 85, 105, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    color: #64748b;
    transition: all 0.3s ease;
  }

  .step.active .step-number {
    background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    border-color: transparent;
    color: white;
  }

  .step-label {
    font-size: 0.8rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .step.active .step-label {
    color: #06b6d4;
  }

  .step-line {
    width: 80px;
    height: 2px;
    background: rgba(71, 85, 105, 0.3);
    margin: 0 1rem;
    margin-bottom: 1.5rem;
  }

  /* Layout */
  .brief-layout {
    display: grid;
    grid-template-columns: 1fr 320px;
    gap: 2.5rem;
  }

  /* Header */
  .brief-header {
    margin-bottom: 2.5rem;
  }

  .brief-header h1 {
    font-size: 2rem;
    color: #f1f5f9;
    margin-bottom: 0.5rem;
  }

  .brief-header p {
    color: #94a3b8;
    font-size: 1rem;
    margin: 0;
  }

  /* Form sections */
  .form-section {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid rgba(71, 85, 105, 0.2);
  }

  .form-section:last-of-type {
    border-bottom: none;
  }

  .form-section h2 {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 1.1rem;
    color: #f1f5f9;
    margin-bottom: 1.25rem;
  }

  .form-section h2 .material-symbols-outlined {
    color: #06b6d4;
  }

  /* Destino selector */
  .destino-selector {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .destino-option {
    cursor: pointer;
  }

  .destino-option input {
    display: none;
  }

  .destino-card-mini {
    position: relative;
    border-radius: 0.75rem;
    overflow: hidden;
    border: 2px solid rgba(71, 85, 105, 0.3);
    transition: all 0.2s ease;
  }

  .destino-option.active .destino-card-mini {
    border-color: #06b6d4;
    box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.2);
  }

  .destino-card-mini img {
    width: 100%;
    height: 80px;
    object-fit: cover;
  }

  .destino-name {
    display: block;
    padding: 0.75rem;
    text-align: center;
    background: rgba(30, 41, 59, 0.9);
    color: #f1f5f9;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .destino-check {
    position: absolute;
    top: 0.5rem;
    right: 0.5rem;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #06b6d4;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.2s ease;
  }

  .destino-option.active .destino-check {
    opacity: 1;
    transform: scale(1);
  }

  .destino-check .material-symbols-outlined {
    color: white;
    font-size: 1rem;
  }

  /* Experience cards */
  .experience-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  .experience-card {
    position: relative;
    display: block;
    padding: 1.25rem;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 0.75rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .experience-card:hover {
    border-color: rgba(6, 182, 212, 0.4);
  }

  .experience-card input {
    position: absolute;
    opacity: 0;
  }

  .experience-card:has(input:checked) {
    border-color: #06b6d4;
    background: rgba(6, 182, 212, 0.08);
  }

  .experience-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .experience-content .material-symbols-outlined {
    font-size: 2rem;
    color: #06b6d4;
    margin-bottom: 0.75rem;
  }

  .experience-content h3 {
    font-size: 1rem;
    color: #f1f5f9;
    margin: 0 0 0.35rem;
  }

  .experience-content p {
    font-size: 0.8rem;
    color: #94a3b8;
    margin: 0;
  }

  .experience-check {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: #06b6d4;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transform: scale(0.8);
    transition: all 0.2s ease;
  }

  .experience-card:has(input:checked) .experience-check {
    opacity: 1;
    transform: scale(1);
  }

  .experience-check .material-symbols-outlined {
    color: white;
    font-size: 1rem;
  }

  /* Sliders */
  .slider-group {
    background: rgba(30, 41, 59, 0.5);
    border-radius: 0.75rem;
    padding: 1.5rem;
  }

  .slider-row {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .slider-row:last-child {
    margin-bottom: 0;
  }

  .slider-row label {
    flex: 0 0 140px;
    font-size: 0.9rem;
    color: #94a3b8;
  }

  .slider-row input[type="range"] {
    flex: 1;
    height: 6px;
    background: rgba(71, 85, 105, 0.4);
    border-radius: 3px;
    appearance: none;
    outline: none;
  }

  .slider-row input[type="range"]::-webkit-slider-thumb {
    appearance: none;
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(6, 182, 212, 0.4);
  }

  .slider-value {
    flex: 0 0 80px;
    text-align: right;
    color: #06b6d4;
    font-weight: 600;
    font-size: 0.95rem;
  }

  .slider-hint {
    font-size: 0.8rem;
    color: #64748b;
    margin: 0.75rem 0 0;
    text-align: center;
  }

  /* Chips */
  .language-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chip {
    display: flex;
    align-items: center;
    cursor: pointer;
  }

  .chip input {
    display: none;
  }

  .chip span {
    display: inline-block;
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    border: 1px solid rgba(71, 85, 105, 0.4);
    background: transparent;
    color: #94a3b8;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .chip:has(input:checked) span {
    background: rgba(6, 182, 212, 0.15);
    border-color: rgba(6, 182, 212, 0.4);
    color: #06b6d4;
  }

  /* B2B Select */
  .b2b-select {
    margin-bottom: 1.25rem;
  }

  .b2b-select label {
    display: block;
    font-size: 0.9rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
  }

  .b2b-select select {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(71, 85, 105, 0.4);
    border-radius: 0.5rem;
    color: #f1f5f9;
    font-size: 1rem;
    cursor: pointer;
  }

  .b2b-select select:focus {
    outline: none;
    border-color: #06b6d4;
  }

  .notes-field label {
    display: block;
    font-size: 0.9rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
  }

  .notes-field textarea {
    width: 100%;
    padding: 0.75rem 1rem;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(71, 85, 105, 0.4);
    border-radius: 0.5rem;
    color: #f1f5f9;
    font-size: 0.95rem;
    font-family: inherit;
    resize: vertical;
  }

  .notes-field textarea:focus {
    outline: none;
    border-color: #06b6d4;
  }

  .notes-field textarea::placeholder {
    color: #64748b;
  }

  /* Actions */
  .form-actions {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(71, 85, 105, 0.2);
  }

  .btn-back {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem 1.5rem;
    background: transparent;
    border: 1px solid rgba(71, 85, 105, 0.4);
    border-radius: 0.5rem;
    color: #94a3b8;
    font-size: 0.95rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-back:hover {
    border-color: rgba(71, 85, 105, 0.6);
    color: #f1f5f9;
  }

  .btn-submit {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 2rem;
    background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    border: none;
    border-radius: 0.5rem;
    color: white;
    font-size: 1rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-submit:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(6, 182, 212, 0.35);
  }

  .btn-submit .material-symbols-outlined {
    font-size: 1.1rem;
  }

  /* Sidebar */
  .brief-sidebar {
    position: sticky;
    top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .sidebar-card {
    padding: 1.5rem;
  }

  .sidebar-card h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    color: #f1f5f9;
    margin: 0 0 1rem;
  }

  .sidebar-card h3 .material-symbols-outlined {
    color: #06b6d4;
  }

  .sidebar-card ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .sidebar-card li {
    font-size: 0.9rem;
    color: #94a3b8;
    margin-bottom: 0.75rem;
    padding-left: 0;
  }

  .sidebar-card li strong {
    color: #f1f5f9;
    display: block;
    margin-bottom: 0.2rem;
  }

  .sidebar-card p {
    font-size: 0.9rem;
    color: #94a3b8;
    margin: 0 0 1rem;
