---
/**
 * Partner Scout B2B Hub
 * Premium landing for sourcing Peruvian operators
 */
import Layout from '../../layouts/Layout.astro';
---

<Layout
  title="Partner Scout – Sourcing B2B de Operadores en Perú | TourUp"
  description="Encuentra operadores turísticos receptivos en Perú que cumplan tus criterios B2B: destino, categoría, rating, idioma y capacidad de grupo."
  currentPath="/partner-scout/"
>
  <div class="ps-hub">

    <!-- Hero -->
    <section class="hero">
      <div class="hero-bg"></div>
      <div class="hero-content">
        <div class="hero-badge">
          <span class="material-symbols-outlined">travel_explore</span>
          Partner Scout B2B
        </div>
        <h1>Encuentra tu operador receptivo ideal en Perú</h1>
        <p class="hero-subtitle">
          Sourcing inteligente para agencias emisoras, DMCs y OTAs.
          Te conectamos con operadores verificados.
        </p>

        <div class="search-bar">
          <span class="material-symbols-outlined search-icon">search</span>
          <input type="text" placeholder="Buscar por destino, operador o categoría..." id="global-search" />
          <button class="btn-primary" onclick="window.location.href='/partner-scout/brief/'">
            <span class="material-symbols-outlined">arrow_forward</span>
            Crear Cotización Rápida
          </button>
        </div>

        <div class="hero-stats">
          <div class="stat">
            <strong>150+</strong>
            <span>Operadores</span>
          </div>
          <div class="stat">
            <strong>24</strong>
            <span>Destinos</span>
          </div>
          <div class="stat">
            <strong>98%</strong>
            <span>Tasa de Match</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Destinos Grid -->
    <section class="destinos-section">
      <div class="section-header">
        <h2>Explora por Destino</h2>
        <a href="/partner-scout/brief/?destino=cusco" class="view-all">
          Ver Todos <span class="material-symbols-outlined">arrow_forward</span>
        </a>
      </div>

      <div class="destinos-grid">
        <div class="destino-card" onclick="window.location.href='/partner-scout/brief/?destino=cusco'">
          <div class="destino-image">
            <img src="https://images.pexels.com/photos/2356045/pexels-photo-2356045.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Machu Picchu, Cusco" />
            <div class="destino-overlay"></div>
          </div>
          <div class="destino-content">
            <span class="destino-badge">Más solicitado</span>
            <h3>Cusco</h3>
            <p>Imperio Inca, Machu Picchu, Valle Sagrado</p>
            <div class="destino-meta">
              <span><span class="material-symbols-outlined">business</span> 45 operadores</span>
              <span><span class="material-symbols-outlined">star</span> 4.8 avg</span>
            </div>
          </div>
          <div class="destino-hover-panel">
            <span class="material-symbols-outlined">trending_flat</span>
            Crear Brief
          </div>
        </div>

        <div class="destino-card" onclick="window.location.href='/partner-scout/brief/?destino=lima'">
          <div class="destino-image">
            <img src="https://images.pexels.com/photos/1781054/pexels-photo-1781054.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Lima" />
            <div class="destino-overlay"></div>
          </div>
          <div class="destino-content">
            <h3>Lima</h3>
            <p>Capital gastronómica, city tours, cultura</p>
            <div class="destino-meta">
              <span><span class="material-symbols-outlined">business</span> 38 operadores</span>
              <span><span class="material-symbols-outlined">star</span> 4.6 avg</span>
            </div>
          </div>
          <div class="destino-hover-panel">
            <span class="material-symbols-outlined">trending_flat</span>
            Crear Brief
          </div>
        </div>

        <div class="destino-card" onclick="window.location.href='/partner-scout/brief/?destino=arequipa'">
          <div class="destino-image">
            <img src="https://images.pexels.com/photos/2195467/pexels-photo-2195467.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Colca Canyon, Arequipa" />
            <div class="destino-overlay"></div>
          </div>
          <div class="destino-content">
            <h3>Arequipa</h3>
            <p>Cañón del Colca, volcán Misti, aventura</p>
            <div class="destino-meta">
              <span><span class="material-symbols-outlined">business</span> 22 operadores</span>
              <span><span class="material-symbols-outlined">star</span> 4.7 avg</span>
            </div>
          </div>
          <div class="destino-hover-panel">
            <span class="material-symbols-outlined">trending_flat</span>
            Crear Brief
          </div>
        </div>

        <div class="destino-card" onclick="window.location.href='/partner-scout/brief/?destino=puno'">
          <div class="destino-image">
            <img src="https://images.pexels.com/photos/2087174/pexels-photo-2087174.jpeg?auto=compress&cs=tinysrgb&w=800" alt="Titicaca Lake, Puno" />
            <div class="destino-overlay"></div>
          </div>
          <div class="destino-content">
            <h3>Puno</h3>
            <p>Lago Titicaca, Uros, Taquile</p>
            <div class="destino-meta">
              <span><span class="material-symbols-outlined">business</span> 18 operadores</span>
              <span><span class="material-symbols-outlined">star</span> 4.5 avg</span>
            </div>
          </div>
          <div class="destino-hover-panel">
            <span class="material-symbols-outlined">trending_flat</span>
            Crear Brief
          </div>
        </div>
      </div>
    </section>

    <!-- Value Props -->
    <section class="features-section">
      <div class="section-header centered">
        <h2>¿Por qué Partner Scout?</h2>
      </div>

      <div class="features-grid">
        <div class="feature-card glass-panel">
          <div class="feature-icon">
            <span class="material-symbols-outlined">verified</span>
          </div>
          <h3>Operadores Verificados</h3>
          <p>Cada operador pasa por validación de licencias, RUC y referencias B2B.</p>
        </div>

        <div class="feature-card glass-panel">
          <div class="feature-icon">
            <span class="material-symbols-outlined">speed</span>
          </div>
          <h3>Match Inteligente</h3>
          <p>Algoritmo que prioriza capacidad, idiomas y experiencia en tu categoría.</p>
        </div>

        <div class="feature-card glass-panel">
          <div class="feature-icon">
            <span class="material-symbols-outlined">handshake</span>
          </div>
          <h3>Sin Intermediarios</h3>
          <p>Contacto directo con el operador. Sin comisiones ocultas ni sorpresas.</p>
        </div>
      </div>
    </section>

    <!-- Quick Actions -->
    <section class="cta-section">
      <div class="cta-panel glass-panel-dark">
        <div class="cta-content">
          <h2>¿Listo para encontrar tu socio perfecto?</h2>
          <p>Crea un brief detallado y recibe una preselección de operadores calificados en minutos.</p>
        </div>
        <div class="cta-actions">
          <a href="/partner-scout/brief/" class="btn-primary large">
            <span class="material-symbols-outlined">edit_note</span>
            Crear Brief
          </a>
          <a href="/empresas/" class="btn-secondary">
            Ver Directorio
          </a>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  .ps-hub {
    padding-bottom: 4rem;
  }

  /* Hero */
  .hero {
    position: relative;
    min-height: 500px;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 4rem 2rem;
    margin: -2rem -2rem 0;
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%);
    z-index: -2;
  }

  .hero-bg::before {
    content: '';
    position: absolute;
    inset: 0;
    background: url('https://images.pexels.com/photos/2356045/pexels-photo-2356045.jpeg?auto=compress&cs=tinysrgb&w=1920') center/cover;
    opacity: 0.15;
    filter: grayscale(40%);
  }

  .hero-bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 0%, #0f172a 70%);
  }

  .hero-content {
    position: relative;
    z-index: 1;
    max-width: 800px;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(6, 182, 212, 0.15);
    border: 1px solid rgba(6, 182, 212, 0.3);
    color: #06b6d4;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 1.5rem;
  }

  .hero-badge .material-symbols-outlined {
    font-size: 1.1rem;
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, #f1f5f9 0%, #94a3b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #94a3b8;
    margin-bottom: 2rem;
    line-height: 1.7;
  }

  .search-bar {
    display: flex;
    align-items: center;
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(71, 85, 105, 0.4);
    border-radius: 1rem;
    padding: 0.5rem 0.5rem 0.5rem 1.25rem;
    margin-bottom: 2.5rem;
    backdrop-filter: blur(12px);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  .search-icon {
    color: #64748b;
    font-size: 1.25rem;
  }

  .search-bar input {
    flex: 1;
    background: transparent;
    border: none;
    color: #f1f5f9;
    font-size: 1rem;
    padding: 0.75rem;
    outline: none;
  }

  .search-bar input::placeholder {
    color: #64748b;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    color: white;
    border: none;
    padding: 0.75rem 1.25rem;
    border-radius: 0.625rem;
    font-weight: 600;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(6, 182, 212, 0.35);
  }

  .btn-primary .material-symbols-outlined {
    font-size: 1.1rem;
  }

  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 3rem;
  }

  .stat {
    text-align: center;
  }

  .stat strong {
    display: block;
    font-size: 2rem;
    color: #06b6d4;
    line-height: 1.2;
  }

  .stat span {
    font-size: 0.85rem;
    color: #94a3b8;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Sections */
  .destinos-section,
  .features-section,
  .cta-section {
    padding: 4rem 0;
  }

  .section-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
  }

  .section-header.centered {
    justify-content: center;
    text-align: center;
  }

  .section-header h2 {
    font-size: 1.75rem;
    color: #f1f5f9;
    margin: 0;
  }

  .view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: #06b6d4;
    font-weight: 600;
    font-size: 0.9rem;
  }

  .view-all .material-symbols-outlined {
    font-size: 1.1rem;
    transition: transform 0.2s ease;
  }

  .view-all:hover .material-symbols-outlined {
    transform: translateX(4px);
  }

  /* Destino Cards */
  .destinos-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
  }

  .destino-card {
    position: relative;
    border-radius: 1rem;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.3s ease;
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(71, 85, 105, 0.3);
  }

  .destino-card:hover {
    transform: translateY(-8px);
    border-color: rgba(6, 182, 212, 0.4);
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.4);
  }

  .destino-image {
    position: relative;
    height: 180px;
    overflow: hidden;
  }

  .destino-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .destino-card:hover .destino-image img {
    transform: scale(1.1);
  }

  .destino-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(15, 23, 42, 0.95) 0%, rgba(15, 23, 42, 0.4) 50%, transparent 100%);
  }

  .destino-content {
    padding: 1.25rem;
    position: relative;
  }

  .destino-badge {
    display: inline-block;
    background: rgba(34, 197, 94, 0.15);
    color: #4ade80;
    padding: 0.2rem 0.6rem;
    border-radius: 0.25rem;
    font-size: 0.65rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.5rem;
  }

  .destino-content h3 {
    font-size: 1.25rem;
    margin: 0 0 0.35rem;
    color: #f1f5f9;
  }

  .destino-content p {
    font-size: 0.85rem;
    color: #94a3b8;
    margin: 0 0 0.75rem;
    line-height: 1.5;
  }

  .destino-meta {
    display: flex;
    gap: 1rem;
    font-size: 0.75rem;
    color: #64748b;
  }

  .destino-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .destino-meta .material-symbols-outlined {
    font-size: 0.9rem;
  }

  .destino-hover-panel {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    color: white;
    padding: 0.75rem 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    transform: translateY(100%);
    transition: transform 0.3s ease;
  }

  .destino-card:hover .destino-hover-panel {
    transform: translateY(0);
  }

  /* Glass panels */
  .glass-panel {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 1rem;
    backdrop-filter: blur(12px);
  }

  .glass-panel-dark {
    background: rgba(15, 23, 42, 0.7);
    border: 1px solid rgba(71, 85, 105, 0.25);
    border-radius: 1.5rem;
    backdrop-filter: blur(16px);
  }

  /* Features */
  .features-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .feature-card {
    padding: 2rem;
    text-align: center;
    transition: all 0.2s ease;
  }

  .feature-card:hover {
    border-color: rgba(6, 182, 212, 0.4);
    transform: translateY(-4px);
  }

  .feature-icon {
    width: 56px;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.15) 0%, rgba(6, 182, 212, 0.15) 100%);
    border-radius: 1rem;
    margin: 0 auto 1.25rem;
  }

  .feature-icon .material-symbols-outlined {
    font-size: 1.75rem;
    color: #06b6d4;
  }

  .feature-card h3 {
    font-size: 1.1rem;
    color: #f1f5f9;
    margin: 0 0 0.75rem;
  }

  .feature-card p {
    font-size: 0.9rem;
    color: #94a3b8;
    margin: 0;
    line-height: 1.6;
  }

  /* CTA */
  .cta-panel {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 3rem;
    gap: 2rem;
  }

  .cta-content h2 {
    font-size: 1.5rem;
    color: #f1f5f9;
    margin: 0 0 0.5rem;
  }

  .cta-content p {
    color: #94a3b8;
    margin: 0;
    font-size: 1rem;
  }

  .cta-actions {
    display: flex;
    gap: 1rem;
  }

  .btn-primary.large {
    padding: 1rem 1.5rem;
    font-size: 1rem;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid rgba(148, 163, 184, 0.3);
    color: #94a3b8;
    padding: 0.75rem 1.25rem;
    border-radius: 0.625rem;
    font-weight: 600;
    font-size: 0.9rem;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: rgba(148, 163, 184, 0.5);
    color: #f1f5f9;
    background: rgba(148, 163, 184, 0.1);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .destinos-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .features-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .cta-panel {
      flex-direction: column;
      text-align: center;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 3rem 1.5rem;
      min-height: auto;
    }

    .hero h1 {
      font-size: 2rem;
    }

    .search-bar {
      flex-direction: column;
      gap: 0.75rem;
      padding: 0.75rem;
    }

    .search-bar input {
      width: 100%;
      text-align: center;
    }

    .btn-primary {
      width: 100%;
      justify-content: center;
    }

    .hero-stats {
      gap: 1.5rem;
    }

    .stat strong {
      font-size: 1.5rem;
    }

    .destinos-grid,
    .features-grid {
      grid-template-columns: 1fr;
    }

    .destino-image {
      height: 140px;
    }
  }
</style>

<!-- Material Symbols -->
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
