---
/**
 * Partner Scout Confirmation
 * Success page after RFP submission
 */
import { getAllCompaniesCatalog } from '../../utils/graphify';
import Layout from '../../layouts/Layout.astro';

const catalog = await getAllCompaniesCatalog();

// Parse URL params
const url = new URL(Astro.request.url);
const destino = url.searchParams.get('destino') || 'cusco';
const operatorIds = (url.searchParams.get('operators') || '').split(',').filter(Boolean);
const group = url.searchParams.get('group') || '2-15';

// Get selected operators
const selectedOperators = catalog.filter(c => operatorIds.includes(c.id));

// Calculate estimated response time
const avgResponseTime = selectedOperators.length > 0
  ? Math.min(...selectedOperators.map(o => o.trust_metrics?.avg_response_time_hours || 48))
  : 48;
---

<Layout
  title="Solicitud Enviada – Partner Scout | TourUp"
  description="Tu solicitud RFP ha sido enviada exitosamente."
  currentPath="/partner-scout/confirm/"
>
  <div class="confirm-page">

    <!-- Progress -->
    <div class="progress-bar">
      <div class="step completed">
        <span class="step-number">
          <span class="material-symbols-outlined">check</span>
        </span>
        <span class="step-label">Brief</span>
      </div>
      <div class="step-line completed"></div>
      <div class="step completed">
        <span class="step-number">
          <span class="material-symbols-outlined">check</span>
        </span>
        <span class="step-label">Shortlist</span>
      </div>
      <div class="step-line completed"></div>
      <div class="step active">
        <span class="step-number">3</span>
        <span class="step-label">Confirm</span>
      </div>
    </div>

    <div class="confirm-container">

      <!-- Success Message -->
      <section class="success-section glass-panel">
        <div class="success-icon">
          <div class="icon-circle">
            <span class="material-symbols-outlined">check_circle</span>
          </div>
          <div class="confetti">
            <span class="confetti-piece"></span>
            <span class="confetti-piece"></span>
            <span class="confetti-piece"></span>
            <span class="confetti-piece"></span>
            <span class="confetti-piece"></span>
            <span class="confetti-piece"></span>
          </div>
        </div>

        <h1>Solicitud Enviada Exitosamente</h1>
        <p class="success-message">
          Tu solicitud RFP ha sido enviada a {selectedOperators.length > 0 ? selectedOperators.length : 'los operadores'} seleccionados.
          Recibirás respuestas en las próximas <strong>{avgResponseTime} horas</strong>.
        </p>

        <div class="success-badge">
          <span class="material-symbols-outlined">schedule</span>
          Respuesta estimada: {avgResponseTime <= 24 ? '24h' : avgResponseTime <= 48 ? '24-48h' : '48-72h'}
        </div>
      </section>

      <!-- Summary Grid -->
      <section class="summary-grid">
        <div class="summary-card glass-panel">
          <div class="card-icon">
            <span class="material-symbols-outlined">place</span>
          </div>
          <h3>Destino</h3>
          <p>{destino.charAt(0).toUpperCase() + destino.slice(1)}</p>
        </div>

        <div class="summary-card glass-panel">
          <div class="card-icon">
            <span class="material-symbols-outlined">business</span>
          </div>
          <h3>Operadores</h3>
          <p>{selectedOperators.length}</p>
        </div>

        <div class="summary-card glass-panel">
          <div class="card-icon">
            <span class="material-symbols-outlined">groups</span>
          </div>
          <h3>Grupo</h3>
          <p>{group} pax</p>
        </div>

        <div class="summary-card glass-panel">
          <div class="card-icon">
            <span class="material-symbols-outlined">schedule</span>
          </div>
          <h3>Tiempo Respuesta</h3>
          <p>{avgResponseTime}h</p>
        </div>
      </section>

      <!-- Selected Operators -->
      {selectedOperators.length > 0 && (
        <section class="operators-section">
          <h2>
            <span class="material-symbols-outlined">handshake</span>
            Operadores Contactados
          </h2>
          <div class="operators-list">
            {selectedOperators.map(op => (
              <div class="operator-row">
                <div class="operator-info">
                  <h4>{op.title}</h4>
                  {op.rating && (
                    <span class="rating">
                      <span class="stars">{'★'.repeat(Math.floor(op.rating))}{'☆'.repeat(5 - Math.floor(op.rating))}</span>
                      {op.rating}/5
                    </span>
                  )}
                </div>
                <div class="operator-status">
                  <span class="status-badge pending">
                    <span class="material-symbols-outlined">hourglass_empty</span>
                    Pendiente
                  </span>
                  <a href={op.url} class="btn-link">Ver Ficha</a>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- Next Steps -->
      <section class="next-steps glass-panel">
        <h2>
          <span class="material-symbols-outlined">route</span>
          Próximos Pasos
        </h2>
        <ul class="steps-list">
          <li>
            <span class="step-icon">
              <span class="material-symbols-outlined">mail</span>
            </span>
            <div class="step-content">
              <strong>Revisa tu correo</strong>
              <p>Recibirás confirmación y copia de la solicitud en tu email registrado.</p>
            </div>
          </li>
          <li>
            <span class="step-icon">
              <span class="material-symbols-outlined">compare_arrows</span>
            </span>
            <div class="step-content">
              <strong>Evalúa las propuestas</strong>
              <p>Compara precios, disponibilidad y condiciones de cada operador.</p>
            </div>
          </li>
          <li>
            <span class="step-icon">
              <span class="material-symbols-outlined">handshake</span>
            </span>
            <div class="step-content">
              <strong>Confirma tu elección</strong>
              <p>Selecciona el operador que mejor se adapte a tus necesidades.</p>
            </div>
          </li>
        </ul>
      </section>

      <!-- Actions -->
      <div class="confirm-actions">
        <a href="/partner-scout/" class="btn-primary large">
          <span class="material-symbols-outlined">travel_explore</span>
          Nueva Búsqueda
        </a>
        <a href="/es/empresas/" class="btn-secondary">
          <span class="material-symbols-outlined">business</span>
          Ver Directorio
        </a>
      </div>

    </div>
  </div>
</Layout>

<style>
  .confirm-page {
    padding-bottom: 4rem;
  }

  /* Progress */
  .progress-bar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0;
    margin-bottom: 3rem;
    padding-top: 1rem;
  }

  .step {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .step-number {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(30, 41, 59, 0.8);
    border: 2px solid rgba(71, 85, 105, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 1rem;
    color: #64748b;
    transition: all 0.3s ease;
  }

  .step.completed .step-number,
  .step.active .step-number {
    background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    border-color: transparent;
    color: white;
  }

  .step-label {
    font-size: 0.8rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .step.completed .step-label,
  .step.active .step-label {
    color: #06b6d4;
  }

  .step .step-number .material-symbols-outlined {
    font-size: 1.1rem;
  }

  .step-line {
    width: 80px;
    height: 2px;
    background: rgba(71, 85, 105, 0.3);
    margin: 0 1rem;
    margin-bottom: 1.5rem;
  }

  .step-line.completed {
    background: linear-gradient(90deg, #3b82f6 0%, #06b6d4 100%);
  }

  /* Container */
  .confirm-container {
    max-width: 800px;
    margin: 0 auto;
  }

  /* Success Section */
  .success-section {
    text-align: center;
    padding: 3rem;
    margin-bottom: 2.5rem;
  }

  .success-icon {
    position: relative;
    display: inline-block;
    margin-bottom: 1.5rem;
  }

  .icon-circle {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    background: linear-gradient(135deg, rgba(34, 197, 94, 0.2) 0%, rgba(74, 222, 128, 0.2) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    animation: scale-in 0.4s ease-out;
  }

  .icon-circle .material-symbols-outlined {
    font-size: 3.5rem;
    color: #4ade80;
  }

  @keyframes scale-in {
    0% { transform: scale(0.5); opacity: 0; }
    100% { transform: scale(1); opacity: 1; }
  }

  .confetti {
    position: absolute;
    inset: -20px;
    pointer-events: none;
  }

  .confetti-piece {
    position: absolute;
    width: 10px;
    height: 10px;
    border-radius: 2px;
    animation: confetti-fall 1s ease-out forwards;
  }

  .confetti-piece:nth-child(1) { left: 20%; background: #3b82f6; animation-delay: 0s; }
  .confetti-piece:nth-child(2) { left: 35%; background: #06b6d4; animation-delay: 0.1s; }
  .confetti-piece:nth-child(3) { left: 50%; background: #4ade80; animation-delay: 0.15s; }
  .confetti-piece:nth-child(4) { left: 65%; background: #fbbf24; animation-delay: 0.2s; }
  .confetti-piece:nth-child(5) { left: 75%; background: #06b6d4; animation-delay: 0.25s; }
  .confetti-piece:nth-child(6) { left: 85%; background: #3b82f6; animation-delay: 0.3s; }

  @keyframes confetti-fall {
    0% { transform: translateY(0) rotate(0deg); opacity: 1; }
    100% { transform: translateY(-60px) rotate(180deg); opacity: 0; }
  }

  .success-section h1 {
    font-size: 2rem;
    color: #f1f5f9;
    margin: 0 0 1rem;
  }

  .success-message {
    font-size: 1.1rem;
    color: #94a3b8;
    line-height: 1.7;
    max-width: 500px;
    margin: 0 auto 1.5rem;
  }

  .success-message strong {
    color: #4ade80;
  }

  .success-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(34, 197, 94, 0.15);
    border: 1px solid rgba(34, 197, 94, 0.3);
    color: #4ade80;
    padding: 0.5rem 1.25rem;
    border-radius: 9999px;
    font-size: 0.9rem;
    font-weight: 600;
  }

  .success-badge .material-symbols-outlined {
    font-size: 1.1rem;
  }

  /* Summary Grid */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
  }

  .summary-card {
    text-align: center;
    padding: 1.5rem;
  }

  .card-icon {
    width: 48px;
    height: 48px;
    margin: 0 auto 1rem;
    background: rgba(6, 182, 212, 0.15);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-icon .material-symbols-outlined {
    font-size: 1.5rem;
    color: #06b6d4;
  }

  .summary-card h3 {
    font-size: 0.8rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 0.5rem;
  }

  .summary-card p {
    font-size: 1.25rem;
    color: #f1f5f9;
    font-weight: 600;
    margin: 0;
  }

  /* Operators Section */
  .operators-section {
    margin-bottom: 2.5rem;
  }

  .operators-section h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    color: #f1f5f9;
    margin-bottom: 1rem;
  }

  .operators-section h2 .material-symbols-outlined {
    color: #06b6d4;
  }

  .operators-list {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .operator-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(71, 85, 105, 0.2);
  }

  .operator-row:last-child {
    border-bottom: none;
  }

  .operator-info h4 {
    font-size: 1rem;
    color: #f1f5f9;
    margin: 0 0 0.25rem;
  }

  .rating {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.85rem;
    color: #94a3b8;
  }

  .stars {
    color: #fbbf24;
    font-size: 0.8rem;
  }

  .operator-status {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .status-badge.pending {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
    border: 1px solid rgba(251, 191, 36, 0.3);
  }

  .status-badge .material-symbols-outlined {
    font-size: 1rem;
  }

  .btn-link {
    color: #06b6d4;
    font-size: 0.85rem;
    font-weight: 600;
  }

  /* Next Steps */
  .next-steps {
    padding: 2rem;
    margin-bottom: 2.5rem;
  }

  .next-steps h2 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    color: #f1f5f9;
    margin: 0 0 1.5rem;
  }

  .next-steps h2 .material-symbols-outlined {
    color: #06b6d4;
  }

  .steps-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .steps-list li {
    display: flex;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .steps-list li:last-child {
    margin-bottom: 0;
  }

  .step-icon {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: rgba(6, 182, 212, 0.15);
    border-radius: 0.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .step-icon .material-symbols-outlined {
    font-size: 1.25rem;
    color: #06b6d4;
  }

  .step-content strong {
    display: block;
    color: #f1f5f9;
    font-size: 1rem;
    margin-bottom: 0.25rem;
  }

  .step-content p {
    color: #94a3b8;
    font-size: 0.9rem;
    margin: 0;
  }

  /* Actions */
  .confirm-actions {
    display: flex;
    justify-content: center;
    gap: 1rem;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #3b82f6 0%, #06b6d4 100%);
    border: none;
    border-radius: 0.5rem;
    color: white;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .btn-primary.large {
    padding: 1rem 2rem;
    font-size: 1rem;
  }

  .btn-primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px rgba(6, 182, 212, 0.35);
  }

  .btn-primary .material-symbols-outlined {
    font-size: 1.1rem;
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid rgba(71, 85, 105, 0.4);
    border-radius: 0.5rem;
    color: #94a3b8;
    padding: 0.875rem 1.75rem;
    font-size: 1rem;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn-secondary:hover {
    border-color: rgba(71, 85, 105, 0.6);
    color: #f1f5f9;
    background: rgba(71, 85, 105, 0.1);
  }

  .btn-secondary .material-symbols-outlined {
    font-size: 1.1rem;
  }

  .glass-panel {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(71, 85, 105, 0.3);
    border-radius: 1rem;
    backdrop-filter: blur(12px);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .summary-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .success-section {
      padding: 2rem;
    }

    .success-section h1 {
      font-size: 1.5rem;
    }

    .operator-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.75rem;
    }

    .operator-status {
      width: 100%;
      justify-content: space-between;
    }

    .confirm-actions {
      flex-direction: column;
    }
  }

  @media (max-width: 480px) {
    .summary-grid {
      grid-template-columns: 1fr 1fr;
    }

    .steps-list li {
      flex-direction: column;
      gap: 0.75rem;
    }
  }
</style>

<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@24,400,0,0" rel="stylesheet" />
