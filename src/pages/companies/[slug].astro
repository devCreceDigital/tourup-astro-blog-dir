---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map((company) => ({
    params: { slug: company.slug },
    props: { company },
  }));
}

interface Props {
  company: any;
}

const { company } = Astro.props;
const { Content } = await company.render();
---

<Layout
  title={company.data.title}
  description={company.data.summary}
  currentPath={`/companies/${company.slug}/`}
>
  <article class="company-page">
    <header class="company-header">
      <div class="company-meta">
        <span class="badge">{company.data.distribution_role}</span>
        {company.data.sales_channel && (
          <span class="badge secondary">{company.data.sales_channel}</span>
        )}
      </div>
      <h1>{company.data.title}</h1>
      <p class="company-summary">{company.data.summary}</p>
    </header>

    <div class="company-content-wrapper">
      <div class="company-main">
        <section class="company-body">
          <Content />
        </section>
      </div>

      <aside class="company-sidebar">
        {company.data.contact && (
          <div class="info-card">
            <h3>Contact Information</h3>
            {company.data.contact.website && (
              <p>
                <strong>Website:</strong><br />
                <a href={company.data.contact.website} target="_blank" rel="noopener noreferrer">
                  {company.data.contact.website}
                </a>
              </p>
            )}
            {company.data.contact.email && (
              <p>
                <strong>Email:</strong><br />
                <a href={`mailto:${company.data.contact.email}`}>
                  {company.data.contact.email}
                </a>
              </p>
            )}
            {company.data.contact.phone && (
              <p>
                <strong>Phone:</strong><br />
                {company.data.contact.phone}
              </p>
            )}
            {company.data.contact.phone_alt_1 && (
              <p>
                <strong>Phone (Alt):</strong><br />
                {company.data.contact.phone_alt_1}
              </p>
            )}
          </div>
        )}

        {company.data.location && (
          <div class="info-card">
            <h3>Location</h3>
            {company.data.location.city && (
              <p><strong>City:</strong> {company.data.location.city}</p>
            )}
            {company.data.location.province && (
              <p><strong>Province:</strong> {company.data.location.province}</p>
            )}
            {company.data.location.region && (
              <p><strong>Region:</strong> {company.data.location.region}</p>
            )}
            {company.data.location.country && (
              <p><strong>Country:</strong> {company.data.location.country}</p>
            )}
          </div>
        )}

        {company.data.regulation && (
          <div class="info-card">
            <h3>Regulatory Information</h3>
            {company.data.regulation.tax_id && (
              <p><strong>Tax ID:</strong> {company.data.regulation.tax_id}</p>
            )}
            {company.data.regulation.license_number && (
              <p><strong>License:</strong> {company.data.regulation.license_number}</p>
            )}
            {company.data.regulation.license_issue_date && (
              <p><strong>License Issued:</strong> {company.data.regulation.license_issue_date}</p>
            )}
          </div>
        )}

        {company.data.legal_representative && (
          <div class="info-card">
            <h3>Legal Representative</h3>
            <p>{company.data.legal_representative}</p>
          </div>
        )}
      </aside>
    </div>
  </article>

  <nav class="company-nav">
    <a href="/en/ai-prompts/" class="nav-link">← Back to Directory</a>
  </nav>
</Layout>

<style>
  .company-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .company-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .company-meta {
    display: flex;
    gap: 0.75rem;
    margin-bottom: 1rem;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-block;
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    border: 1px solid rgba(59, 130, 246, 0.2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge.secondary {
    background: rgba(6, 182, 212, 0.1);
    color: #06b6d4;
    border-color: rgba(6, 182, 212, 0.2);
  }

  .company-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #f1f5f9;
  }

  .company-summary {
    font-size: 1.1rem;
    color: #cbd5e1;
    line-height: 1.8;
  }

  .company-content-wrapper {
    display: grid;
    grid-template-columns: 1fr 350px;
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .company-body {
    font-size: 1rem;
    line-height: 1.8;
    color: #cbd5e1;
  }

  .company-body :global(h2) {
    font-size: 1.5rem;
    margin: 1.5rem 0 1rem 0;
    color: #f1f5f9;
  }

  .company-body :global(p) {
    margin-bottom: 1rem;
  }

  .info-card {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .info-card h3 {
    font-size: 1rem;
    margin-bottom: 1rem;
    color: #06b6d4;
  }

  .info-card p {
    font-size: 0.9rem;
    color: #cbd5e1;
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  .info-card p:last-child {
    margin-bottom: 0;
  }

  .info-card strong {
    display: block;
    color: #f1f5f9;
    margin-top: 0.5rem;
    margin-bottom: 0.25rem;
  }

  .info-card a {
    color: #06b6d4;
    word-break: break-all;
  }

  .info-card a:hover {
    color: #3b82f6;
  }

  .company-nav {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .nav-link {
    color: #06b6d4;
    font-weight: 600;
    transition: transform 0.2s ease;
  }

  .nav-link:hover {
    transform: translateX(-4px);
  }

  @media (max-width: 1024px) {
    .company-content-wrapper {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .company-header h1 {
      font-size: 1.75rem;
    }

    .company-summary {
      font-size: 1rem;
    }
  }
</style>
