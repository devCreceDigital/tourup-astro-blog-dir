---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('posts')).sort((a, b) =>
  b.data.pubDate.getTime() - a.data.pubDate.getTime()
);
---

<Layout
  title="Blog - TourUp Content Hub"
  description="Articles and guides about Peru tourism and travel trends."
  currentPath="/blog/"
>
  <div class="blog-header">
    <h1>Blog</h1>
    <p>Artículos y guías sobre turismo en Perú y tendencias de viaje.</p>
  </div>

  <div class="posts-grid">
    {posts.map((post) => (
      <article class="post-card">
        {post.data.heroImage && (
          <img src={post.data.heroImage} alt={post.data.title} class="post-image" />
        )}
        <div class="post-content">
          <time class="post-date">
            {new Date(post.data.pubDate).toLocaleDateString('es-PE', {
              year: 'numeric',
              month: 'long',
              day: 'numeric',
            })}
          </time>
          <h2 class="post-title">
            <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
          </h2>
          <p class="post-description">{post.data.description}</p>
          <div class="post-tags">
            {post.data.tags.map((tag) => (
              <span class="tag">{tag}</span>
            ))}
          </div>
          <a href={`/blog/${post.slug}/`} class="read-more">
            Leer más →
          </a>
        </div>
      </article>
    ))}
  </div>

  {posts.length === 0 && (
    <div class="empty-state">
      <p>No hay publicaciones aún. Vuelve pronto.</p>
    </div>
  )}
</Layout>

<style>
  .blog-header {
    padding: 3rem 0;
    text-align: center;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  .blog-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .blog-header p {
    font-size: 1.1rem;
    color: #cbd5e1;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 2rem;
    margin-bottom: 3rem;
  }

  .post-card {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .post-card:hover {
    border-color: #06b6d4;
    transform: translateY(-5px);
    box-shadow: 0 10px 25px rgba(6, 182, 212, 0.15);
  }

  .post-image {
    width: 100%;
    height: 200px;
    object-fit: cover;
  }

  .post-content {
    padding: 1.5rem;
  }

  .post-date {
    font-size: 0.85rem;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-title {
    font-size: 1.25rem;
    margin: 1rem 0;
  }

  .post-title a {
    color: #f1f5f9;
    transition: color 0.2s ease;
  }

  .post-title a:hover {
    color: #06b6d4;
  }

  .post-description {
    font-size: 0.95rem;
    color: #cbd5e1;
    margin: 1rem 0;
    line-height: 1.7;
  }

  .post-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin: 1rem 0;
  }

  .tag {
    display: inline-block;
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    padding: 0.25rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    border: 1px solid rgba(59, 130, 246, 0.2);
  }

  .read-more {
    display: inline-block;
    color: #06b6d4;
    font-weight: 600;
    margin-top: 1rem;
    transition: transform 0.2s ease;
  }

  .read-more:hover {
    transform: translateX(4px);
  }

  .empty-state {
    text-align: center;
    padding: 3rem 1rem;
    color: #64748b;
  }

  @media (max-width: 768px) {
    .posts-grid {
      grid-template-columns: 1fr;
    }

    .blog-header h1 {
      font-size: 1.75rem;
    }
  }
</style>
