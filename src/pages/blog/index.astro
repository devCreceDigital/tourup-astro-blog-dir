---
import { getCollection } from 'astro:content';
import GuidePage from '../../components/site/GuidePage.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<GuidePage
  title="Peru travel guides | TourUp Guide"
  heading="Guides"
  dek="Longer reads for planning a first trip to Peru."
  description="Guides for planning a trip to Peru: when to go, where to go and practical tips."
  currentPath="/blog/"
  lang="en"
  breadcrumb="Guides"
>
  <ul class="post-list">
    {posts.map((post) => (
      <li>
        <h2><a href={`/blog/${post.slug}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
        <a class="btn-poster" href={`/blog/${post.slug}/`}>Read the guide</a>
      </li>
    ))}
  </ul>
  {posts.length === 0 && <p>No guides yet.</p>}
</GuidePage>

<style>
  .post-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 2px solid var(--ink);
  }

  .post-list li {
    padding-block: var(--space-3);
    border-bottom: 1px solid var(--rule);
  }

  .post-list h2 {
    font-size: 2.1rem;
    margin: 0 0 0.4rem;
  }

  .post-list h2 a {
    color: var(--ink);
    text-decoration: none;
  }

  .post-list h2 a:hover {
    color: var(--link);
  }
</style>
