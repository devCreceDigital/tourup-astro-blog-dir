---
import { getCollection } from 'astro:content';
import GuidePage from '../../components/site/GuidePage.astro';
import { getLocalizedString } from '../../utils/i18n';
import { SITE_URL } from '../../utils/seo';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({ params: { slug: post.slug }, props: { post } }));
}

interface Props {
  post: any;
}

const { post } = Astro.props;
const { Content } = await post.render();

// Los artículos del blog están escritos en inglés.
const lang = 'en' as const;
const pageUrl = `${SITE_URL}/blog/${post.slug}/`;
const postTitle = getLocalizedString(post.data.title, lang);
const postDescription = getLocalizedString(post.data.description, lang);
const updated = post.data.updatedDate ?? post.data.pubDate;

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  '@id': `${pageUrl}#article`,
  headline: postTitle,
  description: postDescription,
  url: pageUrl,
  datePublished: post.data.pubDate,
  ...(post.data.updatedDate ? { dateModified: post.data.updatedDate } : {}),
  author: { '@type': 'Organization', '@id': `${SITE_URL}/#organization` },
  publisher: { '@type': 'Organization', '@id': `${SITE_URL}/#organization` },
  mainEntityOfPage: { '@id': `${pageUrl}#webpage` },
  inLanguage: lang,
  ...(post.data.tags?.length ? { keywords: post.data.tags.join(', ') } : {}),
};
---

<GuidePage
  title={`${postTitle} | TourUp Guide`}
  heading={postTitle}
  dek={postDescription}
  description={postDescription}
  currentPath={`/blog/${post.slug}/`}
  lang={lang}
  breadcrumb={postTitle}
  date={updated?.toISOString?.()}
  photo="peru"
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <p class="post-meta">
    Updated <time datetime={updated?.toISOString?.().slice(0, 10)}>{updated?.toLocaleDateString?.('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
  </p>
  <Content />
  <p><a class="btn-poster" href="/blog/">All guides</a></p>
</GuidePage>

<style>
  .post-meta {
    font-family: var(--font-poster);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-2);
  }
</style>
