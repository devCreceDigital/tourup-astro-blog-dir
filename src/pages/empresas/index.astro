---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const companies = await getCollection('companies');

const grouped = companies.reduce<Record<string, typeof companies>>((acc, c) => {
  const first = (c.data.title || c.id).charAt(0).toUpperCase();
  if (!/[A-Za-z0-9]/.test(first)) {
    acc['#'] = acc['#'] || [];
    acc['#'].push(c);
  } else {
    acc[first] = acc[first] || [];
    acc[first].push(c);
  }
  return acc;
}, {});

const letters = Object.keys(grouped).sort((a, b) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return a.localeCompare(b);
});

const totalDestinos = new Set(companies.flatMap(c => c.data.destinos || [])).size;
---

<Layout
  title="Directorio de Empresas Turísticas en Perú – TourUp"
  description="Directorio completo de {companies.length} prestadores de servicios turísticos en Perú. Encuentra operadores, agencias y DMCs verificados."
  currentPath="/empresas/"
>
  <div class="page-header">
    <h1>Directorio de Empresas <span class="highlight">Turísticas</span></h1>
    <p class="subtitle">
      {companies.length} prestadores de servicios turísticos registrados en Perú
      &middot; {totalDestinos} destinos cubiertos
    </p>
  </div>

  <div class="letter-nav">
    {letters.map(l => (
      <a href={`#letter-${l}`} class="letter-jump">{l}</a>
    ))}
  </div>

  <div class="directory">
    {letters.map(l => (
      <section id={`letter-${l}`} class="letter-section">
        <h2 class="letter-heading">{l} <span class="count">({grouped[l].length})</span></h2>
        <div class="company-grid">
          {grouped[l].map(c => (
            <a href={`/empresas/${c.id}/`} class="company-card">
              <h3 class="company-name">{c.data.title || c.id}</h3>
              {c.data.summary && (
                <p class="company-summary">{c.data.summary}</p>
              )}
              <div class="company-meta">
                {c.data.location?.city && (
                  <span class="tag location">{c.data.location.city}</span>
                )}
                {c.data.distribution_role && (
                  <span class="tag role">{c.data.distribution_role.replace(/_/g, ' ')}</span>
                )}
                {c.data.rating && (
                  <span class="tag rating">★ {c.data.rating}</span>
                )}
              </div>
            </a>
          ))}
        </div>
        <a href="#" class="back-top">↑ Volver arriba</a>
      </section>
    ))}
  </div>
</Layout>

<style>
  .page-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .page-header h1 {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .page-header .highlight {
    background: var(--gradient-main);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .subtitle {
    color: #94a3b8;
    font-size: 1.1rem;
  }

  .letter-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
    padding: 1rem;
    background: rgba(30, 41, 59, 0.5);
    border-radius: 0.75rem;
    border: 1px solid var(--color-border);
    position: sticky;
    top: 80px;
    z-index: 50;
    backdrop-filter: blur(8px);
  }

  .letter-jump {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    font-size: 0.85rem;
    font-weight: 600;
    color: #cbd5e1;
    text-decoration: none;
    border-radius: 0.375rem;
    transition: all 0.2s ease;
  }

  .letter-jump:hover {
    background: rgba(6, 182, 212, 0.15);
    color: #06b6d4;
  }

  .letter-section {
    margin-bottom: 2rem;
    scroll-margin-top: 140px;
  }

  .letter-heading {
    font-size: 1.75rem;
    color: #f1f5f9;
    border-bottom: 2px solid rgba(59, 130, 246, 0.3);
    padding-bottom: 0.5rem;
    margin-bottom: 1rem;
  }

  .letter-heading .count {
    font-size: 1rem;
    color: #64748b;
    font-weight: 400;
  }

  .company-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
    gap: 1rem;
  }

  .company-card {
    display: block;
    background: rgba(30, 41, 59, 0.4);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.25rem;
    text-decoration: none;
    transition: all 0.25s ease;
  }

  .company-card:hover {
    border-color: #06b6d4;
    background: rgba(30, 41, 59, 0.8);
    transform: translateY(-2px);
  }

  .company-name {
    font-size: 1rem;
    color: #f1f5f9;
    margin-bottom: 0.5rem;
    font-weight: 600;
  }

  .company-summary {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 0.75rem;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .company-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-weight: 500;
  }

  .tag.location {
    background: rgba(59, 130, 246, 0.15);
    color: #60a5fa;
  }

  .tag.role {
    background: rgba(6, 182, 212, 0.15);
    color: #22d3ee;
    text-transform: capitalize;
  }

  .tag.rating {
    background: rgba(251, 191, 36, 0.15);
    color: #fbbf24;
  }

  .back-top {
    display: inline-block;
    margin-top: 1rem;
    font-size: 0.85rem;
    color: #64748b;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .back-top:hover {
    color: #06b6d4;
  }

  @media (max-width: 768px) {
    .page-header h1 {
      font-size: 1.75rem;
    }

    .company-grid {
      grid-template-columns: 1fr;
    }

    .letter-nav {
      gap: 0.25rem;
      padding: 0.75rem;
      top: 60px;
    }

    .letter-jump {
      width: 1.75rem;
      height: 1.75rem;
      font-size: 0.75rem;
    }
  }
</style>
