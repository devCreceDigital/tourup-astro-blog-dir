---
/**
 * Journey 4 – Ficha de Confianza B2B
 *
 * URL pattern: /empresas/[slug]/
 *
 * Designed for AI Answer Engine Optimization (AEO):
 *   - Answer-first summary (BLUF) in the intro
 *   - Consistent NAP data for LocalBusiness / TravelAgency JSON-LD
 *   - AggregateRating when rating + reviews_count are present
 *   - FAQPage JSON-LD for trust-related questions
 *
 * Agents (GraphNavigator, AEOAuditor) should read this page structure
 * before querying individual fields from the content collection.
 */
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const companies = await getCollection('companies');
  return companies.map((company) => {
    const slug = company.slug.replace(/^\/company\//, '');
    return {
      params: { slug },
      props: { company, slug },
    };
  });
}

interface Props {
  company: Awaited<ReturnType<typeof getCollection<'companies'>>>[number];
}

const { company, slug } = Astro.props;
const { Content } = await company.render();
const d = company.data;

// ── JSON-LD construction ──────────────────────────────────────────────────────
const siteUrl = 'https://tourup.co';
const pageUrl = `${siteUrl}/empresas/${slug}/`;

// Resolve NAP from `nap` field, falling back to legacy `contact`/`location` fields.
const napPhone = d.nap?.phone ?? d.contact?.phone;
const napEmail = d.nap?.email ?? d.contact?.email;
const napWebsite = d.nap?.website ?? d.contact?.website;
const napCity = d.nap?.city ?? d.location?.city;
const napAddress = d.nap?.address;
const napCountry = d.nap?.country ?? d.location?.country ?? 'Peru';

const jsonLd: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': ['TravelAgency', 'LocalBusiness'],
      '@id': pageUrl,
      name: d.title,
      description: d.summary,
      url: napWebsite ?? pageUrl,
      ...(napPhone ? { telephone: napPhone } : {}),
      ...(napEmail ? { email: napEmail } : {}),
      address: {
        '@type': 'PostalAddress',
        ...(napAddress ? { streetAddress: napAddress } : {}),
        addressLocality: napCity,
        addressCountry: napCountry,
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': pageUrl,
      },
      ...(d.rating && d.reviews_count
        ? {
            aggregateRating: {
              '@type': 'AggregateRating',
              ratingValue: d.rating,
              reviewCount: d.reviews_count,
              bestRating: 5,
              worstRating: 1,
            },
          }
        : {}),
    },
    ...(d.faq?.length
      ? [
          {
            '@type': 'FAQPage',
            mainEntity: d.faq.map((item) => ({
              '@type': 'Question',
              name: item.question,
              acceptedAnswer: {
                '@type': 'Answer',
                text: item.answer,
              },
            })),
          },
        ]
      : []),
  ],
};

// ── Star rating helper ────────────────────────────────────────────────────────
function stars(rating: number): string {
  const full = Math.floor(rating);
  const half = rating % 1 >= 0.5;
  return '★'.repeat(full) + (half ? '½' : '') + '☆'.repeat(5 - full - (half ? 1 : 0));
}
---

<Layout
  title={`${d.title} – Ficha de Confianza B2B | TourUp`}
  description={d.summary}
  currentPath={`/empresas/${slug}/`}
>
  <!-- JSON-LD: TravelAgency + AggregateRating + FAQPage -->
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />

  <article class="trust-card" itemscope itemtype="https://schema.org/TravelAgency">

    <!-- ── Header ─────────────────────────────────────────────────────────── -->
    <header class="tc-header">
      <div class="tc-badges">
        <span class="badge role">{d.distribution_role.replace(/_/g, ' ')}</span>
        {d.sales_channel && <span class="badge channel">{d.sales_channel}</span>}
        {d.destinos?.map((dest) => (
          <span class="badge destino">{dest}</span>
        ))}
      </div>

      <h1 itemprop="name">{d.title}</h1>

      <!-- BLUF: answer-first summary for AEO -->
      <p class="bluf" itemprop="description">{d.summary}</p>

      <!-- Rating row -->
      {d.rating && d.reviews_count && (
        <div class="rating-row" itemprop="aggregateRating" itemscope itemtype="https://schema.org/AggregateRating">
          <span class="stars">{stars(d.rating)}</span>
          <strong itemprop="ratingValue">{d.rating}</strong>
          <span class="reviews-count">/ 5 &ndash; <span itemprop="reviewCount">{d.reviews_count}</span> reseñas verificadas</span>
        </div>
      )}
    </header>

    <!-- ── Trust Score Panel ───────────────────────────────────────────────── -->
    <div class="tc-grid">

      <!-- Main content area -->
      <section class="tc-main">

        <!-- B2B Performance -->
        {d.trust_metrics && (
          <div class="trust-section">
            <h2>Desempeño B2B</h2>
            <div class="kpi-grid">
              {d.trust_metrics.avg_response_time_hours !== undefined && (
                <div class="kpi">
                  <span class="kpi-value">{d.trust_metrics.avg_response_time_hours}h</span>
                  <span class="kpi-label">Tiempo de respuesta</span>
                </div>
              )}
              {d.trust_metrics.incident_rate !== undefined && (
                <div class="kpi">
                  <span class="kpi-value">{(d.trust_metrics.incident_rate * 100).toFixed(1)}%</span>
                  <span class="kpi-label">Tasa de incidencias</span>
                </div>
              )}
              {d.trust_metrics.group_capacity_max !== undefined && (
                <div class="kpi">
                  <span class="kpi-value">{d.trust_metrics.group_capacity_max} pax</span>
                  <span class="kpi-label">Capacidad máx. grupo</span>
                </div>
              )}
              {d.trust_metrics.languages?.length && (
                <div class="kpi">
                  <span class="kpi-value">{d.trust_metrics.languages.join(' · ').toUpperCase()}</span>
                  <span class="kpi-label">Idiomas de operación</span>
                </div>
              )}
            </div>
            {d.trust_metrics.b2b_client_types?.length && (
              <div class="client-types">
                <span class="label-sm">Clientes B2B habituales:</span>
                {d.trust_metrics.b2b_client_types.map((t: string) => (
                  <span class="tag">{t.replace(/_/g, ' ')}</span>
                ))}
              </div>
            )}
          </div>
        )}

        <!-- B2B Profile (positioning) -->
        {d.b2b_profile && (
          <div class="trust-section">
            <h2>Perfil B2B</h2>
            <p class="b2b-profile">{d.b2b_profile}</p>
          </div>
        )}

        <!-- Testimonials -->
        {d.testimonials?.length && (
          <div class="trust-section">
            <h2>Testimonios verificados</h2>
            <div class="testimonials">
              {d.testimonials.slice(0, 3).map((t) => (
                <blockquote class="testimonial">
                  <p>"{t.text}"</p>
                  <footer>
                    <strong>{t.author}</strong>
                    {t.source && <span class="source"> &ndash; {t.source}</span>}
                    {t.date && <span class="date"> ({t.date})</span>}
                  </footer>
                </blockquote>
              ))}
            </div>
          </div>
        )}

        <!-- FAQs -->
        {d.faq?.length && (
          <div class="trust-section faq-section">
            <h2>Preguntas frecuentes de confianza</h2>
            <dl class="faq-list">
              {d.faq.map((item) => (
                <div class="faq-item">
                  <dt>{item.question}</dt>
                  <dd>{item.answer}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        <!-- Markdown body (additional content) -->
        <div class="tc-body">
          <Content />
        </div>
      </section>

      <!-- Sidebar: licenses, NAP, categories -->
      <aside class="tc-sidebar">

        <!-- License badges -->
        {d.licenses?.length && (
          <div class="sidebar-card">
            <h3>Certificaciones y registros</h3>
            {d.licenses.map((lic) => (
              <div class="license-badge">
                <span class="lic-type">{lic.type}</span>
                <span class="lic-id">{lic.id}</span>
                {lic.issuer && <span class="lic-issuer">{lic.issuer}</span>}
              </div>
            ))}
          </div>
        )}

        <!-- Legacy regulation fallback -->
        {!d.licenses?.length && d.regulation && (
          <div class="sidebar-card">
            <h3>Información regulatoria</h3>
            {d.regulation.tax_id && <p><strong>RUC:</strong> {d.regulation.tax_id}</p>}
            {d.regulation.license_number && <p><strong>Licencia:</strong> {d.regulation.license_number}</p>}
            {d.regulation.license_issue_date && <p><strong>Fecha emisión:</strong> {d.regulation.license_issue_date}</p>}
          </div>
        )}

        <!-- NAP / Contact -->
        <div class="sidebar-card" itemprop="address" itemscope itemtype="https://schema.org/PostalAddress">
          <h3>Contacto</h3>
          {napAddress && <p itemprop="streetAddress">{napAddress}</p>}
          {napCity && <p><span itemprop="addressLocality">{napCity}</span>, <span itemprop="addressCountry">{napCountry}</span></p>}
          {napPhone && (
            <p>
              <strong>Tel:</strong>
              <a href={`tel:${napPhone}`} itemprop="telephone">{napPhone}</a>
            </p>
          )}
          {napEmail && (
            <p>
              <strong>Email:</strong>
              <a href={`mailto:${napEmail}`} itemprop="email">{napEmail}</a>
            </p>
          )}
          {napWebsite && (
            <p>
              <a href={napWebsite} target="_blank" rel="noopener noreferrer" itemprop="url">
                Visitar sitio web →
              </a>
            </p>
          )}
        </div>

        <!-- Categorias / Destinos -->
        {(d.destinos?.length || d.categorias?.length) && (
          <div class="sidebar-card">
            <h3>Destinos y categorías</h3>
            {d.destinos?.length && (
              <div class="tag-group">
                <span class="label-sm">Destinos</span>
                <div class="tag-wrap">
                  {d.destinos.map((dest) => (
                    <span class="tag destino">{dest}</span>
                  ))}
                </div>
              </div>
            )}
            {d.categorias?.length && (
              <div class="tag-group">
                <span class="label-sm">Categorías</span>
                <div class="tag-wrap">
                  {d.categorias.map((cat) => (
                    <span class="tag">{cat.replace(/-/g, ' ')}</span>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}

        <!-- Partner Scout CTA -->
        <div class="sidebar-card cta-card">
          <h3>¿Buscas más proveedores?</h3>
          <p>Usa Partner Scout para encontrar operadores similares por destino, categoría y rating.</p>
          <a href="/partner-scout/" class="btn-cta">Abrir Partner Scout</a>
        </div>
      </aside>
    </div>

    <!-- Back nav -->
    <nav class="tc-nav">
      <a href="/partner-scout/" class="nav-link">← Partner Scout</a>
      <a href="/en/ai-prompts/" class="nav-link">Directorio de prompts</a>
    </nav>
  </article>
</Layout>

<style>
  .trust-card {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem 0 4rem;
  }

  /* ── Header ─────────────────────────────────────────────────────────────── */
  .tc-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
    margin-bottom: 2.5rem;
  }

  .tc-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .badge {
    display: inline-block;
    padding: 0.3rem 0.8rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-weight: 600;
  }

  .badge.role {
    background: rgba(59, 130, 246, 0.12);
    color: #60a5fa;
    border: 1px solid rgba(59, 130, 246, 0.25);
  }

  .badge.channel {
    background: rgba(6, 182, 212, 0.1);
    color: #06b6d4;
    border: 1px solid rgba(6, 182, 212, 0.2);
  }

  .badge.destino {
    background: rgba(34, 197, 94, 0.1);
    color: #4ade80;
    border: 1px solid rgba(34, 197, 94, 0.2);
  }

  .tc-header h1 {
    font-size: 2.25rem;
    color: #f1f5f9;
    margin-bottom: 0.75rem;
  }

  .bluf {
    font-size: 1.1rem;
    color: #cbd5e1;
    line-height: 1.7;
    max-width: 700px;
    margin-bottom: 1.25rem;
  }

  .rating-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
  }

  .stars {
    font-size: 1.3rem;
    color: #fbbf24;
    letter-spacing: 0.05em;
  }

  .rating-row strong {
    font-size: 1.25rem;
    color: #f1f5f9;
  }

  .reviews-count {
    color: #94a3b8;
    font-size: 0.9rem;
  }

  /* ── Grid ────────────────────────────────────────────────────────────────── */
  .tc-grid {
    display: grid;
    grid-template-columns: 1fr 300px;
    gap: 2rem;
    align-items: start;
  }

  /* ── Sections ────────────────────────────────────────────────────────────── */
  .trust-section {
    margin-bottom: 2.5rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .trust-section h2 {
    font-size: 1.25rem;
    color: #f1f5f9;
    margin-bottom: 1.25rem;
  }

  /* ── KPI grid ────────────────────────────────────────────────────────────── */
  .kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .kpi {
    background: rgba(30, 41, 59, 0.6);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem;
    text-align: center;
  }

  .kpi-value {
    display: block;
    font-size: 1.5rem;
    font-weight: 700;
    color: #06b6d4;
    margin-bottom: 0.25rem;
  }

  .kpi-label {
    font-size: 0.8rem;
    color: #94a3b8;
  }

  /* ── Tags ────────────────────────────────────────────────────────────────── */
  .client-types,
  .tag-group {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  .tag-wrap {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .label-sm {
    font-size: 0.8rem;
    color: #64748b;
    white-space: nowrap;
  }

  .tag {
    display: inline-block;
    background: rgba(71, 85, 105, 0.2);
    color: #94a3b8;
    border: 1px solid rgba(71, 85, 105, 0.3);
    padding: 0.2rem 0.65rem;
    border-radius: 9999px;
    font-size: 0.78rem;
    text-transform: capitalize;
  }

  .tag.destino {
    background: rgba(34, 197, 94, 0.08);
    color: #4ade80;
    border-color: rgba(34, 197, 94, 0.2);
  }

  /* ── B2B profile ─────────────────────────────────────────────────────────── */
  .b2b-profile {
    color: #cbd5e1;
    font-size: 0.95rem;
    line-height: 1.7;
  }

  /* ── Testimonials ────────────────────────────────────────────────────────── */
  .testimonials {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .testimonial {
    background: rgba(30, 41, 59, 0.4);
    border-left: 3px solid #06b6d4;
    border-radius: 0 0.5rem 0.5rem 0;
    padding: 1rem 1.25rem;
    margin: 0;
  }

  .testimonial p {
    color: #cbd5e1;
    font-style: italic;
    margin-bottom: 0.5rem;
    font-size: 0.95rem;
  }

  .testimonial footer {
    font-size: 0.85rem;
    color: #64748b;
  }

  .testimonial footer strong {
    color: #94a3b8;
  }

  /* ── FAQ ─────────────────────────────────────────────────────────────────── */
  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .faq-item dt {
    font-weight: 600;
    color: #f1f5f9;
    margin-bottom: 0.4rem;
    font-size: 0.95rem;
  }

  .faq-item dd {
    color: #cbd5e1;
    font-size: 0.9rem;
    line-height: 1.7;
    margin: 0;
    padding-left: 1rem;
    border-left: 2px solid rgba(6, 182, 212, 0.3);
  }

  /* ── Markdown body ───────────────────────────────────────────────────────── */
  .tc-body {
    color: #cbd5e1;
    line-height: 1.8;
    font-size: 0.95rem;
  }

  .tc-body :global(h2) {
    font-size: 1.2rem;
    color: #f1f5f9;
    margin: 2rem 0 0.75rem;
  }

  .tc-body :global(strong) {
    color: #f1f5f9;
  }

  /* ── Sidebar cards ───────────────────────────────────────────────────────── */
  .sidebar-card {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.25rem;
    margin-bottom: 1.25rem;
  }

  .sidebar-card h3 {
    font-size: 0.9rem;
    color: #06b6d4;
    margin-bottom: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sidebar-card p {
    font-size: 0.85rem;
    color: #94a3b8;
    margin-bottom: 0.5rem;
    line-height: 1.6;
  }

  .sidebar-card a {
    color: #06b6d4;
  }

  .sidebar-card a:hover {
    color: #3b82f6;
  }

  /* ── Licenses ────────────────────────────────────────────────────────────── */
  .license-badge {
    background: rgba(34, 197, 94, 0.06);
    border: 1px solid rgba(34, 197, 94, 0.15);
    border-radius: 0.5rem;
    padding: 0.6rem 0.75rem;
    margin-bottom: 0.6rem;
  }

  .lic-type {
    display: block;
    font-size: 0.75rem;
    color: #4ade80;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.15rem;
  }

  .lic-id {
    display: block;
    font-size: 0.9rem;
    color: #f1f5f9;
    font-family: monospace;
  }

  .lic-issuer {
    display: block;
    font-size: 0.78rem;
    color: #64748b;
    margin-top: 0.15rem;
  }

  /* ── CTA card ────────────────────────────────────────────────────────────── */
  .cta-card {
    background: linear-gradient(135deg, rgba(59, 130, 246, 0.08), rgba(6, 182, 212, 0.08));
    border-color: rgba(6, 182, 212, 0.2);
  }

  .btn-cta {
    display: block;
    margin-top: 0.75rem;
    padding: 0.65rem 1rem;
    background: var(--gradient-main);
    color: white !important;
    border-radius: 0.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    text-align: center;
    transition: opacity 0.2s ease;
  }

  .btn-cta:hover {
    opacity: 0.9;
  }

  /* ── Back nav ────────────────────────────────────────────────────────────── */
  .tc-nav {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    color: #06b6d4;
    font-size: 0.9rem;
    font-weight: 600;
  }

  /* ── Responsive ──────────────────────────────────────────────────────────── */
  @media (max-width: 1024px) {
    .tc-grid {
      grid-template-columns: 1fr;
    }
    .tc-sidebar {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 1rem;
    }
  }

  @media (max-width: 768px) {
    .tc-header h1 {
      font-size: 1.75rem;
    }
    .kpi-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
