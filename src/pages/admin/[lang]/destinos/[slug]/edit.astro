---
export const prerender = false;
import AdminLayout from '../../../../../components/admin/Layout.astro';
import { readEntry } from '../../../../../utils/content';

const { lang, slug } = Astro.params as { lang: string; slug: string };
const t = (es: string, en: string) => lang === 'en' ? en : es;

function getCollection(l: string): string {
  return l === 'en' ? 'destinos_en' : 'destinos';
}

let entry: Record<string, unknown> = {};
try {
  const parsed = await readEntry(getCollection(lang), slug);
  entry = { slug, ...parsed.data, body: parsed.content };
} catch {
  return Astro.redirect('/admin/' + lang + '/destinos');
}
---

<AdminLayout title={t('Editar destino', 'Edit destino')}>
  <div class="page-header">
    <div>
      <h1>{t('Editar destino', 'Edit destino')}</h1>
      <p class="subtitle">{entry.name as string}</p>
    </div>
    <a href={'/admin/' + lang + '/destinos'} class="btn-secondary">{t('Volver', 'Back')}</a>
  </div>

  <form id="destino-form" class="form-card">
    <div class="form-section">
      <h2>{t('Información básica', 'Basic information')}</h2>
      <div class="form-grid">
        <div class="field">
          <label>{t('Nombre', 'Name')} *</label>
          <input name="name" value={entry.name as string} required />
        </div>
        <div class="field">
          <label>{t('País', 'Country')}</label>
          <input name="country" value={(entry.country as string) ?? 'Peru'} />
        </div>
        <div class="field">
          <label>{t('Región', 'Region')}</label>
          <input name="region" value={(entry.region as string) ?? ''} />
        </div>
        <div class="field">
          <label>{t('Parent', 'Parent')}</label>
          <input name="parent" value={(entry.parent as string) ?? 'peru'} />
        </div>
        <div class="field">
          <label>{t('SEO Title', 'SEO title')}</label>
          <input name="seo_title" value={(entry.seo_title as string) ?? ''} />
        </div>
      </div>
    </div>

    <div class="form-section">
      <h2>{t('Contenido SEO', 'SEO content')}</h2>
      <div class="field">
        <label>{t('Resumen', 'Summary')} *</label>
        <textarea name="summary" rows="3" minlength="50" maxlength="300" required>{(entry.summary as string) ?? ''}</textarea>
      </div>
      <div class="field">
        <label>{t('Respuesta canónica', 'Canonical answer')} *</label>
        <textarea name="canonical_answer" rows="3" minlength="30" maxlength="500" required>{(entry.canonical_answer as string) ?? ''}</textarea>
      </div>
      <div class="field">
        <label>{t('Intención LLM', 'LLM intent')}</label>
        <input name="llm_intent" value={(entry.llm_intent as string) ?? ''} />
      </div>
    </div>

    <div class="form-section">
      <h2>{t('FAQ', 'FAQ')}</h2>
      <div id="faq-container">
        {(entry.faq as any[])?.map((faq, i) => (
          <div class="faq-row">
            <input name={'faq.' + i + '.question'} value={faq.question} placeholder={t('Pregunta', 'Question')} />
            <input name={'faq.' + i + '.answer'} value={faq.answer} placeholder={t('Respuesta', 'Answer')} />
          </div>
        ))}
      </div>
      <button type="button" id="add-faq" class="btn-secondary btn-sm">{t('+ Añadir FAQ', '+ Add FAQ')}</button>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary">{t('Guardar cambios', 'Save changes')}</button>
    </div>
  </form>
</AdminLayout>

<script>
  let faqCount = document.querySelectorAll('.faq-row').length;

  document.getElementById('add-faq')?.addEventListener('click', () => {
    const container = document.getElementById('faq-container');
    const row = document.createElement('div');
    row.className = 'faq-row';
    row.innerHTML = `
      <input name="faq.${faqCount}.question" placeholder="Question" />
      <input name="faq.${faqCount}.answer" placeholder="Answer" />
    `;
    container.appendChild(row);
    faqCount++;
  });

  document.getElementById('destino-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const fd = new FormData(form);

    const faq = [];
    let i = 0;
    while (fd.has(`faq.${i}.question`)) {
      const q = fd.get(`faq.${i}.question`);
      const a = fd.get(`faq.${i}.answer`);
      if (q || a) faq.push({ question: q, answer: a });
      i++;
    }

    const body = {
      name: fd.get('name'),
      country: fd.get('country') || 'Peru',
      region: fd.get('region') || undefined,
      parent: fd.get('parent') || 'peru',
      seo_title: fd.get('seo_title') || undefined,
      summary: fd.get('summary'),
      canonical_answer: fd.get('canonical_answer'),
      llm_intent: fd.get('llm_intent') || undefined,
      faq: faq.length ? faq : undefined,
    };

    const parts = window.location.pathname.split('/');
    const lang = parts[2];
    const slug = parts[4];

    const res = await fetch(`/api/admin/${lang}/destinos/${slug}/`, {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    if (res.ok) {
      window.location.href = `/admin/${lang}/destinos`;
    } else {
      const data = await res.json();
      if (data.errors) {
        alert(data.errors.map((e) => `${e.field}: ${e.message}`).join('\n'));
      } else {
        alert(data.error || 'Error');
      }
    }
  });
</script>

<style>
  .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
  .page-header h1 { font-size: 24px; font-weight: 700; color: #000000; margin-bottom: 4px; }
  .subtitle { font-size: 14px; color: #737373; }
  .btn-primary {
    display: inline-flex; align-items: center; padding: 10px 20px;
    background: #000000; color: #ffffff; border-radius: 10px;
    font-size: 14px; font-weight: 600; text-decoration: none; border: none; cursor: pointer;
  }
  .btn-primary:hover { opacity: 0.85; }
  .btn-secondary {
    display: inline-flex; align-items: center; padding: 10px 20px;
    background: #ffffff; color: #444748; border: 1px solid #e5e5e5; border-radius: 10px;
    font-size: 14px; font-weight: 500; text-decoration: none; cursor: pointer;
  }
  .btn-secondary:hover { background: #f2f2f2; }
  .btn-sm { padding: 6px 14px; font-size: 12px; margin-top: 8px; }
  .form-card {
    background: #ffffff; border: 1px solid #e5e5e5; border-radius: 14px;
    padding: 32px; max-width: 800px;
  }
  .form-section { margin-bottom: 32px; }
  .form-section h2 { font-size: 16px; font-weight: 600; color: #000000; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid #e5e5e5; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field label { font-size: 12px; font-weight: 600; color: #444748; text-transform: uppercase; letter-spacing: 0.3px; }
  .field input, .field select, .field textarea {
    padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 10px;
    font-size: 14px; font-family: 'Geist', sans-serif; outline: none; background: #f9f9f9;
  }
  .field input:focus, .field select:focus, .field textarea:focus { border-color: #000000; background: #ffffff; }
  .field textarea { resize: vertical; min-height: 80px; }
  .faq-row { display: flex; gap: 8px; margin-bottom: 8px; }
  .faq-row input { flex: 1; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 10px; font-size: 14px; font-family: 'Geist', sans-serif; outline: none; background: #f9f9f9; }
  .faq-row input:focus { border-color: #000000; background: #ffffff; }
  .form-actions { margin-top: 24px; }
</style>
