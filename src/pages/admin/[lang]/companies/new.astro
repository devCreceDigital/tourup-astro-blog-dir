---
export const prerender = false;
import AdminLayout from '../../../../components/admin/Layout.astro';

const { lang } = Astro.params as { lang: string };
const t = (es: string, en: string) => lang === 'en' ? en : es;
---

<AdminLayout title={t('Nueva empresa', 'New company')}>
  <div class="page-header">
    <div>
      <h1>{t('Nueva empresa', 'New company')}</h1>
      <p class="subtitle">{t('Completa los datos para crear una empresa', 'Fill in the details to create a company')}</p>
    </div>
    <a href={`/admin/${lang}/companies`} class="btn-secondary">{t('Volver', 'Back')}</a>
  </div>

  <form id="company-form" class="form-card">
    <div class="form-section">
      <h2>{t('Información básica', 'Basic information')}</h2>
      <div class="form-grid">
        <div class="field">
          <label>{t('Título', 'Title')} *</label>
          <input name="title" required />
        </div>
        <div class="field">
          <label>{t('Rol de distribución', 'Distribution role')} *</label>
          <select name="distribution_role" required>
            <option value="tour_operator">{t('Operador turístico', 'Tour operator')}</option>
            <option value="retail_travel_agency">{t('Agencia minorista', 'Retail travel agency')}</option>
            <option value="dmc">DMC</option>
            <option value="wholesaler">{t('Mayorista', 'Wholesaler')}</option>
            <option value="other">{t('Otro', 'Other')}</option>
          </select>
        </div>
        <div class="field">
          <label>{t('Canal de venta', 'Sales channel')} *</label>
          <select name="sales_channel" required>
            <option value="online">Online</option>
            <option value="offline">Offline</option>
            <option value="omnichannel">Omnichannel</option>
          </select>
        </div>
        <div class="field">
          <label>{t('Rating', 'Rating')}</label>
          <input name="rating" type="number" min="0" max="5" step="0.1" />
        </div>
        <div class="field">
          <label>{t('Reviews', 'Reviews count')}</label>
          <input name="reviews_count" type="number" min="0" />
        </div>
        <div class="field">
          <label>{t('B2B Profile', 'B2B profile')}</label>
          <input name="b2b_profile" />
        </div>
      </div>
    </div>

    <div class="form-section">
      <h2>{t('Destinos y categorías', 'Destinos & categories')}</h2>
      <div class="field">
        <label>{t('Destinos (slugs separados por coma)', 'Destinos (comma-separated slugs)')} *</label>
        <input name="destinos" placeholder="cusco, lima, arequipa" required />
      </div>
      <div class="field">
        <label>{t('Categorías (separadas por coma)', 'Categories (comma-separated)')}</label>
        <input name="categorias" placeholder="gastronomia, cultura" />
      </div>
    </div>

    <div class="form-section">
      <h2>{t('Contacto y ubicación', 'Contact & location')}</h2>
      <div class="form-grid">
        <div class="field">
          <label>{t('Ciudad', 'City')}</label>
          <input name="nap.city" />
        </div>
        <div class="field">
          <label>{t('País', 'Country')}</label>
          <input name="nap.country" />
        </div>
        <div class="field">
          <label>{t('Teléfono', 'Phone')}</label>
          <input name="nap.phone" type="tel" />
        </div>
        <div class="field">
          <label>Email</label>
          <input name="nap.email" type="email" />
        </div>
        <div class="field">
          <label>{t('Sitio web', 'Website')}</label>
          <input name="contact.website" type="url" />
        </div>
      </div>
    </div>

    <div class="form-section">
      <h2>{t('Contenido SEO', 'SEO content')}</h2>
      <div class="field">
        <label>{t('Resumen', 'Summary')} *</label>
        <textarea name="summary" rows="3" minlength="50" maxlength="300" required></textarea>
      </div>
      <div class="field">
        <label>{t('Respuesta canónica', 'Canonical answer')} *</label>
        <textarea name="canonical_answer" rows="3" minlength="30" maxlength="500" required></textarea>
      </div>
      <div class="field">
        <label>{t('Intención LLM', 'LLM intent')}</label>
        <input name="llm_intent" />
      </div>
    </div>

    <div class="form-section">
      <h2>{t('FAQ', 'FAQ')}</h2>
      <div id="faq-container">
        <div class="faq-row">
          <input name="faq.0.question" placeholder={t('Pregunta', 'Question')} />
          <input name="faq.0.answer" placeholder={t('Respuesta', 'Answer')} />
        </div>
      </div>
      <button type="button" id="add-faq" class="btn-secondary btn-sm">{t('+ Añadir FAQ', '+ Add FAQ')}</button>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary">{t('Crear empresa', 'Create company')}</button>
    </div>
  </form>
</AdminLayout>

<script>
  let faqCount = 1;
  document.getElementById('add-faq')?.addEventListener('click', () => {
    const container = document.getElementById('faq-container');
    const row = document.createElement('div');
    row.className = 'faq-row';
    row.innerHTML = `
      <input name="faq.${faqCount}.question" placeholder="Question" />
      <input name="faq.${faqCount}.answer" placeholder="Answer" />
    `;
    container.appendChild(row);
    faqCount++;
  });

  document.getElementById('company-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const fd = new FormData(form);

    const destinos = (fd.get('destinos') || '').split(',').map(s => s.trim()).filter(Boolean);
    const categorias = (fd.get('categorias') || '').split(',').map(s => s.trim()).filter(Boolean);

    const faq = [];
    let i = 0;
    while (fd.has(`faq.${i}.question`)) {
      const q = fd.get(`faq.${i}.question`);
      const a = fd.get(`faq.${i}.answer`);
      if (q || a) faq.push({ question: q, answer: a });
      i++;
    }

    const nap = {};
    if (fd.get('nap.city')) nap.city = fd.get('nap.city');
    if (fd.get('nap.country')) nap.country = fd.get('nap.country');
    if (fd.get('nap.phone')) nap.phone = fd.get('nap.phone');
    if (fd.get('nap.email')) nap.email = fd.get('nap.email');

    const contact = {};
    if (fd.get('contact.website')) contact.website = fd.get('contact.website');

    const body = {
      type: 'company',
      title: fd.get('title'),
      distribution_role: fd.get('distribution_role'),
      sales_channel: fd.get('sales_channel'),
      destinos,
      categorias,
      rating: fd.get('rating') ? parseFloat(fd.get('rating')) : undefined,
      reviews_count: fd.get('reviews_count') ? parseInt(fd.get('reviews_count'), 10) : undefined,
      b2b_profile: fd.get('b2b_profile') || undefined,
      summary: fd.get('summary'),
      canonical_answer: fd.get('canonical_answer'),
      llm_intent: fd.get('llm_intent') || undefined,
      faq: faq.length ? faq : undefined,
      nap: Object.keys(nap).length ? nap : undefined,
      contact: Object.keys(contact).length ? contact : undefined,
    };

    const lang = window.location.pathname.split('/')[2];
    const res = await fetch(`/api/admin/${lang}/companies/`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    if (res.ok) {
      window.location.href = `/admin/${lang}/companies`;
    } else {
      const data = await res.json();
      alert(data.errors ? data.errors.map((e) => `${e.field}: ${e.message}`).join('\n') : 'Error');
    }
  });
</script>

<style>
  .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
  .page-header h1 { font-size: 24px; font-weight: 700; color: #000000; margin-bottom: 4px; }
  .subtitle { font-size: 14px; color: #737373; }
  .btn-primary {
    display: inline-flex; align-items: center; padding: 10px 20px;
    background: #000000; color: #ffffff; border-radius: 10px;
    font-size: 14px; font-weight: 600; text-decoration: none; border: none; cursor: pointer;
  }
  .btn-primary:hover { opacity: 0.85; }
  .btn-secondary {
    display: inline-flex; align-items: center; padding: 10px 20px;
    background: #ffffff; color: #444748; border: 1px solid #e5e5e5; border-radius: 10px;
    font-size: 14px; font-weight: 500; text-decoration: none; cursor: pointer;
  }
  .btn-secondary:hover { background: #f2f2f2; }
  .btn-sm { padding: 6px 14px; font-size: 12px; margin-top: 8px; }
  .form-card {
    background: #ffffff; border: 1px solid #e5e5e5; border-radius: 14px;
    padding: 32px; max-width: 800px;
  }
  .form-section { margin-bottom: 32px; }
  .form-section h2 { font-size: 16px; font-weight: 600; color: #000000; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid #e5e5e5; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field label { font-size: 12px; font-weight: 600; color: #444748; text-transform: uppercase; letter-spacing: 0.3px; }
  .field input, .field select, .field textarea {
    padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 10px;
    font-size: 14px; font-family: 'Geist', sans-serif; outline: none; background: #f9f9f9;
  }
  .field input:focus, .field select:focus, .field textarea:focus { border-color: #000000; background: #ffffff; }
  .field textarea { resize: vertical; min-height: 80px; }
  .faq-row { display: flex; gap: 8px; margin-bottom: 8px; }
  .faq-row input { flex: 1; padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 10px; font-size: 14px; font-family: 'Geist', sans-serif; outline: none; background: #f9f9f9; }
  .faq-row input:focus { border-color: #000000; background: #ffffff; }
  .form-actions { margin-top: 24px; }
</style>
