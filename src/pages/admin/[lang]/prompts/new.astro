---
export const prerender = false;
import AdminLayout from '../../../../components/admin/Layout.astro';

const { lang } = Astro.params as { lang: string };
const t = (es: string, en: string) => lang === 'en' ? en : es;
---

<AdminLayout title={t('Nuevo prompt', 'New prompt')}>
  <div class="page-header">
    <div>
      <h1>{t('Nuevo prompt', 'New prompt')}</h1>
      <p class="subtitle">{t('Completa los datos para crear un prompt', 'Fill in the details to create a prompt')}</p>
    </div>
    <a href={`/admin/${lang}/prompts`} class="btn-secondary">{t('Volver', 'Back')}</a>
  </div>

  <form id="prompt-form" class="form-card">
    <div class="form-section">
      <h2>{t('Información básica', 'Basic information')}</h2>
      <div class="form-grid">
        <div class="field">
          <label>{t('Título', 'Title')} *</label>
          <input name="title" required />
        </div>
        <div class="field">
          <label>{t('Término de búsqueda', 'Search term')}</label>
          <input name="search_term" />
        </div>
        <div class="field">
          <label>{t('Intención primaria', 'Primary intent')} *</label>
          <select name="primary_intent" required>
            <option value="commercial">Commercial</option>
            <option value="informational">Informational</option>
            <option value="navigational">Navigational</option>
            <option value="transactional">Transactional</option>
          </select>
        </div>
        <div class="field">
          <label>{t('Intención secundaria', 'Secondary intent')}</label>
          <input name="secondary_intent" />
        </div>
        <div class="field">
          <label>{t('Cluster de destino', 'Destination cluster')}</label>
          <input name="destination_cluster" />
        </div>
        <div class="field">
          <label>{t('Cluster de categoría', 'Category cluster')}</label>
          <input name="category_cluster" />
        </div>
      </div>
    </div>

    <div class="form-section">
      <h2>{t('Plataformas AI', 'AI platforms')}</h2>
      <div class="checkbox-group">
        <label><input type="checkbox" name="ai_platforms" value="ChatGPT" /> ChatGPT</label>
        <label><input type="checkbox" name="ai_platforms" value="Gemini" /> Gemini</label>
        <label><input type="checkbox" name="ai_platforms" value="Claude" /> Claude</label>
        <label><input type="checkbox" name="ai_platforms" value="Perplexity" /> Perplexity</label>
      </div>
    </div>

    <div class="form-section">
      <h2>{t('Texto del prompt', 'Prompt text')}</h2>
      <div class="field">
        <textarea name="prompt_text" rows="5" minlength="10" required></textarea>
      </div>
    </div>

    <div class="form-section">
      <h2>{t('Contenido SEO', 'SEO content')}</h2>
      <div class="field">
        <label>{t('Resumen', 'Summary')} *</label>
        <textarea name="summary" rows="3" minlength="50" maxlength="300" required></textarea>
      </div>
      <div class="field">
        <label>{t('Respuesta canónica', 'Canonical answer')} *</label>
        <textarea name="canonical_answer" rows="3" minlength="30" maxlength="500" required></textarea>
      </div>
      <div class="field">
        <label>{t('Intención LLM', 'LLM intent')}</label>
        <input name="llm_intent" />
      </div>
    </div>

    <div class="form-section">
      <h2>{t('Referencias', 'References')}</h2>
      <div class="field">
        <label>{t('Destinos (entity_type:entity_slug, separados por coma)', 'Destinos (entity_type:entity_slug, comma-separated)')}</label>
        <input name="destinos_ref" placeholder="destino:cusco, destino:lima" />
      </div>
      <div class="field">
        <label>{t('Marcas AI (name,entity_type,entity_slug — separados por coma)', 'AI brand mentions (name,type,slug — comma-separated)')}</label>
        <input name="brands_ref" placeholder="Inca Rail,company,incarail" />
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary">{t('Crear prompt', 'Create prompt')}</button>
    </div>
  </form>
</AdminLayout>

<script>
  document.getElementById('prompt-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const fd = new FormData(form);

    const ai_platforms = fd.getAll('ai_platforms') as string[];

    const destinosRef = (fd.get('destinos_ref') || '').split(',').map(s => s.trim()).filter(Boolean).map(s => {
      const [entity_type, entity_slug] = s.split(':');
      return { entity_type: entity_type || 'destino', entity_slug: entity_slug || '' };
    });

    const brandsRef = (fd.get('brands_ref') || '').split(',').map(s => s.trim()).filter(Boolean).map(s => {
      const parts = s.split(',');
      return { name: parts[0] || '', entity_type: (parts[1] || 'unknown') as 'company' | 'external_brand' | 'unknown', entity_slug: parts[2] || undefined };
    });

    const body = {
      type: 'prompt_landing',
      title: fd.get('title'),
      search_term: fd.get('search_term') || undefined,
      primary_intent: fd.get('primary_intent'),
      secondary_intent: fd.get('secondary_intent') || undefined,
      destination_cluster: fd.get('destination_cluster') || undefined,
      category_cluster: fd.get('category_cluster') || undefined,
      ai_platforms,
      prompt_text: fd.get('prompt_text'),
      summary: fd.get('summary'),
      canonical_answer: fd.get('canonical_answer'),
      llm_intent: fd.get('llm_intent') || undefined,
      destinos: destinosRef.length ? destinosRef : undefined,
      brands_ai_mentions: brandsRef.length ? brandsRef : undefined,
    };

    const lang = window.location.pathname.split('/')[2];
    const res = await fetch(`/api/admin/${lang}/prompts/`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    if (res.ok) {
      window.location.href = `/admin/${lang}/prompts`;
    } else {
      const data = await res.json();
      alert(data.errors ? data.errors.map((e) => `${e.field}: ${e.message}`).join('\n') : 'Error');
    }
  });
</script>

<style>
  .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
  .page-header h1 { font-size: 24px; font-weight: 700; color: #000000; margin-bottom: 4px; }
  .subtitle { font-size: 14px; color: #737373; }
  .btn-primary {
    display: inline-flex; align-items: center; padding: 10px 20px;
    background: #000000; color: #ffffff; border-radius: 10px;
    font-size: 14px; font-weight: 600; text-decoration: none; border: none; cursor: pointer;
  }
  .btn-primary:hover { opacity: 0.85; }
  .btn-secondary {
    display: inline-flex; align-items: center; padding: 10px 20px;
    background: #ffffff; color: #444748; border: 1px solid #e5e5e5; border-radius: 10px;
    font-size: 14px; font-weight: 500; text-decoration: none; cursor: pointer;
  }
  .btn-secondary:hover { background: #f2f2f2; }
  .btn-sm { padding: 6px 14px; font-size: 12px; margin-top: 8px; }
  .form-card {
    background: #ffffff; border: 1px solid #e5e5e5; border-radius: 14px;
    padding: 32px; max-width: 800px;
  }
  .form-section { margin-bottom: 32px; }
  .form-section h2 { font-size: 16px; font-weight: 600; color: #000000; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid #e5e5e5; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field label { font-size: 12px; font-weight: 600; color: #444748; text-transform: uppercase; letter-spacing: 0.3px; }
  .field input, .field select, .field textarea {
    padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 10px;
    font-size: 14px; font-family: 'Geist', sans-serif; outline: none; background: #f9f9f9;
  }
  .field input:focus, .field select:focus, .field textarea:focus { border-color: #000000; background: #ffffff; }
  .field textarea { resize: vertical; min-height: 80px; }
  .checkbox-group { display: flex; gap: 16px; flex-wrap: wrap; }
  .checkbox-group label { display: flex; align-items: center; gap: 6px; font-size: 14px; cursor: pointer; }
  .checkbox-group input[type="checkbox"] { width: 16px; height: 16px; cursor: pointer; }
  .form-actions { margin-top: 24px; }
</style>
