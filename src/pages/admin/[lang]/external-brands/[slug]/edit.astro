---
export const prerender = false;
import AdminLayout from '../../../../../components/admin/Layout.astro';
import { readEntry } from '../../../../../utils/content';

const { lang, slug } = Astro.params as { lang: string; slug: string };
const t = (es: string, en: string) => lang === 'en' ? en : es;

let entry: Record<string, unknown> = {};
try {
  const parsed = await readEntry('external_brands', slug);
  entry = { slug, ...parsed.data, body: parsed.content };
} catch {
  return Astro.redirect('/admin/' + lang + '/external-brands');
}

const mentioned = (entry.mentioned_in_prompts as string[]) ?? [];
---

<AdminLayout title={t('Editar marca externa', 'Edit external brand')}>
  <div class="page-header">
    <div>
      <h1>{t('Editar marca externa', 'Edit external brand')}</h1>
      <p class="subtitle">{entry.name as string}</p>
    </div>
    <a href={'/admin/' + lang + '/external-brands'} class="btn-secondary">{t('Volver', 'Back')}</a>
  </div>

  <form id="brand-form" class="form-card">
    <div class="form-section">
      <h2>{t('Información de la marca', 'Brand information')}</h2>
      <div class="form-grid">
        <div class="field">
          <label>{t('Nombre', 'Name')} *</label>
          <input name="name" value={entry.name as string} required />
        </div>
        <div class="field">
          <label>{t('URL oficial', 'Official URL')}</label>
          <input name="official_url" type="url" value={(entry.official_url as string) ?? ''} placeholder="https://..." />
        </div>
        <div class="field">
          <label>{t('Rol de la marca', 'Brand role')}</label>
          <input name="brand_role" value={(entry.brand_role as string) ?? ''} placeholder="OTA, DMC, etc." />
        </div>
        <div class="field">
          <label>{t('País', 'Country')}</label>
          <input name="country" value={(entry.country as string) ?? ''} placeholder="Peru" />
        </div>
      </div>
    </div>

    <div class="form-section">
      <h2>{t('Referencias en prompts', 'Prompt references')}</h2>
      <div class="field">
        <label>{t('Slugs de prompts (separados por coma)', 'Prompt slugs (comma-separated)')}</label>
        <input name="mentioned_in_prompts" value={mentioned.join(', ')} />
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-primary">{t('Guardar cambios', 'Save changes')}</button>
    </div>
  </form>
</AdminLayout>

<script>
  document.getElementById('brand-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const fd = new FormData(form);

    const mentioned_in_prompts = (fd.get('mentioned_in_prompts') || '').split(',').map(s => s.trim()).filter(Boolean);

    const body = {
      name: fd.get('name'),
      official_url: fd.get('official_url') || undefined,
      brand_role: fd.get('brand_role') || undefined,
      country: fd.get('country') || undefined,
      mentioned_in_prompts: mentioned_in_prompts.length ? mentioned_in_prompts : undefined,
    };

    const parts = window.location.pathname.split('/');
    const lang = parts[2];
    const slug = parts[4];

    const res = await fetch('/api/admin/' + lang + '/external-brands/' + slug + '/', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(body),
    });

    if (res.ok) {
      window.location.href = '/admin/' + lang + '/external-brands';
    } else {
      const data = await res.json();
      if (data.errors) {
        alert(data.errors.map((e) => e.field + ': ' + e.message).join('\n'));
      } else {
        alert(data.error || 'Error');
      }
    }
  });
</script>

<style>
  .page-header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 24px; }
  .page-header h1 { font-size: 24px; font-weight: 700; color: #000000; margin-bottom: 4px; }
  .subtitle { font-size: 14px; color: #737373; }
  .btn-primary {
    display: inline-flex; align-items: center; padding: 10px 20px;
    background: #000000; color: #ffffff; border-radius: 10px;
    font-size: 14px; font-weight: 600; text-decoration: none; border: none; cursor: pointer;
  }
  .btn-primary:hover { opacity: 0.85; }
  .btn-secondary {
    display: inline-flex; align-items: center; padding: 10px 20px;
    background: #ffffff; color: #444748; border: 1px solid #e5e5e5; border-radius: 10px;
    font-size: 14px; font-weight: 500; text-decoration: none; cursor: pointer;
  }
  .btn-secondary:hover { background: #f2f2f2; }
  .form-card {
    background: #ffffff; border: 1px solid #e5e5e5; border-radius: 14px;
    padding: 32px; max-width: 800px;
  }
  .form-section { margin-bottom: 32px; }
  .form-section h2 { font-size: 16px; font-weight: 600; color: #000000; margin-bottom: 16px; padding-bottom: 8px; border-bottom: 1px solid #e5e5e5; }
  .form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .field { display: flex; flex-direction: column; gap: 4px; }
  .field label { font-size: 12px; font-weight: 600; color: #444748; text-transform: uppercase; letter-spacing: 0.3px; }
  .field input, .field textarea {
    padding: 10px 14px; border: 1px solid #e5e5e5; border-radius: 10px;
    font-size: 14px; font-family: 'Geist', sans-serif; outline: none; background: #f9f9f9;
  }
  .field input:focus, .field textarea:focus { border-color: #000000; background: #ffffff; }
  .field textarea { resize: vertical; min-height: 80px; }
  .form-actions { margin-top: 24px; }
</style>
