---
import SustainableItineraryPage from '../../../components/site/SustainableItineraryPage.astro';
import { SUSTAINABLE_ITINERARIES } from '../../../data/sustainable-itineraries';

export function getStaticPaths() {
  return SUSTAINABLE_ITINERARIES.map((itinerary) => ({ params: { slug: itinerary.slug.es }, props: { itinerary } }));
}

const { itinerary } = Astro.props;
---

<SustainableItineraryPage lang="es" itinerary={itinerary} />
