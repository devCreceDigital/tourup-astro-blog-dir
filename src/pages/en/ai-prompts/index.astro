---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

const prompts = await getCollection('prompts');
---

<Layout
  title="AI Prompts for Peru Tour Companies – TourUp"
  description="Browse AI-optimized prompt landing pages for Peru tourism searches on ChatGPT, Gemini, Claude, and more."
  currentPath="/en/ai-prompts/"
>
  <div class="prompts-header">
    <h1>AI Prompts for Peru tour companies</h1>
    <p>
      Each page answers a specific query people ask AI assistants about Peru tourism.
      Structured for Answer Engine Optimization across ChatGPT, Gemini, Claude, and Perplexity.
    </p>
    <span class="count">{prompts.length} prompt{prompts.length !== 1 ? 's' : ''}</span>
  </div>

  <ul class="prompts-list">
    {prompts.map((prompt) => (
      <li class="prompt-item">
        <a href={`/en/ai-prompts/${prompt.id}/`} class="prompt-link">
          <div class="prompt-title">{prompt.data.title}</div>
          <div class="prompt-meta">
            {prompt.data.ai_platforms.map((p) => (
              <span class="platform">{p}</span>
            ))}
            {prompt.data.category_cluster && (
              <span class="cluster">{prompt.data.category_cluster}</span>
            )}
          </div>
          <p class="prompt-summary">{prompt.data.summary}</p>
        </a>
      </li>
    ))}
  </ul>

  {prompts.length === 0 && (
    <p class="empty">No prompts yet. Add markdown files to <code>src/content/prompts/</code>.</p>
  )}
</Layout>

<style>
  .prompts-header {
    padding: 3rem 0 2rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 2rem;
  }

  .prompts-header h1 {
    font-size: 2.25rem;
    margin-bottom: 0.75rem;
  }

  .prompts-header p {
    font-size: 1.05rem;
    color: #cbd5e1;
    max-width: 640px;
    margin-bottom: 1rem;
  }

  .count {
    display: inline-block;
    background: rgba(6, 182, 212, 0.1);
    color: #06b6d4;
    border: 1px solid rgba(6, 182, 212, 0.25);
    padding: 0.2rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.85rem;
  }

  .prompts-list {
    list-style: none;
    padding: 0;
    margin: 0 0 3rem;
    display: flex;
    flex-direction: column;
    gap: 1px;
  }

  .prompt-item {
    border-bottom: 1px solid var(--color-border);
  }

  .prompt-link {
    display: block;
    padding: 1.25rem 0;
    color: inherit;
    text-decoration: none;
    transition: padding-left 0.2s ease;
  }

  .prompt-link:hover {
    padding-left: 0.75rem;
  }

  .prompt-link:hover .prompt-title {
    color: #06b6d4;
  }

  .prompt-title {
    font-size: 1.1rem;
    font-weight: 600;
    color: #f1f5f9;
    margin-bottom: 0.5rem;
    transition: color 0.2s ease;
  }

  .prompt-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.5rem;
  }

  .platform {
    display: inline-block;
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    border: 1px solid rgba(59, 130, 246, 0.2);
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
  }

  .cluster {
    display: inline-block;
    background: rgba(100, 116, 139, 0.15);
    color: #94a3b8;
    border: 1px solid rgba(100, 116, 139, 0.2);
    padding: 0.15rem 0.6rem;
    border-radius: 9999px;
    font-size: 0.75rem;
  }

  .prompt-summary {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .empty {
    color: #64748b;
    padding: 2rem 0;
  }
</style>
