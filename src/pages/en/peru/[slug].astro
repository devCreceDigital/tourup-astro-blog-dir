---
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const destinos = await getCollection('destinos');
  return destinos.map((destino) => ({
    params: { slug: destino.id },
    props: { destino },
  }));
}

interface Props {
  destino: any;
}

const { destino } = Astro.props;
const { Content } = await destino.render();

const allCompanies = await getCollection('companies');
const allCatDest = await getCollection('categorias_destino');
const allDestinos = await getCollection('destinos');

const companies = allCompanies.filter(
  (c) => c.data.destinos && c.data.destinos.includes(destino.id)
);

const categoriasDestino = allCatDest.filter(
  (cd) => cd.data.destino_slug === destino.id
);

const companiesByCategory: Record<string, any[]> = {};
for (const company of companies) {
  if (company.data.categorias) {
    for (const cat of company.data.categorias) {
      if (!companiesByCategory[cat]) companiesByCategory[cat] = [];
      if (!companiesByCategory[cat].find((c) => c.slug === company.slug)) {
        companiesByCategory[cat].push(company);
      }
    }
  }
}

const relatedDestinos = allDestinos
  .filter((d) => d.id !== destino.id)
  .slice(0, 4);

const categoryLabels: Record<string, string> = {
  'aventura': 'Aventura',
  'trekking': 'Trekking',
  'full-day': 'Full Day',
  'multi-day': 'Multi-Day',
  'gastronomico': 'Gastronomía',
  'cultural': 'Cultural',
  'tours-culturales': 'Tours Culturales',
  'tours-comunitarios': 'Tours Comunitarios',
  'lujo': 'Lujo',
  'familia': 'Familia',
  'mice': 'MICE',
  'birdwatching': 'Birdwatching',
  'arqueologico': 'Arqueológico',
};

const seoTitle = destino.data.seo_title || `Viajar a ${destino.data.name} – Tourup`;
const seoDescription = destino.data.summary;
---

<!doctype html>
<html class="light" lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={seoDescription} />
    <title>{seoTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "TouristDestination",
          "name": destino.data.name,
          "description": destino.data.summary,
          "url": `https://tourup.co/en/peru/${destino.id}/`,
          "touristType": ["Adventure", "Cultural", "Ecotourism"],
        },
        {
          "@type": "BreadcrumbList",
          "itemListElement": [
            { "@type": "ListItem", "position": 1, "name": "Perú", "item": "https://tourup.co/en/peru/" },
            { "@type": "ListItem", "position": 2, "name": destino.data.name, "item": `https://tourup.co/en/peru/${destino.id}/` },
          ],
        },
        ...(destino.data.faq && destino.data.faq.length > 0 ? [{
          "@type": "FAQPage",
          "mainEntity": destino.data.faq.map((f: any) => ({
            "@type": "Question",
            "name": f.question,
            "acceptedAnswer": { "@type": "Answer", "text": f.answer },
          })),
        }] : []),
      ],
    })} />
  </head>

  <body class="bg-[#f9f9f9] min-h-screen font-sans text-[#1a1c1c]" style="font-family:'Geist',sans-serif;">

    <!-- Nav -->
    <nav class="bg-white h-16 w-full border-b border-[#e5e5e5] sticky top-0 z-50">
      <div class="flex justify-between items-center px-4 w-full max-w-[1200px] mx-auto h-full">
        <div class="flex items-center gap-2">
          <a href="/" class="text-lg font-bold tracking-tighter text-[#000000]">Tourup</a>
          <div class="ml-4 hidden md:flex items-center gap-1 text-sm text-[#5e5e5e]">
            <a href="/en/peru/cusco/" class="hover:bg-[#f2f2f2] px-2 py-1 rounded transition-colors duration-100">Destinos</a>
            <a href="/empresas/" class="hover:bg-[#f2f2f2] px-2 py-1 rounded transition-colors duration-100">Empresas</a>
            <a href="/en/ai-prompts/" class="hover:bg-[#f2f2f2] px-2 py-1 rounded transition-colors duration-100">AI Prompts</a>
            <a href="/partner-scout/" class="hover:bg-[#f2f2f2] px-2 py-1 rounded transition-colors duration-100">Partner Scout</a>
          </div>
        </div>
        <div class="flex items-center gap-3">
          <a href="https://tourup.co" class="text-sm font-medium bg-black text-white px-4 py-1.5 rounded-lg hover:bg-[#171717] transition-colors duration-100">
            Ingresar
          </a>
        </div>
      </div>
    </nav>

    <!-- Main -->
    <main class="max-w-[1200px] mx-auto px-4 py-12 grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">

      <!-- Left Column -->
      <div class="lg:col-span-8 flex flex-col gap-8">

        <!-- Hero section -->
        <section class="flex flex-col gap-4">

          <!-- Breadcrumbs -->
          <div class="flex items-center gap-1.5 text-xs text-[#5e5e5e]">
            <a href="/" class="hover:text-black transition-colors">Home</a>
            <span class="material-symbols-outlined text-sm leading-none" style="font-size:14px;">chevron_right</span>
            <a href="/en/peru/cusco/" class="hover:text-black transition-colors">Perú</a>
            <span class="material-symbols-outlined text-sm leading-none" style="font-size:14px;">chevron_right</span>
            <span class="font-semibold text-black">{destino.data.name}</span>
            <span class="material-symbols-outlined text-sm leading-none" style="font-size:14px;">chevron_right</span>
            <span class="font-mono text-xs text-[#a1a1a1]">/peru/{destino.id}/</span>
          </div>

          <!-- Title -->
          <h1 class="text-3xl md:text-5xl font-semibold tracking-tight text-black leading-[1.1] max-w-3xl" style="letter-spacing:-0.04em;">
            Viajar a {destino.data.name}: guía completa para planificar tu viaje a Perú
          </h1>

          <!-- Tags -->
          <div class="flex flex-wrap items-center gap-2 mt-1">
            <span class="border border-[#e5e5e5] bg-[#f2f2f2] rounded-full px-3 py-1 text-xs text-[#5e5e5e]">Guía de destino</span>
            <span class="border border-[#e5e5e5] bg-white rounded-full px-3 py-1 text-xs text-[#5e5e5e]">Actualizada 2026</span>
            <span class="border border-[#e5e5e5] bg-white rounded-full px-3 py-1 text-xs text-[#5e5e5e]">Incluye FAQs AEO</span>
            {destino.data.region && (
              <span class="border border-[#e5e5e5] bg-white rounded-full px-3 py-1 text-xs text-[#5e5e5e]">{destino.data.region}</span>
            )}
          </div>

          <!-- Summary -->
          <p class="text-sm text-[#444748] max-w-2xl mt-3 leading-relaxed">
            {destino.data.summary}
          </p>

          <!-- CTAs -->
          <div class="flex flex-wrap items-center gap-3 mt-3">
            <a
              href={`/en/peru/${destino.id}/tours/`}
              class="bg-black text-white rounded-lg px-6 py-3 text-sm font-medium transition-colors hover:bg-[#171717]"
            >
              Ver tours en {destino.data.name}
            </a>
            <a
              href="/partner-scout/"
              class="border border-[#e5e5e5] bg-transparent text-black rounded-lg px-6 py-3 text-sm font-medium transition-colors hover:bg-[#f2f2f2]"
            >
              Buscar operadores
            </a>
          </div>

          <!-- Hero image -->
          <div class="w-full mt-4 rounded-xl border border-[#e5e5e5] overflow-hidden aspect-video bg-[#dadada] relative">
            <img
              src={`https://images.pexels.com/photos/${destino.id === 'cusco' ? '3250613' : destino.id === 'lima' ? '3290049' : destino.id === 'arequipa' ? '2356059' : destino.id === 'machu_picchu' ? '2356059' : destino.id === 'puno' ? '3617500' : destino.id === 'iquitos' ? '3608263' : destino.id === 'huaraz' ? '1366919' : destino.id === 'nazca' ? '3591519' : destino.id === 'paracas' ? '1583339' : destino.id === 'colca' ? '1131458' : '3250613'}/pexels-photo-${destino.id === 'cusco' ? '3250613' : destino.id === 'lima' ? '3290049' : destino.id === 'arequipa' ? '2356059' : destino.id === 'machu_picchu' ? '2356059' : destino.id === 'puno' ? '3617500' : destino.id === 'iquitos' ? '3608263' : destino.id === 'huaraz' ? '1366919' : destino.id === 'nazca' ? '3591519' : destino.id === 'paracas' ? '1583339' : destino.id === 'colca' ? '1131458' : '3250613'}.jpeg?auto=compress&cs=tinysrgb&w=1200`}
              alt={`Paisaje de ${destino.data.name}, Perú`}
              class="w-full h-full object-cover grayscale opacity-90"
              loading="eager"
            />
          </div>
        </section>

        <!-- Content cards -->
        <div class="flex flex-col gap-6">

          <!-- Resumen rápido -->
          <article class="bg-white border border-[#e5e5e5] rounded-xl p-6 relative overflow-hidden">
            <div class="absolute left-0 top-6 bottom-6 w-1 bg-black rounded-r"></div>
            <h2 class="text-lg font-semibold text-black mb-4 pl-4" style="letter-spacing:-0.03em;">
              Resumen rápido: por qué viajar a {destino.data.name}
            </h2>
            <div class="pl-4 text-sm text-[#444748] leading-relaxed prose prose-sm max-w-none">
              <Content />
            </div>
          </article>

          <!-- Categorías de tours -->
          {categoriasDestino.length > 0 && (
            <article class="bg-white border border-[#e5e5e5] rounded-xl p-6 relative overflow-hidden">
              <div class="absolute left-0 top-6 bottom-6 w-1 bg-black rounded-r"></div>
              <h2 class="text-lg font-semibold text-black mb-6 pl-4" style="letter-spacing:-0.03em;">
                Tours y experiencias en {destino.data.name}
              </h2>
              <div class="pl-4 grid grid-cols-1 sm:grid-cols-2 gap-3">
                {categoriasDestino.slice(0, 10).map((cd) => (
                  <a
                    href={`/en/peru/${destino.id}/tours/${cd.data.categoria}/`}
                    class="group flex items-center justify-between border border-[#e5e5e5] rounded-lg p-4 hover:border-black transition-colors duration-150 hover:bg-[#f9f9f9]"
                  >
                    <div>
                      <span class="text-sm font-medium text-black block">
                        {categoryLabels[cd.data.categoria] || cd.data.name}
                      </span>
                      <span class="text-xs text-[#747878] mt-0.5 block line-clamp-1">{cd.data.summary}</span>
                    </div>
                    <span class="material-symbols-outlined text-[#a1a1a1] group-hover:text-black transition-colors" style="font-size:16px;">arrow_forward</span>
                  </a>
                ))}
              </div>
            </article>
          )}

          <!-- FAQs -->
          {destino.data.faq && destino.data.faq.length > 0 && (
            <article class="bg-white border border-[#e5e5e5] rounded-xl p-6 relative overflow-hidden">
              <div class="absolute left-0 top-6 bottom-6 w-1 bg-black rounded-r"></div>
              <h2 class="text-lg font-semibold text-black mb-6 pl-4" style="letter-spacing:-0.03em;">
                Preguntas frecuentes sobre viajar a {destino.data.name}
              </h2>
              <div class="pl-4 flex flex-col gap-0">
                {destino.data.faq.map((item: any, i: number) => (
                  <div class={`py-5 ${i > 0 ? 'border-t border-[#e5e5e5]' : ''}`}>
                    <h3 class="text-sm font-medium text-black mb-2">{item.question}</h3>
                    <p class="text-sm text-[#5e5e5e] leading-relaxed">{item.answer}</p>
                  </div>
                ))}
              </div>
            </article>
          )}

          <!-- Operadores turísticos -->
          <article class="bg-white border border-[#e5e5e5] rounded-xl p-6 relative overflow-hidden">
            <div class="absolute left-0 top-6 bottom-6 w-1 bg-black rounded-r"></div>
            <h2 class="text-lg font-semibold text-black mb-6 pl-4" style="letter-spacing:-0.03em;">
              Operadores turísticos en {destino.data.name}
            </h2>
            <div class="pl-4">
              {companies.length === 0 ? (
                <p class="text-sm text-[#747878] italic">No hay empresas registradas en este destino aún.</p>
              ) : (
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  {companies.slice(0, 8).map((company) => {
                    const slug = company.id;
                    return (
                      <a
                        href={`/companies/${slug}/`}
                        class="group flex flex-col gap-1 border border-[#e5e5e5] rounded-lg p-4 hover:border-black transition-colors duration-150 hover:bg-[#f9f9f9]"
                      >
                        <span class="text-sm font-medium text-black group-hover:underline line-clamp-1">{company.data.title}</span>
                        <span class="text-xs text-[#747878] line-clamp-2 leading-relaxed">{company.data.summary}</span>
                        <div class="flex flex-wrap gap-1 mt-1">
                          {company.data.categorias?.slice(0, 2).map((cat: string) => (
                            <span class="text-[10px] bg-[#f2f2f2] text-[#5e5e5e] border border-[#e5e5e5] px-2 py-0.5 rounded-full">
                              {categoryLabels[cat] || cat}
                            </span>
                          ))}
                        </div>
                      </a>
                    );
                  })}
                </div>
              )}
              {companies.length > 8 && (
                <div class="mt-4">
                  <a
                    href={`/empresas/`}
                    class="text-sm text-[#5e5e5e] hover:text-black flex items-center gap-1 transition-colors"
                  >
                    Ver los {companies.length} operadores en {destino.data.name}
                    <span class="material-symbols-outlined" style="font-size:14px;">arrow_forward</span>
                  </a>
                </div>
              )}
            </div>
          </article>

        </div>
      </div>

      <!-- Right Sidebar -->
      <aside class="lg:col-span-4 flex flex-col gap-5 lg:sticky lg:top-[88px]">

        <!-- Pricing card -->
        <div class="bg-white border border-[#e5e5e5] rounded-xl p-6">
          <span class="text-[10px] font-medium text-[#5e5e5e] uppercase tracking-widest block mb-2">Tours Desde</span>
          <div class="flex items-baseline gap-2 mb-5">
            <span class="text-3xl font-semibold tracking-tight text-black" style="letter-spacing:-0.04em;">USD 89</span>
            <span class="text-sm text-[#5e5e5e]">/ persona</span>
          </div>
          <a
            href={`/en/peru/${destino.id}/tours/`}
            class="w-full block text-center bg-black text-white rounded-lg py-3 text-sm font-medium transition-colors hover:bg-[#171717] mb-3"
          >
            Comparar tours
          </a>
          <p class="text-center text-[10px] text-[#5e5e5e] mb-5">Sin cargos ocultos · Cancelación flexible</p>
          <div class="flex flex-col gap-2.5 text-sm">
            <div class="flex justify-between border-b border-[#e5e5e5] pb-2">
              <span class="text-[#5e5e5e]">Mejor época</span>
              <span class="text-black font-medium">May – Oct</span>
            </div>
            <div class="flex justify-between border-b border-[#e5e5e5] pb-2">
              <span class="text-[#5e5e5e]">Días recomendados</span>
              <span class="text-black font-medium">4–5 días</span>
            </div>
            <div class="flex justify-between border-b border-[#e5e5e5] pb-2">
              <span class="text-[#5e5e5e]">Operadores</span>
              <span class="text-black font-medium">{companies.length}+</span>
            </div>
            <div class="flex justify-between pb-1">
              <span class="text-[#5e5e5e]">Categorías</span>
              <span class="text-black font-medium">{categoriasDestino.length}</span>
            </div>
          </div>
        </div>

        <!-- Schema box -->
        <div class="bg-[#f9f9f9] border border-[#e5e5e5] rounded-xl p-5">
          <span class="text-[10px] font-medium text-[#5e5e5e] uppercase tracking-widest block mb-3">SCHEMA.ORG</span>
          <div class="flex flex-wrap gap-1.5">
            <span class="bg-[#e2e2e2] text-black text-xs px-2 py-1 rounded font-mono">TouristDestination</span>
            {destino.data.faq && destino.data.faq.length > 0 && (
              <span class="bg-[#e2e2e2] text-black text-xs px-2 py-1 rounded font-mono">FAQPage</span>
            )}
            <span class="bg-[#e2e2e2] text-black text-xs px-2 py-1 rounded font-mono">BreadcrumbList</span>
            <span class="bg-[#e2e2e2] text-black text-xs px-2 py-1 rounded font-mono">TouristTrip</span>
          </div>
        </div>

        <!-- Internal links -->
        <div class="bg-white border border-[#e5e5e5] rounded-xl p-5">
          <span class="text-[10px] font-medium text-[#5e5e5e] uppercase tracking-widest block mb-3">Links Internos</span>
          <ul class="flex flex-col gap-2 font-mono text-xs text-black">
            <li>
              <a href={`/en/peru/${destino.id}/tours/`} class="hover:text-[#5e5e5e] flex justify-between items-center border-b border-[#e5e5e5] pb-2 transition-colors">
                /peru/{destino.id}/tours/
                <span class="material-symbols-outlined text-[#a1a1a1]" style="font-size:14px;">arrow_forward</span>
              </a>
            </li>
            <li>
              <a href="/partner-scout/" class="hover:text-[#5e5e5e] flex justify-between items-center border-b border-[#e5e5e5] pb-2 transition-colors">
                /partner-scout/
                <span class="material-symbols-outlined text-[#a1a1a1]" style="font-size:14px;">arrow_forward</span>
              </a>
            </li>
            <li>
              <a href="/empresas/" class="hover:text-[#5e5e5e] flex justify-between items-center border-b border-[#e5e5e5] pb-2 transition-colors">
                /empresas/
                <span class="material-symbols-outlined text-[#a1a1a1]" style="font-size:14px;">arrow_forward</span>
              </a>
            </li>
            <li>
              <a href="/en/ai-prompts/" class="hover:text-[#5e5e5e] flex justify-between items-center transition-colors">
                /en/ai-prompts/
                <span class="material-symbols-outlined text-[#a1a1a1]" style="font-size:14px;">arrow_forward</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- Destinos relacionados -->
        <div class="bg-white border border-[#e5e5e5] rounded-xl p-5">
          <span class="text-[10px] font-medium text-[#5e5e5e] uppercase tracking-widest block mb-3">Destinos Relacionados</span>
          <ul class="flex flex-col gap-2 text-sm text-black">
            {relatedDestinos.map((d, i) => (
              <li class={`flex justify-between items-center ${i < relatedDestinos.length - 1 ? 'border-b border-[#e5e5e5] pb-2' : ''}`}>
                <a href={`/en/peru/${d.id}/`} class="hover:text-[#5e5e5e] transition-colors font-medium">{d.data.name}</a>
                <span class="font-mono text-[10px] text-[#5e5e5e]">/peru/{d.id}/</span>
              </li>
            ))}
          </ul>
        </div>

      </aside>
    </main>

    <!-- Footer -->
    <footer class="border-t border-[#e5e5e5] bg-white mt-16 py-8">
      <div class="max-w-[1200px] mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-[#5e5e5e]">
        <span>© 2026 Tourup · Turismo responsable en Perú</span>
        <div class="flex gap-5">
          <a href="/" class="hover:text-black transition-colors">Home</a>
          <a href="/empresas/" class="hover:text-black transition-colors">Empresas</a>
          <a href="/partner-scout/" class="hover:text-black transition-colors">Partner Scout</a>
          <a href="/en/ai-prompts/" class="hover:text-black transition-colors">AI Prompts</a>
        </div>
      </div>
    </footer>

  </body>
</html>

<style is:global>
  .prose h2 {
    font-size: 1rem;
    font-weight: 600;
    color: #000;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    letter-spacing: -0.025em;
  }
  .prose h3 {
    font-size: 0.875rem;
    font-weight: 600;
    color: #000;
    margin-top: 1rem;
    margin-bottom: 0.375rem;
  }
  .prose p {
    font-size: 0.875rem;
    color: #444748;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .prose ul {
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
  }
  .prose li {
    font-size: 0.875rem;
    color: #5e5e5e;
    margin-bottom: 0.375rem;
    line-height: 1.5;
  }
  .prose strong {
    color: #000;
    font-weight: 600;
  }
  .prose a {
    color: #000;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose a:hover {
    color: #5e5e5e;
  }
  .line-clamp-1 {
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
