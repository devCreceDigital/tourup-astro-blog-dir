---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const destinos = await getCollection('destinos');
  return destinos.map((destino) => ({
    params: { slug: destino.slug },
    props: { destino },
  }));
}

interface Props {
  destino: any;
}

const { destino } = Astro.props;
const { Content } = await destino.render();

const allCompanies = await getCollection('companies');
const allCatDest = await getCollection('categorias_destino');

const companies = allCompanies.filter(
  (c) => c.data.destinos && c.data.destinos.includes(destino.slug)
);

const categoriasDestino = allCatDest.filter(
  (cd) => cd.data.destino_slug === destino.slug
);

const companiesByCategory: Record<string, any[]> = {};
for (const company of companies) {
  if (company.data.categorias) {
    for (const cat of company.data.categorias) {
      if (!companiesByCategory[cat]) companiesByCategory[cat] = [];
      if (!companiesByCategory[cat].find((c) => c.slug === company.slug)) {
        companiesByCategory[cat].push(company);
      }
    }
  }
}
---

<Layout
  title={destino.data.seo_title || `${destino.data.name} – TourUp Peru`}
  description={destino.data.summary}
  currentPath={`/en/peru/${destino.slug}/`}
>
  <article class="destino-page">
    <header class="destino-header">
      <nav class="breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/en/ai-prompts/">Peru</a>
        <span>/</span>
        <span>{destino.data.name}</span>
      </nav>
      <h1>{destino.data.name}</h1>
      <p class="destino-summary">{destino.data.summary}</p>
      <div class="destino-meta">
        {destino.data.region && <span class="badge">{destino.data.region}</span>}
        <span class="badge secondary">{companies.length} company{companies.length !== 1 ? 'ies' : 'y'}</span>
      </div>
    </header>

    <section class="destino-content">
      <Content />
    </section>

    {categoriasDestino.length > 0 && (
      <section class="categories-section">
        <h2>Tours & Categories in {destino.data.name}</h2>
        <div class="categories-grid">
          {categoriasDestino.map((cd) => (
            <a href={`/en/peru/${destino.slug}/tours/${cd.data.categoria}/`} class="category-card">
              <h3>{cd.data.name}</h3>
              <p>{cd.data.summary}</p>
              <span class="company-count">
                {companiesByCategory[cd.data.categoria]?.length || 0} company{companiesByCategory[cd.data.categoria]?.length !== 1 ? 'ies' : 'y'}
              </span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="companies-section">
      <h2>Tour Operators in {destino.data.name}</h2>
      {companies.length === 0 && (
        <p class="empty">No companies registered in this destination yet.</p>
      )}
      <div class="companies-grid">
        {companies.map((company) => {
          const slug = company.slug.replace(/^\/company\//, '');
          return (
            <a href={`/companies/${slug}/`} class="company-card" key={company.slug}>
              <h3>{company.data.title}</h3>
              <p>{company.data.summary}</p>
              <div class="company-meta">
                <span class="badge">{company.data.distribution_role}</span>
                {company.data.categorias?.slice(0, 3).map((cat: string) => (
                  <span class="tag">{cat}</span>
                ))}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </article>
</Layout>

<style>
  .destino-page {
    max-width: 1000px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .destino-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .breadcrumbs {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: #64748b;
  }

  .breadcrumbs a {
    color: #06b6d4;
  }

  .breadcrumbs span {
    color: #64748b;
  }

  .destino-header h1 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: #f1f5f9;
  }

  .destino-summary {
    font-size: 1.1rem;
    color: #cbd5e1;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .destino-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-block;
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    border: 1px solid rgba(59, 130, 246, 0.2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge.secondary {
    background: rgba(6, 182, 212, 0.1);
    color: #06b6d4;
    border-color: rgba(6, 182, 212, 0.2);
  }

  .destino-content {
    font-size: 1rem;
    line-height: 1.8;
    color: #cbd5e1;
    margin-bottom: 3rem;
  }

  .destino-content :global(h2) {
    font-size: 1.5rem;
    margin: 1.5rem 0 1rem 0;
    color: #f1f5f9;
  }

  .destino-content :global(ul) {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .destino-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .categories-section {
    margin-bottom: 3rem;
  }

  .categories-section h2 {
    margin-bottom: 1.5rem;
  }

  .categories-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 1.5rem;
  }

  .category-card {
    display: block;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .category-card:hover {
    border-color: #06b6d4;
    transform: translateY(-5px);
    background: rgba(30, 41, 59, 0.8);
  }

  .category-card h3 {
    font-size: 1.1rem;
    color: #06b6d4;
    margin-bottom: 0.75rem;
  }

  .category-card p {
    font-size: 0.9rem;
    color: #94a3b8;
    line-height: 1.6;
    margin-bottom: 1rem;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .company-count {
    font-size: 0.85rem;
    color: #3b82f6;
    font-weight: 600;
  }

  .companies-section {
    margin-bottom: 3rem;
  }

  .companies-section h2 {
    margin-bottom: 1.5rem;
  }

  .companies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .company-card {
    display: block;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .company-card:hover {
    border-color: #3b82f6;
    transform: translateY(-3px);
    background: rgba(30, 41, 59, 0.8);
  }

  .company-card h3 {
    font-size: 1rem;
    color: #f1f5f9;
    margin-bottom: 0.5rem;
  }

  .company-card p {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .company-card .company-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .tag {
    display: inline-block;
    background: rgba(100, 116, 139, 0.15);
    color: #94a3b8;
    border: 1px solid rgba(100, 116, 139, 0.2);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.7rem;
  }

  .empty {
    color: #64748b;
    padding: 2rem 0;
    font-style: italic;
  }

  nav.destino-nav {
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  @media (max-width: 768px) {
    .destino-header h1 {
      font-size: 1.75rem;
    }

    .destino-summary {
      font-size: 1rem;
    }

    .categories-grid,
    .companies-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
