---
import { getCollection } from 'astro:content';
import Layout from '../../../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const allCatDest = await getCollection('categorias_destino');
  return allCatDest.map((cd) => ({
    params: { slug: cd.data.destino_slug, categoria: cd.data.categoria },
    props: { cd },
  }));
}

interface Props {
  cd: any;
}

const { cd } = Astro.props;
const { Content } = await cd.render();

const slug = cd.data.destino_slug;
const categoria = cd.data.categoria;

const allCompanies = await getCollection('companies');
const allDestinos = await getCollection('destinos');

const destino = allDestinos.find((d) => d.slug === slug);

const companies = allCompanies.filter(
  (c) =>
    c.data.destinos?.includes(slug) &&
    c.data.categorias?.includes(categoria)
);
---

<Layout
  title={`${cd.data.name} – TourUp Peru`}
  description={cd.data.summary}
  currentPath={`/en/peru/${slug}/tours/${categoria}/`}
>
  <article class="categoria-page">
    <header class="categoria-header">
      <nav class="breadcrumbs">
        <a href="/">Home</a>
        <span>/</span>
        <a href="/en/ai-prompts/">Peru</a>
        <span>/</span>
        <a href={`/en/peru/${slug}/`}>{destino?.data.name || slug}</a>
        <span>/</span>
        <a href={`/en/peru/${slug}/tours/`}>Tours</a>
        <span>/</span>
        <span>{cd.data.name}</span>
      </nav>
      <h1>{cd.data.name}</h1>
      <p class="categoria-summary">{cd.data.summary}</p>
      <div class="categoria-meta">
        <span class="badge">{companies.length} compan{companies.length !== 1 ? 'ies' : 'y'}</span>
        <span class="badge secondary">{destino?.data.name || slug}</span>
      </div>
    </header>

    <section class="categoria-content">
      <Content />
    </section>

    {cd.data.faq && cd.data.faq.length > 0 && (
      <section class="faq-section">
        <h2>Frequently Asked Questions</h2>
        <div class="faq-list">
          {cd.data.faq.map((item: any) => (
            <details class="faq-item">
              <summary>{item.question}</summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}

    <section class="companies-section">
      <h2>Companies offering {cd.data.name}</h2>
      {companies.length === 0 && (
        <p class="empty">No companies found for this category in this destination.</p>
      )}
      <div class="companies-grid">
        {companies.map((company) => {
          const companySlug = company.slug.replace(/^\/company\//, '');
          return (
            <a href={`/companies/${companySlug}/`} class="company-card" key={company.slug}>
              <h3>{company.data.title}</h3>
              <p>{company.data.summary}</p>
              <div class="company-meta">
                <span class="badge">{company.data.distribution_role}</span>
                {company.data.nap?.city && (
                  <span class="tag">{company.data.nap.city}</span>
                )}
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </article>

  <nav class="categoria-nav">
    <a href={`/en/peru/${slug}/tours/`} class="nav-link">← Back to all tours in {destino?.data.name || slug}</a>
  </nav>
</Layout>

<style>
  .categoria-page {
    max-width: 900px;
    margin: 0 auto;
    padding: 2rem 0;
  }

  .categoria-header {
    border-bottom: 1px solid var(--color-border);
    padding-bottom: 2rem;
    margin-bottom: 2rem;
  }

  .breadcrumbs {
    display: flex;
    gap: 0.5rem;
    align-items: center;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: #64748b;
  }

  .breadcrumbs a {
    color: #06b6d4;
  }

  .breadcrumbs span {
    color: #64748b;
  }

  .categoria-header h1 {
    font-size: 2.25rem;
    margin-bottom: 1rem;
    color: #f1f5f9;
  }

  .categoria-summary {
    font-size: 1.1rem;
    color: #cbd5e1;
    line-height: 1.8;
    margin-bottom: 1rem;
  }

  .categoria-meta {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-block;
    background: rgba(59, 130, 246, 0.1);
    color: #3b82f6;
    padding: 0.35rem 0.85rem;
    border-radius: 9999px;
    font-size: 0.8rem;
    border: 1px solid rgba(59, 130, 246, 0.2);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .badge.secondary {
    background: rgba(6, 182, 212, 0.1);
    color: #06b6d4;
    border-color: rgba(6, 182, 212, 0.2);
  }

  .categoria-content {
    font-size: 1rem;
    line-height: 1.8;
    color: #cbd5e1;
    margin-bottom: 3rem;
  }

  .categoria-content :global(h2) {
    font-size: 1.5rem;
    margin: 1.5rem 0 1rem 0;
    color: #f1f5f9;
  }

  .categoria-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1rem;
  }

  .categoria-content :global(th),
  .categoria-content :global(td) {
    padding: 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  .categoria-content :global(th) {
    background: var(--color-dark-light);
    font-weight: 600;
  }

  .faq-section {
    margin-bottom: 3rem;
  }

  .faq-section h2 {
    margin-bottom: 1.5rem;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .faq-item {
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1rem 1.5rem;
    cursor: pointer;
  }

  .faq-item summary {
    font-weight: 600;
    color: #f1f5f9;
    cursor: pointer;
    outline: none;
  }

  .faq-item p {
    margin-top: 1rem;
    color: #cbd5e1;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  .companies-section {
    margin-bottom: 3rem;
  }

  .companies-section h2 {
    margin-bottom: 1.5rem;
  }

  .companies-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.5rem;
  }

  .company-card {
    display: block;
    background: rgba(30, 41, 59, 0.5);
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    padding: 1.5rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .company-card:hover {
    border-color: #3b82f6;
    transform: translateY(-3px);
    background: rgba(30, 41, 59, 0.8);
  }

  .company-card h3 {
    font-size: 1rem;
    color: #f1f5f9;
    margin-bottom: 0.5rem;
  }

  .company-card p {
    font-size: 0.85rem;
    color: #94a3b8;
    line-height: 1.5;
    margin-bottom: 0.75rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .company-card .company-meta {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
    align-items: center;
  }

  .tag {
    display: inline-block;
    background: rgba(100, 116, 139, 0.15);
    color: #94a3b8;
    border: 1px solid rgba(100, 116, 139, 0.2);
    padding: 0.15rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.7rem;
  }

  .empty {
    color: #64748b;
    padding: 2rem 0;
    font-style: italic;
  }

  .categoria-nav {
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .nav-link {
    color: #06b6d4;
    font-weight: 600;
    transition: transform 0.2s ease;
    text-decoration: none;
  }

  .nav-link:hover {
    transform: translateX(-4px);
  }

  @media (max-width: 768px) {
    .categoria-header h1 {
      font-size: 1.5rem;
    }

    .companies-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
