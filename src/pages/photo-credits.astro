---
/**
 * Créditos de todas las fotos del sitio (Wikimedia Commons, licencias Creative Commons).
 * La portada y las cabeceras muestran el crédito junto a la foto; el resto de miniaturas
 * (mosaicos, tarjetas, listas) se acreditan aquí, enlazado desde el pie de cada página.
 */
import GuidePage from '../components/site/GuidePage.astro';
import photos from '../data/photos.json';

const rows = Object.entries(photos as Record<string, any>)
  .map(([key, p]) => ({ key, ...p }))
  .sort((a, b) => a.alt.localeCompare(b.alt));
---

<GuidePage
  title="Photo credits | TourUp Guide"
  heading="Photo credits"
  dek="Who took each photo on this site and under which licence. Most come from Wikimedia Commons under Creative Commons licences; a few are supplied by TourUp."
  description="Authors and licences of the photos used on TourUp Guide (Wikimedia Commons, Creative Commons)."
  currentPath="/photo-credits/"
  lang="en"
  breadcrumb="Photo credits"
  wide
>
  <table>
    <thead>
      <tr>
        <th>Photo</th>
        <th>Author</th>
        <th>Licence</th>
        <th>Source</th>
      </tr>
    </thead>
    <tbody>
      {rows.map((p) => (
        <tr>
          <td><img src={`${p.file}-960.webp`} alt="" width="120" height={Math.round((120 * p.height) / p.width)} loading="lazy" class="pc-thumb" /> {p.alt}</td>
          <td>{p.credit}</td>
          <td>{p.license}</td>
          <td>{p.source ? <a href={p.source} rel="noopener">Wikimedia Commons</a> : 'TourUp'}</td>
        </tr>
      ))}
    </tbody>
  </table>
  <p>Photos are resized and converted to WebP; no other changes were made.</p>
</GuidePage>

<style>
  .pc-thumb {
    display: inline-block;
    vertical-align: middle;
    margin-right: 0.6rem;
    width: 120px;
    height: auto;
  }
</style>
