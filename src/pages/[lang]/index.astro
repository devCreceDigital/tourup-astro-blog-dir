---
import { getCollection } from 'astro:content';
import NavCmstourup from '../../components/NavCmstourup.astro';
import FooterCmstourup from '../../components/FooterCmstourup.astro';
import SettingsHead from '../../components/SettingsHead.astro';
import SettingsBodyEnd from '../../components/SettingsBodyEnd.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'es' }, props: { lang: 'es' } },
  ];
}

interface Props { lang: string; }
const { lang } = Astro.props;

const t = (es: string, en: string) => lang === 'en' ? en : es;

const destinos = await getCollection('destinos');
const posts = await getCollection('posts');
const prompts = await getCollection('prompts');
const companies = await getCollection('companies');

const sortedDestinos = destinos.sort((a, b) => a.data.name.localeCompare(b.data.name));
const sortedPosts = posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const featuredDestinos = sortedDestinos.slice(0, 6);
const recentPosts = sortedPosts.slice(0, 3);

function readingTime(text: string): number {
  const words = text.split(/\s+/).length;
  return Math.max(1, Math.ceil(words / 200));
}

const siteUrl = 'https://tourup.co';
const currentPath = `/${lang}/`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t("TourUp - Guía de Viaje", "TourUp - Travel Guide")}</title>
    <SettingsHead
      title={t("TourUp - Guía de Viaje", "TourUp - Travel Guide")}
      description={t(
        "Explora nuestras guías documentadas sobre la historia, arquitectura y naturaleza de los Andes peruanos.",
        "Explore our documented guides on the history, architecture and nature of the Peruvian Andes."
      )}
      currentPath={currentPath}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        background: #ffffff;
        color: #0a0a0a;
        font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }
      img { max-width: 100%; height: auto; }
      a { text-decoration: none; color: inherit; }

      .page-wrap { max-width: 1200px; margin: 0 auto; padding: 0 24px; }

      /* ── Hero ──────────────────────────────────────────── */
      .hero {
        max-width: 1200px;
        margin: 0 auto;
        padding: 48px 24px 48px;
        border-bottom: 1px solid #e5e5e5;
      }
      .hero h1 {
        font-size: 48px;
        line-height: 1.1;
        letter-spacing: -0.05em;
        font-weight: 600;
        margin-bottom: 24px;
        max-width: 700px;
      }
      .hero p {
        font-size: 16px;
        color: #737373;
        line-height: 1.43;
        margin-bottom: 32px;
        max-width: 520px;
      }
      .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
      .btn-primary {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: #0a0a0a;
        color: #ffffff;
        padding: 8px 16px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        transition: background 0.15s;
      }
      .btn-primary:hover { background: #171717; }
      .btn-outline {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        background: transparent;
        color: #0a0a0a;
        padding: 8px 16px;
        border-radius: 10px;
        font-size: 14px;
        font-weight: 500;
        transition: background 0.15s;
      }
      .btn-outline:hover { background: #f2f2f2; }

      /* ── Section common ────────────────────────────────── */
      .section { max-width: 1200px; margin: 0 auto; padding: 48px 24px; }
      .section-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 24px;
      }
      .section-header h2 {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.025em;
      }
      .section-link {
        font-size: 14px;
        font-weight: 500;
        padding: 6px 12px;
        border-radius: 10px;
        transition: background 0.15s;
      }
      .section-link:hover { background: #f2f2f2; }

      /* ── Destinations Grid ─────────────────────────────── */
      .dest-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
      }
      @media (min-width: 640px) { .dest-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 1024px) { .dest-grid { grid-template-columns: repeat(3, 1fr); } }
      .dest-card {
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        overflow: hidden;
        cursor: pointer;
        transition: border-color 0.2s;
        background: #ffffff;
        display: flex;
        flex-direction: column;
      }
      .dest-card:hover { border-color: #0a0a0a; }
      .dest-card-img {
        aspect-ratio: 16/9;
        background: #f2f2f2;
        width: 100%;
        border-bottom: 1px solid #e5e5e5;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      .dest-card-img svg { color: #737373; width: 48px; height: 48px; }
      .dest-card-body { padding: 16px; flex: 1; display: flex; flex-direction: column; }
      .dest-card-top { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8px; }
      .dest-badge {
        display: inline-flex;
        align-items: center;
        background: #f2f2f2;
        padding: 4px 10px;
        border-radius: 26px;
        font-size: 12px;
        font-weight: 500;
        color: #0a0a0a;
      }
      .dest-readtime {
        font-size: 13px;
        color: #737373;
      }
      .dest-card h3 {
        font-size: 16px;
        font-weight: 600;
        margin-bottom: 4px;
        line-height: 1.43;
      }
      .dest-card p {
        font-size: 14px;
        color: #737373;
        line-height: 1.43;
      }

      /* ── Featured Layout ───────────────────────────────── */
      .featured-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
      }
      @media (min-width: 1024px) { .featured-grid { grid-template-columns: 1fr 1fr; } }
      .featured-large {
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        transition: border-color 0.2s;
        background: #ffffff;
        cursor: pointer;
      }
      .featured-large:hover { border-color: #0a0a0a; }
      @media (min-width: 640px) {
        .featured-large { flex-direction: row; }
        .featured-large .feat-img-wrap { width: 50%; border-right: 1px solid #e5e5e5; }
        .featured-large .feat-body { width: 50%; }
      }
      .feat-img-wrap {
        aspect-ratio: 1/1;
        background: #f2f2f2;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-bottom: 1px solid #e5e5e5;
      }
      .feat-img-wrap svg { color: #737373; width: 40px; height: 40px; }
      .feat-body { padding: 20px; display: flex; flex-direction: column; justify-content: center; }
      .feat-badge {
        display: inline-flex;
        align-items: center;
        background: #f2f2f2;
        padding: 4px 10px;
        border-radius: 26px;
        font-size: 12px;
        font-weight: 500;
        color: #0a0a0a;
        align-self: flex-start;
        margin-bottom: 16px;
      }
      .feat-body h3 {
        font-size: 18px;
        font-weight: 600;
        line-height: 1.2;
        margin-bottom: 8px;
        letter-spacing: -0.025em;
      }
      .feat-body p {
        font-size: 14px;
        color: #737373;
        line-height: 1.43;
        margin-bottom: 16px;
      }
      .feat-meta {
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 13px;
        color: #737373;
        margin-top: auto;
      }
      .feat-meta svg { margin-right: 4px; }
      .feat-list { display: flex; flex-direction: column; gap: 16px; }
      .feat-item {
        display: flex;
        flex-direction: column;
        padding: 16px;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        background: #ffffff;
        transition: border-color 0.2s;
      }
      .feat-item:hover { border-color: #0a0a0a; }
      .feat-item h4 {
        font-size: 16px;
        font-weight: 600;
        line-height: 1.43;
        margin-bottom: 8px;
      }
      .feat-item p {
        font-size: 14px;
        color: #737373;
        line-height: 1.43;
        margin-bottom: 12px;
      }
      .feat-item-tag {
        display: inline-flex;
        align-items: center;
        background: #f2f2f2;
        padding: 4px 10px;
        border-radius: 26px;
        font-size: 12px;
        font-weight: 500;
        color: #0a0a0a;
        align-self: flex-start;
      }

      /* ── Weather Cards ─────────────────────────────────── */
      .weather-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
      }
      @media (min-width: 640px) { .weather-grid { grid-template-columns: repeat(2, 1fr); } }
      @media (min-width: 1024px) { .weather-grid { grid-template-columns: repeat(3, 1fr); } }
      .weather-card {
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        padding: 20px;
        background: #ffffff;
      }
      .weather-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 16px;
      }
      .weather-head h3 { font-size: 16px; font-weight: 600; }
      .season-badge {
        display: inline-flex;
        align-items: center;
        background: #0a0a0a;
        color: #ffffff;
        padding: 4px 10px;
        border-radius: 26px;
        font-size: 12px;
        font-weight: 500;
      }
      .season-badge.off { background: #f2f2f2; color: #0a0a0a; }
      .weather-data { display: flex; flex-direction: column; gap: 8px; font-family: 'Plus Jakarta Sans', monospace; font-size: 13px; }
      .weather-row {
        display: flex;
        justify-content: space-between;
        border-bottom: 1px solid #e5e5e5;
        padding-bottom: 4px;
      }
      .weather-row:last-child { border-bottom: none; padding-bottom: 0; }
      .weather-label { color: #737373; }
      .weather-value { color: #0a0a0a; }

      /* ── Resource Cards ────────────────────────────────── */
      .resource-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 16px;
      }
      @media (min-width: 640px) { .resource-grid { grid-template-columns: repeat(4, 1fr); } }
      .resource-card {
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        padding: 16px;
        background: #ffffff;
        display: flex;
        flex-direction: column;
        gap: 12px;
        transition: border-color 0.2s;
      }
      .resource-card:hover { border-color: #0a0a0a; }
      .resource-icon {
        width: 40px;
        height: 40px;
        background: #f2f2f2;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .resource-icon svg { color: #0a0a0a; width: 20px; height: 20px; }
      .resource-card h4 { font-size: 14px; font-weight: 600; margin-bottom: 4px; }
      .resource-card p { font-size: 12px; color: #737373; }

      /* ── Testimonials ──────────────────────────────────── */
      .testimonial-grid {
        display: flex;
        flex-direction: column;
        gap: 24px;
      }
      @media (min-width: 640px) { .testimonial-grid { flex-direction: row; } }
      .testimonial-card {
        flex: 1;
        display: flex;
        gap: 16px;
        align-items: flex-start;
      }
      .test-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #f2f2f2;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
      }
      .test-avatar svg { color: #737373; width: 20px; height: 20px; }
      .testimonial-card blockquote {
        font-size: 14px;
        color: #0a0a0a;
        line-height: 1.43;
        font-style: italic;
        margin-bottom: 8px;
      }
      .testimonial-card cite {
        font-size: 12px;
        font-weight: 600;
        font-style: normal;
      }

      /* ── Split section ─────────────────────────────────── */
      .split-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 48px;
      }
      @media (min-width: 1024px) { .split-grid { grid-template-columns: 1fr 1fr; } }
      .split-col h2 {
        font-size: 18px;
        font-weight: 600;
        letter-spacing: -0.025em;
        margin-bottom: 16px;
      }
      .itinerary-list { display: flex; flex-direction: column; gap: 8px; }
      .itinerary-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 16px;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        transition: border-color 0.2s;
        background: #ffffff;
      }
      .itinerary-item:hover { border-color: #0a0a0a; }
      .itinerary-item .ii-badge {
        display: inline-flex;
        align-items: center;
        background: #f2f2f2;
        padding: 4px 10px;
        border-radius: 26px;
        font-size: 12px;
        font-weight: 500;
        color: #0a0a0a;
        margin-bottom: 4px;
      }
      .itinerary-item h3 { font-size: 16px; font-weight: 600; }
      .itinerary-item p { font-size: 13px; color: #737373; margin-top: 4px; }
      .itinerary-item svg { color: #737373; flex-shrink: 0; transition: color 0.2s; }
      .itinerary-item:hover svg { color: #0a0a0a; }

      .ref-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 8px;
      }
      .ref-item {
        padding: 12px;
        border: 1px solid #e5e5e5;
        border-radius: 14px;
        display: flex;
        align-items: center;
        gap: 12px;
        transition: border-color 0.2s;
        background: #ffffff;
      }
      .ref-item:hover { border-color: #0a0a0a; }
      .ref-icon {
        width: 32px;
        height: 32px;
        background: #f2f2f2;
        border-radius: 4px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }
      .ref-icon svg { color: #0a0a0a; width: 14px; height: 14px; }
      .ref-item span { font-size: 14px; font-weight: 500; }

      /* ── Section borders ──────────────────────────────── */
      .section-bordered { border-bottom: 1px solid #e5e5e5; }
      .section-bordered-y { border-top: 1px solid #e5e5e5; border-bottom: 1px solid #e5e5e5; }

      /* ── Responsive ────────────────────────────────────── */
      @media (max-width: 640px) {
        .hero h1 { font-size: 32px; letter-spacing: -0.04em; }
        .hero { padding: 32px 24px 32px; }
        .section { padding: 32px 24px; }

      }
    </style>
  </head>
  <body>

    <NavCmstourup lang={lang} variant="home" />

    <main style="flex:1">
      <!-- ════ Hero ════ -->
      <section class="hero">
        <h1>{t(
          "Conocimiento profundo para viajeros exigentes.",
          "Deep knowledge for discerning travelers."
        )}</h1>
        <p>{t(
          "Explora nuestras guías documentadas sobre la historia, arquitectura y naturaleza de los Andes peruanos. Diseñado para quienes buscan entender antes de visitar.",
          "Explore our documented guides on the history, architecture and nature of the Peruvian Andes. Designed for those who seek to understand before visiting."
        )}</p>
        <div class="hero-actions">
          <a href={`/${lang}/#destinos`} class="btn-primary">{t("Explorar guías", "Explore guides")}</a>
          <a href={`/${lang}/ai-prompts/`} class="btn-outline">{t("Leer el manifiesto", "Read the manifesto")}</a>
        </div>
      </section>

      <!-- ════ Destinos Grid ════ -->
      <section class="section section-bordered" id="destinos">
        <div class="section-header">
          <h2>{t("Guías de Destino", "Destination Guides")}</h2>
          <a href={`/${lang}/empresas/`} class="section-link">{t("Ver todo el directorio →", "View full directory →")}</a>
        </div>
        <div class="dest-grid">
          {featuredDestinos.map(d => (
            <a href={`/${lang}/peru/${d.id.replace('.md', '')}/`} class="dest-card">
              <div class="dest-card-img">
                <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24">
                  <path d="M12 22s-8-4.5-8-11.8A8 8 0 0 1 12 2a8 8 0 0 1 8 8.2c0 7.3-8 11.8-8 11.8z"></path><circle cx="12" cy="10" r="3"></circle>
                </svg>
              </div>
              <div class="dest-card-body">
                <div class="dest-card-top">
                  <span class="dest-badge">{t("Guía Completa", "Full Guide")}</span>
                  <span class="dest-readtime">{readingTime(d.data.summary)} min {t("lectura", "read")}</span>
                </div>
                <h3>{d.data.name}</h3>
                <p>{d.data.summary}</p>
              </div>
            </a>
          ))}
        </div>
      </section>

      <!-- ════ Featured Articles ════ -->
      <section class="section section-bordered">
        <div class="section-header">
          <h2>{t("Lecturas Destacadas", "Featured Reading")}</h2>
          <a href={`/${lang}/blog/`} class="section-link">{t("Ver todo →", "View all →")}</a>
        </div>
        <div class="featured-grid">
          <!-- Large featured -->
          <a href={recentPosts.length > 0 ? `/blog/${recentPosts[0].id}/` : '#'} class="featured-large">
            <div class="feat-img-wrap">
              <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline>
              </svg>
            </div>
            <div class="feat-body">
              <span class="feat-badge">{t("Reportaje de Campo", "Field Report")}</span>
              {recentPosts.length > 0 ? (
                <>
                  <h3>{recentPosts[0].data.title}</h3>
                  <p>{recentPosts[0].data.description}</p>
                  <div class="feat-meta">
                    <span><svg fill="none" height="14" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24" width="14" style="display:inline;vertical-align:middle"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg> {readingTime(recentPosts[0].data.description)} min</span>
                    <span>{t("Por el Equipo Editorial", "By the Editorial Team")}</span>
                  </div>
                </>
              ) : (
                <p>{t("Próximamente nuevo contenido", "New content coming soon")}</p>
              )}
            </div>
          </a>

          <!-- Article list -->
          <div class="feat-list">
            {recentPosts.slice(1, 3).map(p => (
              <a href={`/blog/${p.id}/`} class="feat-item">
                <h4>{p.data.title}</h4>
                <p>{p.data.description}</p>
                <span class="feat-item-tag">{p.data.tags?.[0] || t("Artículo", "Article")}</span>
              </a>
            ))}
            {prompts.length > 0 && (
              <a href={`/${lang}/ai-prompts/${prompts[0].id}/`} class="feat-item">
                <h4>{prompts[0].data.title}</h4>
                <p>{prompts[0].data.summary}</p>
                <span class="feat-item-tag">{t("Prompt IA", "AI Prompt")}</span>
              </a>
            )}
          </div>
        </div>
      </section>

      <!-- ════ Seasonal Analysis ════ -->
      <section class="section section-bordered">
        <h2 class="section-header" style="border:none;margin-bottom:24px">{t("Análisis de Destinos", "Destination Analysis")}</h2>
        <div class="weather-grid">
          {sortedDestinos.slice(0, 3).map(d => (
            <div class="weather-card">
              <div class="weather-head">
                <h3>{d.data.name}</h3>
                <span class="season-badge">{t("Temporada Alta", "High Season")}</span>
              </div>
              <div class="weather-data">
                <div class="weather-row">
                  <span class="weather-label">{t("Región", "Region")}</span>
                  <span class="weather-value">{d.data.region || t("Andes", "Andes")}</span>
                </div>
                <div class="weather-row">
                  <span class="weather-label">{t("Tipo", "Type")}</span>
                  <span class="weather-value">{t("Destino Cultural", "Cultural Destination")}</span>
                </div>
                <div class="weather-row">
                  <span class="weather-label">{t("Cobertura", "Coverage")}</span>
                  <span class="weather-value">∞</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- ════ Researcher Resources ════ -->
      <section class="section section-bordered">
        <h2 class="section-header" style="border:none;margin-bottom:24px">{t("Recursos para el Investigador", "Researcher Resources")}</h2>
        <div class="resource-grid">
          <a href={`/${lang}/ai-prompts/`} class="resource-card">
            <div class="resource-icon">
              <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
                <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" x2="8" y1="13" y2="13"></line><line x1="16" x2="8" y1="17" y2="17"></line>
              </svg>
            </div>
            <h4>{t("Biblioteca de Prompts", "Prompt Library")}</h4>
            <p>{t("PDF • Documentación IA", "PDF • AI Documentation")}</p>
          </a>
          <a href={`/${lang}/empresas/`} class="resource-card">
            <div class="resource-icon">
              <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
