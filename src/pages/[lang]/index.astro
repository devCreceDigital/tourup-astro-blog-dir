            <h4>{t("Directorio de Empresas", "Company Directory")}</h4>
            <p>{t("PDF • {n} operadores", "PDF • {n} operators").replace('{n}', companies.length.toString())}</p>
          </a>
          <a href={`/${lang}/peru/itinerario-7-dias/`} class="resource-card">
            <div class="resource-icon">
              <svg fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" viewBox="0 0 24 24">
