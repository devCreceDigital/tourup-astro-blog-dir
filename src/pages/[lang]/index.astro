              <cite>{t("Elena R. — Investigadora", "Elena R. — Researcher")}</cite>
            </div>
          </div>
        </div>
      </section>

      <!-- ════ Itineraries & Support ════ -->
      <section class="section">
        <div class="split-grid">
          <div class="split-col">
            <h2>{t("Marcos de Itinerario", "Itinerary Frameworks")}</h2>
            <div class="itinerary-list">
              <a href={`/${lang}/peru/itinerario-7-dias/`} class="itinerary-item">
                <div>
                  <span class="ii-badge">{t("Itinerario de 7 días", "7-Day Itinerary")}</span>
