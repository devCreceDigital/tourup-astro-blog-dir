---
import { getCollection } from 'astro:content';
import NavCmstourup from '../../../../../components/NavCmstourup.astro';
import FooterCmstourup from '../../../../../components/FooterCmstourup.astro';
import SettingsHead from '../../../../../components/SettingsHead.astro';
import SettingsBodyEnd from '../../../../../components/SettingsBodyEnd.astro';
import '../../../../../styles/theme.css';

export async function getStaticPaths() {
  const allCatDest = await getCollection('categorias_destino');
  const paths = [];
  for (const cd of allCatDest) {
    paths.push({
      params: { lang: 'en', slug: cd.data.destino_slug, categoria: cd.data.categoria },
      props: { cd, lang: 'en' },
    });
    paths.push({
      params: { lang: 'es', slug: cd.data.destino_slug, categoria: cd.data.categoria },
      props: { cd, lang: 'es' },
    });
  }
  return paths;
}

interface Props {
  cd: any;
  lang: string;
}

const { cd, lang } = Astro.props;
const { Content } = await cd.render();

const slug = cd.data.destino_slug;
const categoria = cd.data.categoria;

const allCompanies = await getCollection('companies');
const allDestinos = await getCollection('destinos');

const destino = allDestinos.find((d) => d.id.replace('.md', '') === slug);

const companies = allCompanies.filter(
  (c) =>
    c.data.destinos?.includes(slug) &&
    c.data.categorias?.includes(categoria)
);

const seenTaxIds = new Set<string>();
const deduped: typeof companies = [];
for (const c of companies) {
  const tid = c.data.regulation?.tax_id;
  if (!tid) { deduped.push(c); continue; }
  if (!seenTaxIds.has(tid)) { seenTaxIds.add(tid); deduped.push(c); }
}

const siteUrl = 'https://guia.tourup.co';

const categoriaJsonLd = cd.data.faq?.length > 0 ? {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'FAQPage',
      mainEntity: cd.data.faq.map((item: any) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
} : null;

const t = (es: string, en: string) => lang === 'en' ? en : es;
---

<!doctype html>
<html class="light" lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SettingsHead
      title={`${cd.data.name} – TourUp Peru`}
      description={cd.data.summary}
      currentPath={`/${lang}/peru/${slug}/tours/${categoria}/`}
      lang={lang}
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <meta name="robots" content="index, follow" />
    {categoriaJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(categoriaJsonLd)} />
    )}
  </head>

  <body>

    <NavCmstourup lang={lang} toursSlug={slug} />

    <main class="main-content">

      <!-- Breadcrumbs -->
      <div class="breadcrumbs">
        <a href="/" class="bc-link">{t('Inicio', 'Home')}</a>
        <span class="material-symbols-outlined bc-chevron">chevron_right</span>
        <a href={`/${lang}/peru/`} class="bc-link">{t('Perú', 'Peru')}</a>
        <span class="material-symbols-outlined bc-chevron">chevron_right</span>
        <a href={`/${lang}/peru/${slug}/`} class="bc-link">{destino?.data.name || slug}</a>
        <span class="material-symbols-outlined bc-chevron">chevron_right</span>
        <a href={`/${lang}/peru/${slug}/tours/`} class="bc-link">{t('Tours', 'Tours')}</a>
        <span class="material-symbols-outlined bc-chevron">chevron_right</span>
        <span class="bc-current">{cd.data.name}</span>
      </div>

      <!-- Meta tags -->
      <div class="meta-tags">
        <span class="tag tag-fill">{deduped.length} {t(`empresa${deduped.length !== 1 ? 's' : ''}`, `compan${deduped.length !== 1 ? 'ies' : 'y'}`)}</span>
        <span class="tag">{destino?.data.name || slug}</span>
      </div>

      <!-- Title -->
      <h1 class="page-title">
        {cd.data.name}
      </h1>

      <!-- Summary -->
      <p class="page-summary">
        {cd.data.summary}
      </p>

      <!-- Content -->
      <article class="article-card">
        <div class="article-accent"></div>
        <div class="article-body prose">
          <Content />
        </div>
      </article>

      <!-- FAQ -->
      {cd.data.faq && cd.data.faq.length > 0 && (
        <article class="article-card">
          <div class="article-accent"></div>
          <h2 class="article-heading">{t('Preguntas Frecuentes', 'Frequently Asked Questions')}</h2>
          <div class="faq-list">
            {cd.data.faq.map((item: any, i: number) => (
              <div class={`faq-item ${i > 0 ? 'faq-item-bordered' : ''}`}>
                <h3 class="faq-q">{item.question}</h3>
                <p class="faq-a">{item.answer}</p>
              </div>
            ))}
          </div>
        </article>
      )}

      <!-- Companies -->
      <article class="article-card">
        <div class="article-accent"></div>
        <h2 class="article-heading">{t(`Empresas que ofrecen ${cd.data.name}`, `Companies offering ${cd.data.name}`)}</h2>
        <div class="company-grid">
          {deduped.length === 0 ? (
            <p class="empty-msg">{t('No se encontraron empresas para esta categoría en este destino.', 'No companies found for this category in this destination.')}</p>
          ) : (
            deduped.map((company) => {
              const companySlug = company.slug.replace(/^\/company\//, '');
              return (
                <a href={`/${lang === 'en' ? 'companies' : 'empresas'}/${companySlug}/`}
                  class="company-card">
                  <span class="company-name">{company.data.title}</span>
                  <span class="company-desc">{company.data.summary}</span>
                  <div class="company-tags">
                    {company.data.distribution_role && (
                      <span class="company-tag">{company.data.distribution_role}</span>
                    )}
                    {company.data.nap?.city && (
                      <span class="company-tag">{company.data.nap.city}</span>
                    )}
                  </div>
                </a>
              );
            })
          )}
        </div>
      </article>

      <!-- Back link -->
      <div class="back-link-wrap">
        <a href={`/${lang}/peru/${slug}/tours/`} class="back-link">
          <span class="material-symbols-outlined back-link-icon">arrow_back</span>
          {t(`Volver a todos los tours en ${destino?.data.name || slug}`, `Back to all tours in ${destino?.data.name || slug}`)}
        </a>
      </div>

    </main>

    <FooterCmstourup lang={lang} />
    <SettingsBodyEnd />

  </body>
</html>

<style is:global>
  * { margin: 0; padding: 0; box-sizing: border-box; }

  body {
    font-family: 'Plus Jakarta Sans', sans-serif;
    color: var(--color-on-surface);
    background: var(--color-surface);
    min-height: 100vh;
  }

  .main-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 48px 16px;
  }

  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.75rem;
    color: #3e4851;
    margin-bottom: 32px;
    flex-wrap: wrap;
  }

  .bc-link {
    color: #3e4851;
    text-decoration: none;
    transition: color 0.15s;
  }

  .bc-link:hover { color: #1b1b1d; }

  .bc-chevron {
    font-size: 14px !important;
    line-height: 1;
  }

  .bc-current {
    font-weight: 600;
    color: #1b1b1d;
  }

  .meta-tags {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    flex-wrap: wrap;
  }

  .tag {
    border: 1px solid #e4e2e4;
    border-radius: 9999px;
    padding: 4px 12px;
    font-size: 0.75rem;
    color: #3e4851;
  }

  .tag-fill {
    background: #f0edef;
  }

  .page-title {
    font-size: 28px;
    font-weight: 700;
    letter-spacing: normal;
    color: #1b1b1d;
    line-height: 36px;
    max-width: 48rem;
    margin-bottom: 16px;
  }

  @media (min-width: 768px) {
    .page-title {
      font-size: 48px;
      font-weight: 800;
      letter-spacing: -0.02em;
      line-height: 56px;
    }
  }

  .page-summary {
    font-size: 0.875rem;
    color: #3e4851;
    max-width: 40rem;
    margin-bottom: 40px;
    line-height: 1.625;
  }

  .article-card {
    background: #ffffff;
    border: 1px solid #e4e2e4;
    border-radius: 0.75rem;
    padding: 24px;
    position: relative;
    overflow: hidden;
    margin-bottom: 32px;
  }

  .article-accent {
    position: absolute;
    left: 0;
    top: 24px;
    bottom: 24px;
    width: 4px;
    background: var(--color-primary);
    border-radius: 0 2px 2px 0;
  }

  .article-heading {
    font-size: 24px;
    font-weight: 700;
    line-height: 32px;
    color: #1b1b1d;
    margin-bottom: 24px;
    padding-left: 16px;
    display: flex;
    align-items: center;
    gap: 8px;
    letter-spacing: normal;
  }

  .article-body {
    padding-left: 16px;
  }

  .faq-list {
    padding-left: 16px;
    display: flex;
    flex-direction: column;
  }

  .faq-item {
    padding: 20px 0;
  }

  .faq-item-bordered {
    border-top: 1px solid #e4e2e4;
  }

  .faq-q {
    font-size: 0.875rem;
    font-weight: 500;
    color: #1b1b1d;
    margin-bottom: 8px;
  }

  .faq-a {
    font-size: 0.875rem;
    color: #3e4851;
    line-height: 1.625;
  }

  .company-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }

  @media (min-width: 640px) {
    .company-grid { grid-template-columns: repeat(2, 1fr); }
  }

  .company-card {
    display: flex;
    flex-direction: column;
    gap: 4px;
    border: 1px solid #e4e2e4;
    border-radius: 8px;
    padding: 16px;
    text-decoration: none;
    transition: border-color 0.15s, background 0.15s;
  }

  .company-card:hover {
    border-color: var(--color-primary);
    background: #fcf8fb;
  }

  .company-name {
    font-size: 0.875rem;
    font-weight: 500;
    color: #1b1b1d;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .company-card:hover .company-name {
    text-decoration: underline;
  }

  .company-desc {
    font-size: 0.75rem;
    color: #6e7882;
    display: -webkit-inline-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    line-height: 1.625;
  }

  .company-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    margin-top: 4px;
  }

  .company-tag {
    font-size: 10px;
    background: #f0edef;
    color: #3e4851;
    border: 1px solid #e4e2e4;
    padding: 2px 8px;
    border-radius: 9999px;
  }

  .empty-msg {
    font-size: 0.875rem;
    color: #6e7882;
    font-style: italic;
  }

  .back-link-wrap {
    margin-top: 32px;
  }

  .back-link {
    font-size: 0.875rem;
    color: #3e4851;
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    transition: color 0.15s;
  }

  .back-link:hover { color: #1b1b1d; }

  .back-link-icon {
    font-size: 14px !important;
  }



  /* Prose styles for rendered markdown */
  .prose h2 {
    font-size: 1rem;
    font-weight: 600;
    color: #1b1b1d;
    margin-top: 1.25rem;
    margin-bottom: 0.5rem;
    letter-spacing: -0.025em;
  }
  .prose h3 {
    font-size: 0.875rem;
    font-weight: 600;
    color: #1b1b1d;
    margin-top: 1rem;
    margin-bottom: 0.375rem;
  }
  .prose p {
    font-size: 0.875rem;
    color: #3e4851;
    line-height: 1.6;
    margin-bottom: 0.75rem;
  }
  .prose ul {
    margin-bottom: 0.75rem;
    padding-left: 1.25rem;
  }
  .prose li {
    font-size: 0.875rem;
    color: #3e4851;
    margin-bottom: 0.375rem;
    line-height: 1.5;
  }
  .prose strong {
    color: #1b1b1d;
    font-weight: 600;
  }
  .prose a {
    color: #1b1b1d;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose a:hover {
    color: #3e4851;
  }
</style>
