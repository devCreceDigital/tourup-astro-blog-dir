---
import { getCollection } from 'astro:content';
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  const destinos = await getCollection('destinos');
  const destinosEn = await getCollection('destinos_en');
  const paths = [
    ...destinos.map((d) => ({
      params: { lang: 'es', slug: d.id.replace('.md', '') },
      props: { entry: d, lang: 'es' },
    })),
    ...destinosEn.map((d) => ({
      params: { lang: 'en', slug: d.id.replace('.md', '') },
      props: { entry: d, lang: 'en' },
    })),
  ];
  return paths;
}

function stripMd(id: string) {
  return id.replace(/\.md$/i, '');
}

interface Props {
  entry: any;
  lang: string;
}

const { entry, lang } = Astro.props;
const { Content } = await entry.render();
const d = entry.data;

const siteUrl = 'https://tourup.co';
const slug = stripMd(entry.id);
const isCountry = slug === 'peru';
const schemaType = isCountry ? 'Country' : 'TouristAttraction';

const allCompanies = await getCollection('companies');
const allCatDest = await getCollection('categorias_destino');

const tourCategories = allCatDest
  .filter((cd) => cd.data.destino_slug === slug);

const companies = allCompanies.filter(
  (c) => c.data.destinos && c.data.destinos.includes(slug)
);

// Dedup by tax_id — prefer entry matching current destino
const seenTaxIds = new Set<string>();
const deduped: typeof companies = [];
for (const c of companies) {
  const tid = c.data.regulation?.tax_id;
  if (!tid) { deduped.push(c); continue; }
  if (!seenTaxIds.has(tid)) { seenTaxIds.add(tid); deduped.push(c); }
}

const companiesByCategory: Record<string, any[]> = {};
for (const company of deduped) {
  if (company.data.categorias) {
    for (const cat of company.data.categorias) {
      if (!companiesByCategory[cat]) companiesByCategory[cat] = [];
      if (!companiesByCategory[cat].find((c) => c.slug === company.slug)) {
        companiesByCategory[cat].push(company);
      }
    }
  }
}

const destFaq = d.faq || [];
const catNames = tourCategories.map((cd) => cd.data.name);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': schemaType,
      name: d.name,
      description: d.summary,
      url: `${siteUrl}/${lang}/peru/${slug}/`,
      ...(isCountry
        ? { containsPlace: catNames.map((c) => ({ '@type': 'Place', name: c })) }
        : { containedInPlace: { '@type': 'Country', name: 'PE' }, touristType: catNames }),
    },
    ...(destFaq.length > 0
      ? [{
          '@type': 'FAQPage',
          mainEntity: destFaq.map((item: any) => ({
            '@type': 'Question',
            name: item.question,
            acceptedAnswer: { '@type': 'Answer', text: item.answer },
          })),
        }]
      : []),
  ],
};
---

<Layout
  title={d.seo_title || `${d.name} – TourUp Peru`}
  description={d.summary}
  currentPath={`/${lang}/peru/${slug}/`}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd, null, 2)} />

  <article class="destino-page">
    <header class="destino-header">
      <nav class="breadcrumbs">
        <a href="/">{lang === 'en' ? 'Home' : 'Inicio'}</a>
        <span>/</span>
        <a href={`/${lang}/ai-prompts/`}>Peru</a>
        <span>/</span>
        <span>{d.name}</span>
      </nav>
      <h1>{d.name}</h1>
      <p class="destino-summary">{d.summary}</p>
      <div class="destino-meta">
        {d.region && <span class="badge">{d.region}</span>}
        <span class="badge secondary">{deduped.length} {lang === 'en' ? `compan${deduped.length !== 1 ? 'ies' : 'y'}` : `empresa${deduped.length !== 1 ? 's' : ''}`}</span>
        <span class="badge tertiary">{tourCategories.length} {lang === 'en' ? 'categories' : 'categorías'}</span>
        {companies.length - deduped.length > 0 && <span class="badge" style="background:rgba(234,179,8,0.1);color:#eab308;border-color:rgba(234,179,8,0.2)">{companies.length - deduped.length} {lang === 'en' ? 'duplicates removed' : 'duplicados eliminados'}</span>}
      </div>
    </header>

    <section class="destino-content">
      <Content />
    </section>

    {tourCategories.length > 0 && (
      <section class="categories-section">
        <h2>{lang === 'en' ? 'Tour Categories in' : 'Categorías de tour en'} {d.name}</h2>
        <div class="categories-grid">
          {tourCategories.map((cd) => {
            const count = companiesByCategory[cd.data.categoria]?.length || 0;
            return (
              <a href={`/${lang}/peru/${slug}/tours/${cd.data.categoria}/`} class="category-card">
                <h3>{cd.data.name}</h3>
                <p>{cd.data.summary}</p>
                <span class="company-count">{count} {lang === 'en' ? `compan${count !== 1 ? 'ies' : 'y'}` : `empresa${count !== 1 ? 's' : ''}`}</span>
              </a>
            );
          })}
        </div>
      </section>
    )}

    {deduped.length > 0 && (
      <section class="companies-section">
        <h2>{lang === 'en' ? 'Tour Operators in' : 'Operadores Turísticos en'} {d.name}</h2>
        <div class="companies-grid">
          {deduped.map((c: any) => (
            <a href={`/${lang === 'en' ? 'companies' : 'empresas'}/${c.id}/`} class="company-card">
              <h3>{c.data.title}</h3>
              <p>{c.data.summary}</p>
              <div class="company-meta">
                <span class="badge">{c.data.distribution_role}</span>
                {c.data.categorias?.slice(0, 3).map((cat: string) => (
                  <span class="tag">{cat}</span>
                ))}
              </div>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .destino-page { max-width: 1000px; margin: 0 auto; padding: 2rem 0; }
  .destino-header { border-bottom: 1px solid var(--color-border); padding-bottom: 2rem; margin-bottom: 2rem; }
  .breadcrumbs { display: flex; gap: 0.5rem; align-items: center; margin-bottom: 1.5rem; font-size: 0.85rem; color: #64748b; }
  .breadcrumbs a { color: #06b6d4; }
  .breadcrumbs span { color: #64748b; }
  .destino-page h1 { font-size: 2.5rem; margin-bottom: 1rem; color: #f1f5f9; }
  .destino-summary { font-size: 1.1rem; color: #cbd5e1; line-height: 1.8; margin-bottom: 1rem; }
  .destino-meta { display: flex; gap: 0.75rem; flex-wrap: wrap; }
  .badge { display: inline-block; background: rgba(59, 130, 246, 0.1); color: #3b82f6; padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.8rem; border: 1px solid rgba(59, 130, 246, 0.2); text-transform: uppercase; letter-spacing: 0.05em; }
  .badge.secondary { background: rgba(6, 182, 212, 0.1); color: #06b6d4; border-color: rgba(6, 182, 212, 0.2); }
  .badge.tertiary { background: rgba(168, 85, 247, 0.1); color: #c084fc; border-color: rgba(168, 85, 247, 0.2); }
  .destino-content { font-size: 1rem; line-height: 1.8; color: #cbd5e1; margin-bottom: 3rem; }
  .destino-content :global(h2) { font-size: 1.5rem; margin: 1.5rem 0 1rem; color: #f1f5f9; }
  .destino-content :global(ul) { margin-bottom: 1rem; padding-left: 1.5rem; }
  .destino-content :global(li) { margin-bottom: 0.5rem; }
  .categories-section { margin-bottom: 3rem; }
  .categories-section h2 { margin-bottom: 1.5rem; }
  .categories-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 1.5rem; }
  .category-card { display: block; background: rgba(30, 41, 59, 0.5); border: 1px solid var(--color-border); border-radius: 0.75rem; padding: 1.5rem; text-decoration: none; transition: all 0.3s ease; }
  .category-card:hover { border-color: #06b6d4; transform: translateY(-5px); background: rgba(30, 41, 59, 0.8); }
  .category-card h3 { font-size: 1.1rem; color: #06b6d4; margin-bottom: 0.75rem; }
  .category-card p { font-size: 0.9rem; color: #94a3b8; line-height: 1.6; margin-bottom: 1rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .company-count { font-size: 0.85rem; color: #3b82f6; font-weight: 600; }
  .companies-section { margin-bottom: 3rem; }
  .companies-section h2 { margin-bottom: 1.5rem; }
  .companies-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 1.5rem; }
  .company-card { display: block; background: rgba(30, 41, 59, 0.5); border: 1px solid var(--color-border); border-radius: 0.75rem; padding: 1.5rem; text-decoration: none; transition: all 0.3s ease; }
  .company-card:hover { border-color: #3b82f6; transform: translateY(-3px); background: rgba(30, 41, 59, 0.8); }
  .company-card h3 { font-size: 1rem; color: #f1f5f9; margin-bottom: 0.5rem; }
  .company-card p { font-size: 0.85rem; color: #94a3b8; line-height: 1.5; margin-bottom: 0.75rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .company-card .company-meta { display: flex; gap: 0.5rem; flex-wrap: wrap; align-items: center; }
  .tag { display: inline-block; background: rgba(100, 116, 139, 0.15); color: #94a3b8; border: 1px solid rgba(100, 116, 139, 0.2); padding: 0.15rem 0.5rem; border-radius: 9999px; font-size: 0.7rem; }
  @media (max-width: 768px) {
    .destino-page h1 { font-size: 1.75rem; }
    .destino-summary { font-size: 1rem; }
    .categories-grid, .companies-grid { grid-template-columns: 1fr; }
  }
</style>
