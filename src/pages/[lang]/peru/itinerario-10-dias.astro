---
import Layout from '../../../layouts/Layout.astro';

export async function getStaticPaths() {
  return [
    { params: { lang: 'en' }, props: { lang: 'en' } },
    { params: { lang: 'es' }, props: { lang: 'es' } },
  ];
}

interface Props { lang: string; }
const { lang } = Astro.props;

const t = (es: string, en: string) => lang === 'en' ? en : es;
const siteUrl = 'https://guia.tourup.co';
const currentPath = `/${lang}/peru/itinerario-10-dias/`;
const canonicalUrl = `${siteUrl}${currentPath}`;

const pageTitle = t(
  "Itinerario de 10 días por Perú: Lima, Cusco, Valle Sagrado, Machu Picchu y Arequipa",
  "10-Day Peru Itinerary: Lima, Cusco, Sacred Valley, Machu Picchu & Arequipa"
);

const pageDesc = t(
  "Itinerario completo de 10 días por Perú recorriendo Lima, Cusco, Valle Sagrado, Machu Picchu y Arequipa. Presupuesto, día a día y variantes.",
  "Complete 10-day Peru itinerary covering Lima, Cusco, Sacred Valley, Machu Picchu & Arequipa. Budget, day-by-day, and variations."
);
---
<Layout title={pageTitle}
      description={pageDesc}
      currentPath={currentPath}
      lang={lang}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Trip",
      "name": t("Itinerario de 10 días por Perú", "10-Day Peru Itinerary"),
      "description": t("Lima, Cusco, Valle Sagrado, Machu Picchu y Arequipa en 10 días", "Lima, Cusco, Sacred Valley, Machu Picchu & Arequipa in 10 days"),
      "itinerary": [
        { "@type": "City", "name": "Lima" },
        { "@type": "City", "name": "Cusco" },
        { "@type": "TouristAttraction", "name": "Machu Picchu" },
        { "@type": "City", "name": "Arequipa" }
      ]
    })} />

  <div class="main-grid">

      <div class="col-main">

        <section class="hero-section">
          <div class="breadcrumbs">
            <span>{t('Perú', 'Peru')}</span>
            <span class="bc-sep" aria-hidden="true">/</span>
            <span class="breadcrumb-current">{t('Itinerario 10 días', '10-Day Itinerary')}</span>
            <span class="bc-sep" aria-hidden="true">/</span>
            <span class="breadcrumb-path">/peru/itinerario-10-dias/</span>
          </div>

          <h1 class="hero-title">{pageTitle}</h1>

          <div class="tags-row">
            <span class="tag tag-fill">{t('Itinerario', 'Itinerary')}</span>
            <span class="tag">{t('Actualizada 2026', 'Updated 2026')}</span>
            <span class="tag">{t('Incluye FAQs', 'Includes FAQs')}</span>
          </div>

          <p class="hero-summary">{pageDesc}</p>

          <div class="hero-actions">
            <a href={`/${lang}/peru/cusco/tours/`} class="btn-primary">
              {t('Ver tours en Cusco', 'See tours in Cusco')}
            </a>
            <a href={`/${lang}/peru/itinerario-14-dias/`} class="btn-ghost">
              {t('Itinerario 14 días', '14-day itinerary')}
            </a>
          </div>

          <div class="hero-image">
            <img src="https://images.pexels.com/photos/3250613/pexels-photo-3250613.jpeg?auto=compress&cs=tinysrgb&w=1200" alt="Cusco, Perú" loading="eager" />
          </div>
        </section>

        <div class="cards-stack">

          <article class="card">
            <div class="card-accent"></div>
            <h2 class="card-title">
              {t('Resumen rápido: para quién es este itinerario', 'Quick Summary: Who This Itinerary is For')}
            </h2>
            <div class="card-body prose">
              <p>{t(
                'Este itinerario de 10 días es el más equilibrado para una primera visita a Perú. Combina la capital gastronómica (Lima), el corazón del Imperio Inca (Cusco y Valle Sagrado), la maravilla arqueológica (Machu Picchu) y la Ciudad Blanca (Arequipa) con el Cañón del Colca. Es ideal para viajeros que buscan una experiencia completa sin prisas extremas.',
                'This 10-day itinerary is the most balanced for a first visit to Peru. It combines the gastronomic capital (Lima), the heart of the Inca Empire (Cusco and Sacred Valley), the archaeological wonder (Machu Picchu) and the White City (Arequipa) with Colca Canyon. Ideal for travelers seeking a complete experience without extreme rushing.'
              )}</p>
            </div>
          </article>

          <article class="card">
            <div class="card-accent"></div>
            <h2 class="card-title">
              {t('Día a día', 'Day by Day')}
            </h2>
            <div class="card-body itinerary-list">

              <div class="it-day">
                <span class="it-day-label">{t('Día 1', 'Day 1')}</span>
                <h3>{t('Llegada a Lima', 'Arrival in Lima')}</h3>
                <p>{t(
                  'Llegada al Aeropuerto Internacional Jorge Chávez. Traslado al hotel en Miraflores. Tarde libre para descansar del vuelo. Cena de bienvenida en el distrito de Barranco con cocina peruana de autor.',
                  'Arrival at Jorge Chávez International Airport. Transfer to hotel in Miraflores. Free afternoon to rest from the flight. Welcome dinner in Barranco district with Peruvian fusion cuisine.'
                )}</p>
              </div>

              <div class="it-day">
                <span class="it-day-label">{t('Día 2', 'Day 2')}</span>
                <h3>{t('Lima — City tour y experiencia gastronómica', 'Lima — City Tour & Gastronomic Experience')}</h3>
                <p>{t(
                  'Mañana: recorrido por el Centro Histórico (Plaza Mayor, Catedral, Convento de San Francisco). Almuerzo en el Mercado de Surquillo con degustaciones. Tarde: visita al Museo Larco (cerámica precolombina) y recorrido por Miraflores (Huaca Pucllana, Malecón, Parque del Amor).',
                  'Morning: Historic Center tour (Plaza Mayor, Cathedral, San Francisco Convent). Lunch at Surquillo Market with tastings. Afternoon: Larco Museum (pre-Columbian ceramics) and Miraflores tour (Huaca Pucllana, Malecón, Parque del Amor).'
                )}</p>
              </div>

              <div class="it-day">
                <span class="it-day-label">{t('Día 3', 'Day 3')}</span>
                <h3>{t('Vuelo a Cusco — Aclimatación', 'Flight to Cusco — Acclimatization')}</h3>
                <p>{t(
                  'Vuelo matutino de Lima a Cusco (1 hora 10 minutos). Check-in en hotel en el centro histórico. Tarde ligera para aclimatación: caminata por la Plaza de Armas, visita a la Catedral y al Qoricancha (Templo del Sol). Infusión de mate de coca y descanso.',
                  'Morning flight Lima to Cusco (1h 10min). Check-in at historic center hotel. Light afternoon for acclimatization: walk through Plaza de Armas, visit Cathedral and Qoricancha (Temple of the Sun). Coca tea and rest.'
                )}</p>
              </div>

              <div class="it-day">
                <span class="it-day-label">{t('Día 4', 'Day 4')}</span>
                <h3>{t('Valle Sagrado de los Incas', 'Sacred Valley of the Incas')}</h3>
                <p>{t(
                  'Excursión de día completo. 8:00 am salida hacia Pisac (mercado artesanal y ruinas incas). Almuerzo buffet en Urubamba. Tarde: fortaleza de Ollantaytambo, terrazas agrícolas de Moray y salineras de Maras. Retorno a Cusco al atardecer.',
                  'Full-day excursion. 8:00 am departure to Pisac (craft market and Inca ruins). Buffet lunch in Urubamba. Afternoon: Ollantaytambo fortress, Moray agricultural terraces, and Maras salt mines. Return to Cusco at sunset.'
                )}</p>
              </div>

              <div class="it-day">
                <span class="it-day-label">{t('Día 5', 'Day 5')}</span>
                <h3>{t('Machu Picchu', 'Machu Picchu')}</h3>
                <p>{t(
                  'Salida 5:00 am hacia la estación de tren. Tren Expedition o Vistadome a Aguas Calientes (1.5 horas). Bus hacia la ciudadela. Visita guiada de 2.5 horas (Circuito 2: vista clásica). Tiempo libre para fotos. Almuerzo en Aguas Calientes. Tren de retorno a Cusco por la tarde.',
                  'Departure 5:00 am to train station. Expedition or Vistadome train to Aguas Calientes (1.5 hours). Bus to the citadel. Guided 2.5-hour tour (Circuit 2: classic view). Free time for photos. Lunch in Aguas Calientes. Return train to Cusco.'
                )}</p>
              </div>

              <div class="it-day">
                <span class="it-day-label">{t('Día 6', 'Day 6')}</span>
                <h3>{t('Montaña 7 Colores o día libre', 'Rainbow Mountain or Free Day')}</h3>
                <p>{t(
                  'Opción A: excursión a la Montaña de 7 Colores (Vinicunca, 5,200 msnm, full day, requiere condición física). Opción B: día libre en Cusco para visitar Sacsayhuamán, el barrio de San Blas y el Mercado de San Pedro. Por la tarde, vuelo de Cusco a Arequipa (1 hora).',
                  'Option A: excursion to Rainbow Mountain (Vinicunca, 17,000 ft / 5,200 m, full day, requires fitness). Option B: free day in Cusco to visit Sacsayhuamán, San Blas neighborhood, and San Pedro Market. Evening flight Cusco to Arequipa (1 hour).'
                )}</p>
              </div>

              <div class="it-day">
                <span class="it-day-label">{t('Día 7', 'Day 7')}</span>
                <h3>{t('Arequipa — City tour', 'Arequipa — City Tour')}</h3>
                <p>{t(
                  'Mañana: recorrido por la Plaza de Armas, la Catedral de sillar blanco y el Monasterio de Santa Catalina. Almuerzo con rocoto relleno o chupe de camarones. Tarde: Museo Santuarios Andinos (momía Juanita) y mirador de Yanahuara con vista al volcán Misti.',
                  'Morning: Plaza de Armas, the white sillar Cathedral, and Santa Catalina Monastery. Lunch with rocoto relleno or chupe de camarones. Afternoon: Andean Sanctuaries Museum (Juanita mummy) and Yanahuara viewpoint with Misti volcano views.'
                )}</p>
              </div>

              <div class="it-day">
                <span class="it-day-label">{t('Día 8', 'Day 8')}</span>
                <h3>{t('Cañón del Colca', 'Colca Canyon')}</h3>
                <p>{t(
                  'Salida 6:00 am hacia el Cañón del Colca. Ruta panorámica con paradas en miradores. Llegada a Chivay, almuerzo y visita a las aguas termales de la Calera. Pernocte en Chivay.',
                  'Departure 6:00 am to Colca Canyon. Scenic route with viewpoint stops. Arrival in Chivay, lunch and visit to La Calera hot springs. Overnight in Chivay or a valley lodge.'
                )}</p>
              </div>

              <div class="it-day">
                <span class="it-day-label">{t('Día 9', 'Day 9')}</span>
                <h3>{t('Cañón del Colca — Cruz del Cóndor y retorno', 'Colca Canyon — Cruz del Cóndor & Return')}</h3>
                <p>{t(
                  'Amanecer en el Cruz del Cóndor para presenciar el vuelo de los cóndores sobre el cañón (mejor vista entre 7:00 y 8:00 am). Retorno a Arequipa visitando pueblos coloniales y miradores. Llegada a Arequipa al atardecer.',
                  'Sunrise at Cruz del Cóndor to witness condors flying over the canyon (best view 7:00-8:00 am). Return to Arequipa visiting colonial towns and viewpoints. Arrival in Arequipa at sunset.'
                )}</p>
              </div>

              <div class="it-day">
                <span class="it-day-label">{t('Día 10', 'Day 10')}</span>
                <h3>{t('Retorno', 'Return')}</h3>
                <p>{t(
                  'Mañana libre para compras de artesanías en el centro de Arequipa. Vuelo de Arequipa a Lima. Conexión con vuelo internacional de retorno.',
                  'Free morning for crafts shopping in Arequipa\'s historic center. Flight Arequipa to Lima. Connection with international return flight.'
                )}</p>
              </div>

            </div>
          </article>

          <article class="card">
            <div class="card-accent"></div>
            <h2 class="card-title">
              {t('Presupuesto estimado por persona', 'Estimated Budget Per Person')}
            </h2>
            <div class="card-body">
              <ul class="budget-list">
                <li><strong>{t('Económico (1,200-1,500 USD):', 'Budget ($1,200-1,500 USD):')}</strong> {t('hostales y hoteles básicos, tours compartidos, comidas en mercados, tren Expedition.', 'hostels and basic hotels, shared tours, market meals, Expedition train.')}</li>
                <li><strong>{t('Estándar (1,800-2,400 USD):', 'Standard ($1,800-2,400 USD):')}</strong> {t('hoteles 3 estrellas, tours grupales con guía, tren Vistadome, restaurantes de gama media.', '3-star hotels, group tours with guide, Vistadome train, mid-range restaurants.')}</li>
                <li><strong>{t('Premium (desde 3,200 USD):', 'Premium (from $3,200 USD):')}</strong> {t('hoteles 4-5 estrellas, tours privados, tren Hiram Bingham, alta cocina, guía bilingüe permanente.', '4-5 star hotels, private tours, Hiram Bingham train, fine dining, permanent bilingual guide.')}</li>
              </ul>
            </div>
          </article>

          <article class="card">
            <div class="card-accent"></div>
            <h2 class="card-title">
              {t('Variantes posibles', 'Possible Variations')}
            </h2>
            <div class="card-body prose">
              <p>{t(
                'Si dispones de 12-14 días, puedes añadir Puno y el Lago Titicaca (3 días desde Arequipa). Otra variante es reemplazar Arequipa por la Amazonía de Puerto Maldonado (3 días en lodge amazónico). También puedes invertir el orden: empezar por Arequipa y terminar en Cusco para aclimatación gradual.',
                'If you have 12-14 days, add Puno and Lake Titicaca (3 days from Arequipa). Another variation: replace Arequipa with Puerto Maldonado Amazon (3 days in a jungle lodge). You can also reverse the order: start in Arequipa and end in Cusco for gradual altitude acclimatization.'
              )}</p>
            </div>
          </article>

          <article class="card">
            <div class="card-accent"></div>
            <h2 class="card-title">
              {t('Preguntas frecuentes', 'Frequently Asked Questions')}
            </h2>
            <div class="card-body faq-list">
              <div class="faq-item">
                <h3 class="faq-q">{t('¿Este itinerario de 10 días es muy apretado?', 'Is this 10-day itinerary too rushed?')}</h3>
                <p class="faq-a">{t(
                  'Es un ritmo activo pero manejable. Incluye 2-3 días por ciudad con desplazamientos mayormente en avión (1-1.5 horas). Los días 4 y 6-7 son los más intensos. Se recomienda buena condición física para las excursiones a Machu Picchu y Colca.',
                  'It\'s an active but manageable pace. Includes 2-3 days per city with mostly flights (1-1.5 hours). Days 4 and 6-7 are the most intense. Good physical condition recommended for Machu Picchu and Colca excursions.'
                )}</p>
              </div>
              <div class="faq-item faq-item-bordered">
                <h3 class="faq-q">{t('¿Qué ropa llevar para 10 días en Perú?', 'What clothes to pack for 10 days in Peru?')}</h3>
                <p class="faq-a">{t(
                  'Ropa en capas para clima variable: camisetas térmicas, polar ligero, chaqueta impermeable, pantalones de secado rápido, zapatos de caminata, sandalias, protector solar, sombrero, lentes de sol, traje de baño (para termas de Colca) y chaqueta abrigada para las noches frías en Cusco y Arequipa.',
                  'Layer clothing for variable weather: thermal shirts, light fleece, waterproof jacket, quick-dry pants, hiking shoes, sandals, sunscreen, hat, sunglasses, swimsuit (for Colca hot springs), and a warm jacket for cold nights in Cusco and Arequipa.'
                )}</p>
              </div>
              <div class="faq-item faq-item-bordered">
                <h3 class="faq-q">{t('¿Cuánto cuestan los vuelos internos?', 'How much do domestic flights cost?')}</h3>
                <p class="faq-a">{t(
                  'Lima-Cusco-Lima: 80-150 USD por tramo si se reserva con anticipación. Cusco-Arequipa: 60-100 USD. Se recomienda reservar todos los vuelos internos al mismo tiempo que el vuelo internacional para mejores tarifas.',
                  'Lima-Cusco-Lima: $80-150 per leg if booked in advance. Cusco-Arequipa: $60-100. Book all domestic flights simultaneously with the international flight for best rates.'
                )}</p>
              </div>
            </div>
          </article>

        </div>
      </div>

      <aside class="col-sidebar">

        <div class="sidebar-card">
          <span class="sidebar-label">{t('Tours Desde', 'Tours From')}</span>
          <div class="price-row">
            <span class="price-value">USD 89</span>
            <span class="price-unit">{t('/ persona', '/ person')}</span>
          </div>
          <a href={`/${lang}/peru/cusco/tours/`} class="btn-primary btn-full">
            {t('Comparar tours', 'Compare tours')}
          </a>
          <p class="price-footnote">{t('Sin cargos ocultos · Cancelación flexible', 'No hidden fees · Flexible cancellation')}</p>
          <div class="meta-list">
            <div class="meta-row">
              <span class="meta-label">{t('Duración', 'Duration')}</span>
              <span class="meta-value">10 {t('días', 'days')}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{t('Ciudades', 'Cities')}</span>
              <span class="meta-value">4</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{t('Dificultad', 'Difficulty')}</span>
              <span class="meta-value">{t('Media-Alta', 'Moderate-High')}</span>
            </div>
            <div class="meta-row">
              <span class="meta-label">{t('Mejor época', 'Best season')}</span>
              <span class="meta-value">{t('May – Oct', 'May – Oct')}</span>
            </div>
          </div>
        </div>

        <div class="sidebar-card sidebar-card-alt">
          <span class="sidebar-label">SCHEMA.ORG EN &lt;HEAD&gt;</span>
          <div class="schema-tags">
            <span class="schema-tag">Trip</span>
            <span class="schema-tag">Itinerary</span>
            <span class="schema-tag">BreadcrumbList</span>
            <span class="schema-tag">TouristTrip</span>
          </div>
        </div>

        <div class="sidebar-card sidebar-card-alt">
          <span class="sidebar-label">{t('VARIABLES ASTRO (AGENTE)', 'ASTRO VARIABLES (AGENT)')}</span>
          <div class="var-list">
            <div><span class="var-key">tipo_pagina:</span> <span class="var-val">"itinerario"</span></div>
            <div><span class="var-key">itinerario:</span> <span class="var-val">"10 días"</span></div>
            <div class="var-url"><span class="var-key">url:</span> <span class="var-val">"/peru/itinerario-10-dias/"</span></div>
            <div><span class="var-key">anio:</span> <span class="var-val">"2026"</span></div>
          </div>
        </div>

        <div class="sidebar-card">
          <span class="sidebar-label">{t('Links Internos', 'Internal Links')}</span>
          <ul class="internal-links">
            <li><a href={`/${lang}/peru/itinerario-7-dias/`} class="internal-link">/{lang}/peru/itinerario-7-dias/</a></li>
            <li><a href={`/${lang}/peru/itinerario-14-dias/`} class="internal-link">/{lang}/peru/itinerario-14-dias/</a></li>
            <li><a href={`/${lang}/peru/cusco/`} class="internal-link">/{lang}/peru/cusco/</a></li>
            <li><a href={`/${lang}/peru/arequipa/`} class="internal-link">/{lang}/peru/arequipa/</a></li>
          </ul>
        </div>

        <div class="sidebar-card">
          <span class="sidebar-label">{t('Destinos Relacionados', 'Related Destinations')}</span>
          <ul class="related-list">
            <li class="related-item related-item-bordered">
              <a href={`/${lang}/peru/cusco/`} class="related-link">Cusco</a>
              <span class="related-path">/peru/cusco/</span>
            </li>
            <li class="related-item related-item-bordered">
              <a href={`/${lang}/peru/lima/`} class="related-link">Lima</a>
              <span class="related-path">/peru/lima/</span>
            </li>
            <li class="related-item related-item-bordered">
              <a href={`/${lang}/peru/machu_picchu/`} class="related-link">Machu Picchu</a>
              <span class="related-path">/peru/machu_picchu/</span>
            </li>
            <li class="related-item">
              <a href={`/${lang}/peru/arequipa/`} class="related-link">Arequipa</a>
              <span class="related-path">/peru/arequipa/</span>
            </li>
          </ul>
        </div>

      </aside>
    </div>
</Layout>

<style>
.main-grid { max-width: 1200px; margin: 0 auto; padding: 48px 16px; display: grid; grid-template-columns: 1fr; gap: 32px; align-items: start; }
      @media (min-width: 1024px) { .main-grid { grid-template-columns: 8fr 4fr; gap: 32px; } }
      .breadcrumbs { display: flex; align-items: center; gap: 8px; font-size: 12px; color: #3e4851; }
      .breadcrumb-chevron { font-size: 14px !important; line-height: 1; }
      .breadcrumb-current { font-weight: 600; color: #1b1b1d; }
      .breadcrumb-path { color: #a6aab0; font-size: 12px; }
      .hero-section { display: flex; flex-direction: column; gap: 16px; }
      .hero-title { font-size: 28px; font-weight: 700; letter-spacing: normal; line-height: 36px; color: #1b1b1d; max-width: 768px; }
      @media (min-width: 768px) { .hero-title { font-size: 48px; font-weight: 800; letter-spacing: -0.02em; line-height: 56px; } }
      .tags-row { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
      .tag { border: 1px solid #e4e2e4; background: #fcf8fb; border-radius: 9999px; padding: 4px 12px; font-size: 12px; font-weight: 500; color: #3e4851; }
      .tag-fill { background: #f0edef; }
      .hero-summary { font-size: 14px; line-height: 1.43; color: #3e4851; max-width: 576px; margin-top: 16px; }
      .hero-actions { display: flex; flex-wrap: wrap; gap: 16px; margin-top: 16px; }
      .hero-image { width: 100%; margin-top: 24px; border-radius: 12px; border: 1px solid #e4e2e4; overflow: hidden; aspect-ratio: 16/9; background: #dcd9dc; }
      .hero-image img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1); opacity: 0.9; }
      .btn-primary { display: inline-block; background: var(--color-primary); color: #ffffff; border-radius: 8px; padding: 12px 24px; font-size: 14px; font-weight: 600; text-decoration: none; transition: background 0.1s; border: none; cursor: pointer; text-align: center; }
      .btn-primary:hover { background: var(--color-primary-hover); }
      .btn-ghost { display: inline-block; background: transparent; color: #1b1b1d; border-radius: 8px; padding: 12px 24px; font-size: 14px; font-weight: 600; text-decoration: none; border: 1px solid #e4e2e4; transition: background 0.1s; }
      .btn-ghost:hover { background: #f0edef; }
      .btn-full { width: 100%; }
      .cards-stack { display: flex; flex-direction: column; gap: 24px; }
      .card { background: #ffffff; border: 1px solid #e4e2e4; border-radius: 12px; padding: 24px; position: relative; overflow: hidden; }
      .card-accent { position: absolute; left: 0; top: 24px; bottom: 24px; width: 4px; background: var(--color-primary); border-radius: 0 2px 2px 0; }
      .card-title { font-size: 24px; font-weight: 700; line-height: 32px; color: #1b1b1d; margin-bottom: 24px; padding-left: 16px; letter-spacing: normal; }
      .card-body { padding-left: 16px; }
      .it-day { padding: 16px 0; }
      .it-day + .it-day { border-top: 1px solid #e4e2e4; }
